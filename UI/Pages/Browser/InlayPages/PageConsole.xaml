<Base:PageBrowser
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:OperPageLes.UI.Pages.Browser"
    xmlns:Base="clr-namespace:OPLAPI.OIEL.CORE.Browser;assembly=OPLAPI"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI"
    xmlns:OPL="clr-namespace:OperPageLes.UI.UserElementsControl.Default"
    x:Class="OperPageLes.UI.Pages.Browser.InlayPages.PageConsole"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Title="Консоль" Description="Средство гибкого управления системой">
    <Base:PageBrowser.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Base:PageBrowser.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderConsole" BorderBrush="#FF445D6D" BorderThickness="2,2,2,2" Grid.ColumnSpan="1" Margin="3,3,3,3" Panel.ZIndex="1" Background="#FF59A4BD" Grid.RowSpan="1" CornerRadius="5,5,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BorderCommandInformation" Panel.ZIndex="1" Background="#FF34D7F1" BorderBrush="{Binding BorderBrush, ElementName=BorderConsole}" BorderThickness="0,1,0,1" CornerRadius="3,3,3,3" Grid.ColumnSpan="2" Margin="0,0,200,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border x:Name="BorderElements" Grid.Row="1" Grid.ColumnSpan="1" BorderThickness="2,2,2,2" BorderBrush="Black" CornerRadius="5,5,5,5" Margin="3,3,1,3">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="0.7,1" StartPoint="0.3,0">
                                            <GradientStop Color="#663294E0" Offset="0.994"/>
                                            <GradientStop Color="#33182631" Offset="0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,2">
                                            <IEL:IELTextBox x:Name="IELInputSearchCommand" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" PaletteElement="{DynamicResource Cocoa}" Text="" Margin="3,5,0,5" Width="200"/>
                                            <IEL:IELButtonImage x:Name="IELButtonSearchCommand" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" PaletteElement="{DynamicResource Tangerine}" MarginViewBox="3,3,3,3" Width="35" Height="35" Margin="3,2,0,2"/>
                                            <IEL:IELButtonImage x:Name="IELButtonInfoParameter" Grid.Column="2" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" PaletteElement="{DynamicResource PastelBlue}" MarginViewBox="2,2,2,2" Margin="3,2,3,2"/>
                                        </StackPanel>
                                        <Line Stroke="{Binding BorderBrush, ElementName=BorderElements}" Grid.RowSpan="1" VerticalAlignment="Bottom" X2="1" StrokeThickness="2" Stretch="Uniform" StrokeEndLineCap="Square" StrokeStartLineCap="Square"/>
                                        <IEL:IELScrollViewer x:Name="ScrollViewerElements" Background="#269BA481" VerticalScrollAligment="Left" AutoUpdateVisibleHorizontalScroll="False" ScrollForce="20" Grid.RowSpan="1" Grid.Row="1"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Border x:Name="BorderControlElementInfo" Grid.RowSpan="1" Margin="3,3,3,3" BorderBrush="Black" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="0.7,1" StartPoint="0.3,0">
                                            <GradientStop Color="#66589BCE" Offset="0"/>
                                            <GradientStop Color="#33182631" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Grid.RowSpan="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.RowSpan="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,2">
                                            <IEL:IELButtonText x:Name="IELButtonBack" Text="Назад" CornerRadius="5,5,5,5" BorderThickness="2,2,2,2" FontFamily="{DynamicResource Bree CYR var}" FontSize="14" Margin="3,3,3,3" PaletteElement="{DynamicResource Green}"/>
                                            <IEL:IELButtonText x:Name="IELButtonCloneTextCommand" Grid.Column="1" Text="Копировать" CornerRadius="5,5,5,5" Margin="3,3,3,3"  FontSize="14" BorderThickness="2,2,2,2" FontFamily="{DynamicResource Bree CYR var}" PaletteElement="{DynamicResource LightBlue}"/>
                                        </StackPanel>
                                        <Line Stroke="{Binding BorderBrush, ElementName=BorderControlElementInfo}" X2="1" Stretch="Uniform" VerticalAlignment="Bottom" StrokeThickness="2" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                                        <IEL:IELPageController x:Name="IELControllerDescription" LeftAnimateSwitch="-15,0,15,0" RightAnimateSwitch="15,0,-15,0" Grid.RowSpan="1" Grid.Row="1"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <Border x:Name="BorderButtonPanelInformationController" Grid.Column="1" Background="{Binding BorderBrush, ElementName=BorderCommandInformation}" Width="14" HorizontalAlignment="Right" CornerRadius="0,2,2,0" Grid.ColumnSpan="2" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Line Stroke="Black" Y1="40" Margin="0,0,2,0" StrokeThickness="2"/>
                                <Line Stroke="Black" Y1="40" Margin="2,0,0,0" StrokeThickness="2"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <IEL:IELScrollViewer x:Name="IELScrollConsole" Grid.Row="0" Grid.Column="1" Margin="14,0,0,0">
                    <StackPanel VerticalAlignment="Top"/>
                </IEL:IELScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.Resources>
                <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <IEL:IELTextBox x:Name="TextBoxCommandInput" CornerRadius="2,6,6,6" Grid.Column="1" Grid.Row="0" Margin="3,3,3,3" MinWidth="100" BorderThickness="3,3,3,3" Grid.ColumnSpan="1" Panel.ZIndex="1" FontSize="20" FontFamily="{DynamicResource Deledda Open Regular}" Padding="0,5,0,0" PaletteElement="{DynamicResource Violet}" Text=""/>
            <IEL:IELButtonText x:Name="ButtonReturnCommand" Text="Выполнить" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" BorderThickness="3,3,3,3" FontFamily="{DynamicResource Bree CYR var}" VisualGuide="RightArrow" CornerRadiusGuides="7.6,7.6,7.6,7.6" PaletteElement="{DynamicResource Green}" VerticalContentAlignment="Stretch" Margin="3,3,3,3" MarginViewBox="5,5,5,7" Grid.Column="2" FontSize="16"/>
        </Grid>
        <OPL:OPLHitInterpreter x:Name="HitCommandsInterpreter" PaletteElement="{DynamicResource LightBlue}" Panel.ZIndex="2" Margin="8,0,0,-3" IsEnabledSettingQ="False"/>
    </Grid>
</Base:PageBrowser>
