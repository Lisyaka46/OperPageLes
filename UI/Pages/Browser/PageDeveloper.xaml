<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.Windows.Pages.Browser"
      xmlns:IEL="clr-namespace:IEL;assembly=IEL" xmlns:Classes="clr-namespace:IEL.Classes;assembly=IEL" x:Class="OperPage_les.Windows.Pages.Browser.PageDeveloper"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="200"
      Title="PageDeveloper">

    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="274"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36*"/>
                <RowDefinition Height="34*"/>
                <RowDefinition Height="122*"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="61*"/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Developer Page" VerticalAlignment="Center" Height="16" Width="84"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="77*"/>
                    <ColumnDefinition Width="23*"/>
                </Grid.ColumnDefinitions>
                <IEL:IELButtonText x:Name="IELButtonCreateLabel" Text="Создать ярлык" Grid.ColumnSpan="1"/>
                <TextBlock x:Name="TextBlockLabelsCount" Grid.Column="1" TextWrapping="Wrap" Text="=0" VerticalAlignment="Center" Padding="3,0,0,0"/>
            </Grid>
            <ListBox x:Name="ListBoxDeveloper" Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=5}" BorderThickness="0,0,0,0" BorderBrush="{x:Null}" Background="{x:Null}" Grid.RowSpan="1"/>
            <IEL:IELInlay x:Name="HeadInlay" HorizontalAlignment="Left" Grid.Row="4" VerticalAlignment="Top" Height="32" Width="93" IsEnabled="False" CornerRadius="5,5,0,0" BorderThicknessBlock="2,2,2,2">
                <IEL:IELInlay.ForegroundSetting>
                    <Classes:BrushSettingQ Default="#FF4679C2" Select="#FF2D715F" Used="#FF295B7A" NotEnabled="#FF677879"/>
                </IEL:IELInlay.ForegroundSetting>
                <IEL:IELInlay.BorderBrushSetting>
                    <Classes:BrushSettingQ Default="#FF4679C2" Select="#FF2D715F" Used="#FF295B7A" NotEnabled="#FF677879"/>
                </IEL:IELInlay.BorderBrushSetting>
                <IEL:IELInlay.BackgroundSetting>
                    <Classes:BrushSettingQ Default="#FF8DE1DF" Select="#FF82E0C7" Used="#FF82BCE0" NotEnabled="#FFC7DFE0"/>
                </IEL:IELInlay.BackgroundSetting>
            </IEL:IELInlay>
            <ComboBox x:Name="ComboBoxStateInlay" HorizontalAlignment="Left" Margin="100,6,0,0" Grid.Row="4" VerticalAlignment="Top" Width="90">
                <TextBlock Text="Обычный"/>
                <TextBlock Text="Неактивный"/>
                <TextBlock Text="Выделенный"/>
                <TextBlock Text="Нажатый"/>
            </ComboBox>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="131*"/>
                    <ColumnDefinition Width="69*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TextBoxColorCode" Grid.ColumnSpan="1" TextWrapping="Wrap" Text="A, R, G, B" VerticalAlignment="Center" Margin="5,0,5,0" Focusable="False" IsHitTestVisible="False" IsReadOnly="True" MaxLines="1"/>
                <Button x:Name="ButtonPixelColor" Content="COLPIX" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="5,0,5,0" Grid.Column="1"/>
                <Button x:Name="ButtonPixelColorCopy" Content="COPY" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="5,0,5,0" Grid.Column="1"/>
            </Grid>
        </Grid>
        <TextBlock x:Name="TextBlockIndicator" HorizontalAlignment="Left" Margin="10,10,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Grid.RowSpan="1" Panel.ZIndex="1" Width="4" Height="4" Background="#FFC3FF00"/>
        <ScrollViewer x:Name="ScrollViewerImage" Grid.Row="1" HorizontalScrollBarVisibility="Visible">
            <Image x:Name="ImageSource" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>
    </Grid>
</Page>
