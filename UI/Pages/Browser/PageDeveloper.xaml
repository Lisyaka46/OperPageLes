<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AAC20.Windows.Pages.Browser"
      xmlns:IEL="clr-namespace:IEL;assembly=IEL" x:Class="AAC20.Windows.Pages.Browser.PageDeveloper"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="200"
      Title="PageDeveloper">

    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="274"/>
            <RowDefinition Height="126"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="18*"/>
                <RowDefinition Height="17*"/>
                <RowDefinition Height="102*"/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Developer Page" VerticalAlignment="Center" Height="16" Width="84"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="77*"/>
                    <ColumnDefinition Width="23*"/>
                </Grid.ColumnDefinitions>
                <IEL:IELButtonText x:Name="IELButtonCreateLabel" Text="Создать ярлык" Grid.ColumnSpan="1"/>
                <TextBlock x:Name="TextBlockLabelsCount" Grid.Column="1" TextWrapping="Wrap" Text="=0" VerticalAlignment="Center" Padding="3,0,0,0"/>
            </Grid>
            <ListBox x:Name="ListBoxDeveloper" Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=5}" BorderThickness="0,0,0,0" BorderBrush="{x:Null}" Background="{x:Null}"/>
        </Grid>
    </Grid>
</Page>
