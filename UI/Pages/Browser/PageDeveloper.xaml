<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.UI.Pages.Browser"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      xmlns:IEL="clr-namespace:IEL.GUI;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" x:Class="OperPage_les.UI.Pages.Browser.PageDeveloper"
      mc:Ignorable="d" 
      d:DesignHeight="400"
      Title="PageDeveloper">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="113*"/>
            <RowDefinition Height="68*"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Text="Developer Page" Background="White" FontSize="20"  TextAlignment="Center" Padding="0,5,0,5" Grid.RowSpan="1"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <IEL:IELButtonText x:Name="IELButtonGenerateImage" CornerRadius="5,5,5,5" Text="Сгенерировать" Grid.ColumnSpan="1" PaddingContent="2,5,2,5" FontSize="14" Margin="5,2,5,2">
                    <IEL:IELButtonText.IELSettingObject>
                        <ObjectSettings:IELButtonObjectSetting>
                            <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FFDADADA" NotEnabled="#FFE84D4D" Select="#FF4AA0AB" Used="#FF5AC7A6"/>
                            </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        </ObjectSettings:IELButtonObjectSetting>
                    </IEL:IELButtonText.IELSettingObject>
                </IEL:IELButtonText>
                <IEL:IELButtonText x:Name="IELButtonDownloadImage" Grid.Column="1" CornerRadius="5,5,5,5" Text="Скачать" PaddingContent="5,2,5,2" Margin="5,2,5,2" HorizontalAlignment="Left" FontSize="14">
                    <IEL:IELButtonText.IELSettingObject>
                        <ObjectSettings:IELButtonObjectSetting>
                            <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FFDADADA" NotEnabled="#FFE84D4D" Select="#FF4AA0AB" Used="#FF5AC7A6"/>
                            </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        </ObjectSettings:IELButtonObjectSetting>
                    </IEL:IELButtonText.IELSettingObject>
                </IEL:IELButtonText>

            </Grid>
            <ScrollViewer x:Name="Map" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                <Grid x:Name="GridScale">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="GridMap">
                        <Grid.LayoutTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ScaleTransformBox" ScaleX="1" ScaleY="1"/>
                            </TransformGroup>
                        </Grid.LayoutTransform>

                    </Grid>
                    <Image x:Name="ImageMap" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="100" Margin="58,141,0,0" VerticalAlignment="Top" Width="100"/>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2">
            <ScrollViewer>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="1" BorderBrush="Black" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Margin="5,2,5,2" Grid.Row="1" Padding="0,3,0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderY" VerticalAlignment="Center" Maximum="2000" Minimum="1" Grid.ColumnSpan="1" Margin="3,0,0,0" Grid.Column="1"/>
                            <TextBlock x:Name="TextBlockY_Value" Grid.Column="2" TextWrapping="Wrap" Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="50" Padding="6,0,5,0"/>
                            <TextBlock x:Name="TextBlockY" Grid.Column="0" TextWrapping="Wrap" Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="50" Padding="5,0,5,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.RowSpan="1" BorderBrush="Black" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Margin="5,2,5,2" Padding="0,3,0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderX" VerticalAlignment="Center" Maximum="2000" Minimum="1" Grid.ColumnSpan="1" Margin="3,0,0,0" Grid.Column="1"/>
                            <TextBlock x:Name="TextBlockX_Value" Grid.Column="2" TextWrapping="Wrap" Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="50" Padding="6,0,5,0"/>
                            <TextBlock x:Name="TextBlockX" Grid.Column="0" TextWrapping="Wrap" Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="50" Padding="5,0,5,0"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TextblockInformation" Grid.Row="2" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Center" Padding="2,0,2,0" FontSize="16"/>
                </Grid>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
