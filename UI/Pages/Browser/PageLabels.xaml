<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.Windows.Pages.Browser" xmlns:IEL="clr-namespace:IEL;assembly=IEL" x:Name="MainPageLabel"
      x:Class="OperPage_les.Windows.Pages.Browser.PageLabels"
      mc:Ignorable="d"
      Title="PageLabels" d:DesignHeight="144.46" d:DesignWidth="148.456">

    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderNamingLabel" Background="#FF37E2B7" Cursor="Hand">
            <Grid x:Name="GridButtonSearch">
                <Border x:Name="BorderScrollBackground" HorizontalAlignment="Left" Width="10" Margin="0,2,0,2" Cursor="Hand" Panel.ZIndex="1">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                            <GradientStop Color="#FF37E2D6"/>
                            <GradientStop Color="#FF25A7D2" Offset="0.729"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="TextBlockCount" Text="ярлыков: 0" HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="1" Margin="0,0,5,0" Style="{Binding Mode=OneWay, Source={StaticResource Aventura}}" Padding="0,2,0,2"/>
            </Grid>
        </Border>
        <Border x:Name="BorderDinamicLabels" Grid.Row="1" BorderBrush="Black">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid x:Name="GridMainLabels" Margin="2,2,2,2" VerticalAlignment="Top" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
