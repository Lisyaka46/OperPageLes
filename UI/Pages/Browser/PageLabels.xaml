<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.Browser" 
      xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" x:Name="MainPageLabel"
      x:Class="ApplicationOperPageLes.UI.Pages.Browser.PageLabels"
      mc:Ignorable="d"
      Title="PageLabels" d:DesignHeight="208.793" d:DesignWidth="313.123">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderNamingLabel" Background="#FF37E2B7" Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="Black">
            <Border.OpacityMask>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="1"/>
                    <GradientStop Color="#00000000"/>
                    <GradientStop Color="#7F000000" Offset="0"/>
                    <GradientStop Color="Black" Offset="0.262"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Grid x:Name="GridButtonSearch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextBlockEventInfo" Text="Тег установлен" VerticalAlignment="Center" Panel.ZIndex="1" FontFamily="{DynamicResource Deledda Open Regular}" Padding="0,1,0,1" FontSize="14" Focusable="True" Margin="2,0,2,0" TextAlignment="Right" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis">
                    <TextBlock.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template" Value="{x:Null}"/>
                        </Style>
                    </TextBlock.FocusVisualStyle>
                </TextBlock>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BorderScrollBackground" HorizontalAlignment="Left" Width="10" Cursor="Hand" Panel.ZIndex="1" Grid.ColumnSpan="2">
                        <Border.OpacityMask>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#00000000"/>
                                <GradientStop Color="Black" Offset="0.85"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                                <GradientStop Color="Black" Offset="0.15"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Border.Background>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <GradientStop Color="#FF37E2D6"/>
                                <GradientStop Color="#FF25A7D2" Offset="0.729"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="TextBlockLabelInfo" Text="ярлыков: 0" VerticalAlignment="Center" Panel.ZIndex="1" FontFamily="{DynamicResource Deledda Open Regular}" Padding="0,1,0,1" FontSize="18" Focusable="True" Grid.Column="1" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="2,0,2,0">
                        <TextBlock.FocusVisualStyle>
                            <Style>
                                <Setter Property="Control.Template" Value="{x:Null}"/>
                            </Style>
                        </TextBlock.FocusVisualStyle>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1" Grid.RowSpan="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <IEL:IELButtonImage x:Name="IELButtonSearch" Grid.Column="2" CornerRadius="5,5,5,5" MinWidth="30" BorderThickness="2,2,2,2" Grid.RowSpan="1" Grid.ColumnSpan="1" Margin="5,5,5,5" Width="40" Height="40" PaletteElement="{DynamicResource Lime}"/>
                        <IEL:IELTextBox x:Name="IELTextBoxSearch" FontSize="18" CornerRadius="5,5,5,5" BorderThickness="2,2,2,2" Text="" FontFamily="{DynamicResource RussianRail G Pro}" Grid.ColumnSpan="1" Grid.RowSpan="1" Margin="5,10,5,10" Grid.Column="1" PaletteElement="{DynamicResource Tangerine}"/>
                        <IEL:IELButtonImage x:Name="IELButtonSorting" Grid.Column="0" CornerRadius="5,5,5,5" MinWidth="30" BorderThickness="2,2,2,2" Grid.RowSpan="1" Grid.ColumnSpan="1" Margin="5,5,5,5" Width="40" Height="40" PaletteElement="{DynamicResource Lime}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="BorderDinamicLabels" BorderBrush="Black" Grid.RowSpan="1" Grid.Row="1">
            <ScrollViewer x:Name="ScrollLabels" VerticalScrollBarVisibility="Hidden">
                <Grid x:Name="GridMainLabels" Margin="2,2,2,2" VerticalAlignment="Top" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
