<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.Windows.Pages.Browser" xmlns:IEL="clr-namespace:IEL;assembly=IEL" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" x:Name="MainPageLabel"
      x:Class="OperPage_les.Windows.Pages.Browser.PageLabels"
      mc:Ignorable="d"
      Title="PageLabels" d:DesignHeight="144.46" d:DesignWidth="313.123">

    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="37*"/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderNamingLabel" Cursor="Hand" Padding="0,3,0,3" Background="#FF37E2B7" Grid.Row="0" Grid.RowSpan="1">
            <Border.OpacityMask>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="0.7"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                    <GradientStop Color="#7F000000" Offset="0"/>
                    <GradientStop Color="Black" Offset="0.128"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Grid x:Name="GridButtonSearch">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Border x:Name="BorderScrollBackground" HorizontalAlignment="Left" Width="10" Cursor="Hand" Panel.ZIndex="1">
                        <Border.OpacityMask>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#00000000"/>
                                <GradientStop Color="Black" Offset="0.85"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                                <GradientStop Color="Black" Offset="0.15"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Border.Background>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                <GradientStop Color="#FF37E2D6"/>
                                <GradientStop Color="#FF25A7D2" Offset="0.729"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="TextBlockCount" Text="ярлыков: 0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1" FontFamily="{DynamicResource RussianRail G Pro}" Padding="0,1,0,1" FontSize="18" Margin="0,0,5,0"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <IEL:IELTextBox x:Name="IELTextBox" VerticalAlignment="Center" Margin="5,0,0,0" FontSizeText="20" CornerRadius="5,5,5,5" BorderThicknessBlock="2,2,2,2" Text="text" FontFamily="{DynamicResource Plup}" FontSize="14">
                        <IEL:IELTextBox.IELSettingObject>
                            <ObjectSettings:IELObjectSetting>
                                <ObjectSettings:IELObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#FF7FC386" NotEnabled="#FFFB4D4D" Select="#FF6FF97D" Used="#FF8DDED5" UsedState="False"/>
                                </ObjectSettings:IELObjectSetting.BackgroundSetting>
                                <ObjectSettings:IELObjectSetting.ForegroundSetting>
                                    <Classes:BrushSettingQ/>
                                </ObjectSettings:IELObjectSetting.ForegroundSetting>
                                <ObjectSettings:IELObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ/>
                                </ObjectSettings:IELObjectSetting.BorderBrushSetting>
                            </ObjectSettings:IELObjectSetting>
                        </IEL:IELTextBox.IELSettingObject>
                    </IEL:IELTextBox>
                    <IEL:IELButtonImage x:Name="IELButtonSearch" Grid.Column="1" CornerRadius="5,5,5,5" MinWidth="30" Margin="5,5,5,5" BorderThicknessBlock="2,2,2,2">
                        <IEL:IELButtonImage.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#FF63AF87" NotEnabled="#FFED5A5A" Select="#FFB2D675" Used="#FF84C7DE" UsedState="False"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                    <Classes:BrushSettingQ/>
                                </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ/>
                                </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </IEL:IELButtonImage.IELSettingObject>
                    </IEL:IELButtonImage>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="BorderDinamicLabels" BorderBrush="Black" Grid.RowSpan="1" Grid.Row="1">
            <ScrollViewer x:Name="ScrollLabels" VerticalScrollBarVisibility="Hidden">
                <Grid x:Name="GridMainLabels" Margin="2,2,2,2" VerticalAlignment="Top" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
