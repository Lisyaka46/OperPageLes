<Base:PageBrowser
    x:Class="ApplicationOperPageLes.UI.Pages.Browser.BrowserPageNetwork.PageNetwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Base="clr-namespace:OIEL.CORE.Browser;assembly=OIEL"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
    xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.Browser.BrowserPageNetwork"
    mc:Ignorable="d" d:DesignHeight="580.454" d:DesignWidth="707.727">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" BorderBrush="#FF132F1E" Background="#FF9BDAB6" Margin="0,3,0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <IEL:IELButtonImage x:Name="IELButtonChats" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource PastelBlue}" FontFamily="{DynamicResource Bree CYR var}" Margin="5,5,5,5" FontSize="14" MarginViewBox="10,6,10,6" CornerRadiusGuides="7.6,7.6,7.6,7.6" Grid.ColumnSpan="1"/>
                    <IEL:IELButtonText x:Name="IELButtonProfile" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Saffron}" FontFamily="{DynamicResource Bree CYR var}" Text="Ваш профиль" Margin="5,5,5,5" FontSize="14" MarginViewBox="5,6,5,6" IsEnabled="False" Grid.ColumnSpan="1" Grid.Column="1"/>
                    <IEL:IELButtonImage x:Name="IELButtonFolderDownloads" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Green}" FontFamily="{DynamicResource Bree CYR var}" Margin="5,5,5,5" FontSize="14" MarginViewBox="10,6,10,6" CornerRadiusGuides="7.6,7.6,7.6,7.6" Grid.ColumnSpan="1" Grid.Column="3"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <IEL:IELPageController x:Name="PageControllerNetwork" LeftAnimateSwitch="-20,5,20,5" RightAnimateSwitch="20,5,-20,5">

                </IEL:IELPageController>
            </Grid>
        </Grid>
    </Grid>
</Base:PageBrowser>
