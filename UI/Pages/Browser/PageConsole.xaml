<Base:PageBrowser
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:OperPageLes.UI.Pages.Browser"
    xmlns:Base="clr-namespace:OIEL.CORE.Browser;assembly=OIEL"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
    xmlns:OPL="clr-namespace:OperPageLes.UI.UserElementsControl.Default"
    x:Class="OperPageLes.UI.Pages.Browser.PageConsole"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Title="PageConsole">
    <Base:PageBrowser.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Base:PageBrowser.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid x:Name="GridMainComponents" Grid.RowSpan="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="BorderConsole" BorderBrush="#FF315842" BorderThickness="3,3,3,3" Grid.ColumnSpan="1" Margin="3,3,3,3" Panel.ZIndex="1" Background="#FF59A4BD" Grid.RowSpan="1" CornerRadius="6,6,6,6">
                <IEL:IELScrollViewer x:Name="IELScrollConsole">
                    <StackPanel VerticalAlignment="Top"/>
                </IEL:IELScrollViewer>
            </Border>
            <TextBlock x:Name="TextBlockInformation" Grid.Row="1" Text="Text" Foreground="#FF97D5EA" Padding="0,0,0,8" FontSize="14" FontFamily="{DynamicResource Bree CYR var}" Margin="3,-5,3,0" TextAlignment="Right"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.Resources>
                <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <IEL:IELTextBox x:Name="TextBoxCommandInput" CornerRadius="2,6,6,6" Grid.Column="0" Grid.Row="1" Margin="3,3,3,3" MinWidth="100" BorderThickness="3,3,3,3" Grid.ColumnSpan="1" Panel.ZIndex="1" FontSize="20" FontFamily="{DynamicResource Deledda Open Regular}" Padding="0,5,0,0" PaletteElement="{DynamicResource Violet}" Text=""/>
            <Grid Grid.Column="2" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28*"/>
                    <ColumnDefinition Width="155*"/>
                </Grid.ColumnDefinitions>
                <IEL:IELButtonImage x:Name="IELImageButtonHelp" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Grid.Column="0" Margin="3,5,3,5" Grid.ColumnSpan="1" PaletteElement="{DynamicResource Jade}" Padding="0,2,0,2" MarginViewBox="5,2,5,2"/>
                <IEL:IELButtonText x:Name="ButtonReturnCommand" Text="Выполнить" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" BorderThickness="3,3,3,3" FontFamily="{DynamicResource Bree CYR var}" VisualGuide="RightArrow" CornerRadiusGuides="7.6,7.6,7.6,7.6" PaletteElement="{DynamicResource Green}" VerticalContentAlignment="Stretch" Margin="3,3,3,3" MarginViewBox="5,5,5,7" Grid.Column="1" FontSize="16"/>
            </Grid>
        </Grid>
        <OPL:OPLHitInterpreter x:Name="HitCommandsInterpreter" PaletteElement="{DynamicResource LightBlue}"/>
    </Grid>
</Base:PageBrowser>
