<Page x:Class="OperPage_les.UI.Pages.Browser.PageConsole"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.UI.Pages.Browser"
      xmlns:GUI="clr-namespace:IEL;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.Classes;assembly=IEL"
      xmlns:gif="http://wpfanimatedgif.codeplex.com"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageConsole">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid x:Name="GridMainComponents" Grid.RowSpan="1">
            <Border x:Name="BorderConsole" BorderBrush="#FF315842" BorderThickness="3,3,3,3" Grid.ColumnSpan="1" Margin="3,3,3,3" Panel.ZIndex="1">
                <Grid x:Name="GridConsole">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <RichTextBox x:Name="RichTextBoxMainMessage" Background="#CC4A7B60" SelectionBrush="#FF115236" BorderThickness="0,0,0,0" FontSize="14" MinWidth="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsReadOnly="True" FontWeight="Normal" Focusable="False" Cursor="Cross" VerticalScrollBarVisibility="Auto" Panel.ZIndex="1" BorderBrush="{x:Null}"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="627*"/>
                <ColumnDefinition Width="173*"/>
            </Grid.ColumnDefinitions>
            <GUI:IELTextBox x:Name="TextBoxCommandInput" CornerRadius="4,4,4,4" Grid.Column="0" Grid.Row="1" Margin="3,3,3,3" MinWidth="100" BorderThicknessBlock="3,3,3,3" Grid.ColumnSpan="1" ForgroundNaming="#FF11FF81" Panel.ZIndex="1" Text=""/>
            <Grid Grid.Column="2" Grid.Row="2">
                <GUI:IELButtonText x:Name="ButtonReturnCommand" Text="Выполнить" Margin="2,4,2,5" CornerRadius="10,10,10,10" Grid.ColumnSpan="1" VisibleMouseImaging="False" AnimationMillisecond="160" BorderThicknessBlock="3,3,3,3" Style="{Binding Mode=OneWay, Source={StaticResource RussianRail G Pro}}">
                    <GUI:IELButtonText.BackgroundSetting>
                        <Classes:BrushSettingQ Default="#FF55C7A5" NotEnabled="#FFCE4867" Select="#FF47F9C4" Used="White"/>
                    </GUI:IELButtonText.BackgroundSetting>
                </GUI:IELButtonText>
            </Grid>
        </Grid>
        <Border x:Name="BorderHintCommand" BorderThickness="2,2,2,2" Margin="3,0,0,47" CornerRadius="4,4,0,4" Height="70" VerticalAlignment="Bottom" Width="142" HorizontalAlignment="Left" Padding="0,5,0,0" Panel.ZIndex="0" Grid.RowSpan="2">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#008FA260" Offset="0.06"/>
                    <GradientStop Color="#FF8FA065" Offset="0.15"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#008FA260" Offset="0.03"/>
                    <GradientStop Color="#FF8FA065" Offset="0.15"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid x:Name="GridHint"/>
                <Grid x:Name="GridHintCommandParameter" Panel.ZIndex="1" Margin="2,2,2,2">
                    <TextBlock x:Name="TextBlockHintCommand" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Close" VerticalAlignment="Top" Margin="2,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
