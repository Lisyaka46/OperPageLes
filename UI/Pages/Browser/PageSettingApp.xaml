<Base:PageBrowser
    x:Class="OperPageLes.UI.Pages.Browser.PageSettingApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Base="clr-namespace:OPLAPI.OIEL.CORE.Browser;assembly=OPLAPI"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:local="clr-namespace:OperPageLes.UI.Pages.Browser">
    <Base:PageBrowser.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Base:PageBrowser.Resources>
    <Border CornerRadius="5,5,5,5">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF657275" Offset="0"/>
                <GradientStop Color="#FF375A4F" Offset="1"/>
                <GradientStop Color="#FF687077" Offset="0.317"/>
                <GradientStop Color="#FF60695A" Offset="0.694"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="SettingButtons" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel.OpacityMask>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#00000000" Offset="0.01"/>
                        <GradientStop Color="Black" Offset="0.25"/>
                    </LinearGradientBrush>
                </StackPanel.OpacityMask>
                <IEL:IELButtonText x:Name="IELGeneralButton" Margin="5,0,5,10" CornerRadius="0,0,8,8" Text="Общие" BorderThickness="3,0,3,3"  FontSize="16" Padding="10,0,10,0" FontFamily="{DynamicResource Vollda}"/>
                <IEL:IELButtonText x:Name="IELConsoleButton" Margin="5,0,5,10" CornerRadius="0,0,8,8" Text="Консоль" BorderThickness="3,0,3,3"  FontSize="16" Padding="10,0,10,0" Grid.Column="1" FontFamily="{DynamicResource Vollda}"/>
                <IEL:IELButtonText x:Name="IELPanelActionButton" Margin="5,0,5,10" CornerRadius="0,0,8,8" Text="Панель действий" BorderThickness="3,0,3,3"  FontSize="16" Padding="10,0,10,0" Grid.Column="2" FontFamily="{DynamicResource Vollda}" Grid.ColumnSpan="1"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Border x:Name="BorderElement" ScrollViewer.VerticalScrollBarVisibility="Disabled" BorderThickness="0,3,0,0" BorderBrush="Black">
                    <ScrollViewer x:Name="ScrollViewerPageSettings" VerticalScrollBarVisibility="Auto" PanningRatio="0.3">
                        <Grid ClipToBounds="True" Margin="0,-5,0,-5">
                            <IEL:IELContentController x:Name="MainPageController" RightAnimateSwitch="10,-5,0,-5" LeftAnimateSwitch="-10,-5,0,-5" Grid.ColumnSpan="1" Panel.ZIndex="-1" Padding="0,5,0,5"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Base:PageBrowser>
