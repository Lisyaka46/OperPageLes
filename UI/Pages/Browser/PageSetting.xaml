<Base:PageBrowser
    x:Class="OperPageLes.UI.Pages.Browser.PageSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Base="clr-namespace:OPLAPI.OIEL.CORE.Browser;assembly=OPLAPI"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI" Title="Настройки"
    >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <IEL:IELScrollViewer x:Name="IELScrollCategoryButtons">
            <StackPanel ClipToBounds="True">
                <IEL:IELButtonText HorizontalAlignment="Left" VerticalAlignment="Center" PaletteElement="{DynamicResource Aquamarine}" Margin="0,2,0,2" CornerRadius="0,10,10,0" MarginViewBox="2,2,2,2" Text="Общие" Height="35" Padding="0,0,0,2" FontFamily="{DynamicResource Bree CYR var}"/>
                <IEL:IELButtonText HorizontalAlignment="Left" VerticalAlignment="Center" PaletteElement="{DynamicResource Aquamarine}" Margin="0,2,10,2" CornerRadius="0,10,10,0" MarginViewBox="2,2,2,2" Text="Общие" Height="35" Padding="0,0,0,2" FontFamily="{DynamicResource RussianRail G Pro}"/>
            </StackPanel>
        </IEL:IELScrollViewer>
        <Grid x:Name="ControllerCategories" Grid.Column="1">
        </Grid>
    </Grid>
</Base:PageBrowser>
