<Page x:Class="ApplicationOperPageLes.UI.Pages.Browser.PageManagerBrowser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.Browser"
      xmlns:GUI="clr-namespace:IEL.UserElementsControl;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      Title="PageManagerBrowser">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.OpacityMask>
            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                <GradientStop Color="#00000000" Offset="0.01"/>
                <GradientStop Color="#00000000" Offset="0.99"/>
                <GradientStop Color="Black" Offset="0.05"/>
                <GradientStop Color="Black" Offset="0.95"/>
            </LinearGradientBrush>
        </Grid.OpacityMask>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.8">
                <LinearGradientBrush.RelativeTransform>
                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                        <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FFC5C5C5" Offset="0.014"/>
                <GradientStop Color="#FFE660AF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid x:Name="GridMainPages" Grid.RowSpan="1">
            <Border BorderThickness="0,0,0,4" BorderBrush="#7F583F1A">
                <Grid x:Name="GridScrollPages">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <GUI:IELButtonText x:Name="IELButtonAddPageLabel" BorderThickness="3,3,3,3" Text="Страница ярлыков" CornerRadius="6,6,6,6" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="14" Grid.RowSpan="1" Padding="0,10,0,10" PaletteElement="{DynamicResource Lime}" HeightViewBox="20"/>
                    <GUI:IELButtonText x:Name="IELButtonPageDeveloper" BorderThickness="3,3,3,3" Text="Страница разработчика" CornerRadius="6,6,6,6" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="14" Grid.Row="1" Padding="0,10,0,10" PaletteElement="{DynamicResource PastelBlue}" HeightViewBox="20"/>
                    <GUI:IELButtonText x:Name="IELButtonPageConsole" BorderThickness="3,3,3,3" Text="Страница консоли" CornerRadius="6,6,6,6" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="14" Grid.Row="2" Padding="0,10,0,10" PaletteElement="{DynamicResource Jade}" HeightViewBox="20"/>
                    <GUI:IELButtonText x:Name="IELButtonPageNetwork" BorderThickness="3,3,3,3" Text="Страница сети" CornerRadius="6,6,6,6" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="14" Grid.Row="3" Padding="0,10,0,10" PaletteElement="{DynamicResource Green}" HeightViewBox="20"/>
                    <GUI:IELButtonText x:Name="IELButtonPageBrowser" BorderThickness="3,3,3,3" Text="Страница веб-браузера" CornerRadius="6,6,6,6" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="14" Grid.Row="4" Padding="0,10,0,10" PaletteElement="{DynamicResource Violet}" HeightViewBox="20"/>
                    <TextBlock x:Name="TextBlockDeveloping" Text="на разработке" Grid.Row="4" Foreground="White" FontFamily="{DynamicResource RussianRail G Pro}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,0"/>
                </Grid>
            </Border>
        </Grid>
        <GUI:IELButtonText x:Name="IELButtonCancel" BorderThickness="3,3,3,3" Text="Отмена добавления" CornerRadius="6,6,6,6" Grid.Row="1" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" Padding="0,10,0,10" PaletteElement="{DynamicResource Red}" FontSize="14" HeightViewBox="20"/>
    </Grid>
</Page>
