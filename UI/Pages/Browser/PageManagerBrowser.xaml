<Page x:Class="ApplicationOperPageLes.UI.Pages.Browser.PageManagerBrowser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.Browser"
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      Title="PageManagerBrowser">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.OpacityMask>
            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                <GradientStop Color="#00000000" Offset="0.01"/>
                <GradientStop Color="#00000000" Offset="0.99"/>
                <GradientStop Color="Black" Offset="0.05"/>
                <GradientStop Color="Black" Offset="0.95"/>
            </LinearGradientBrush>
        </Grid.OpacityMask>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.8">
                <LinearGradientBrush.RelativeTransform>
                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                        <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FFC5C5C5" Offset="0.014"/>
                <GradientStop Color="#FFE660AF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid x:Name="GridMainPages" Grid.RowSpan="1">
            <Border BorderThickness="0,0,0,4" BorderBrush="#7F583F1A">
                <Grid x:Name="GridScrollPages">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <GUI:IELButtonText x:Name="IELButtonAddPageLabel" BorderThicknessBlock="3,3,3,3" Text="Страница ярлыков" CornerRadius="6,6,6,6" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16" Grid.RowSpan="1" PaddingContent="0,10,0,10" QBackground="{StaticResource BG_Lime}" QBorderBrush="{StaticResource BB_Lime}" QForeground="{StaticResource FG_Lime}"/>
                    <GUI:IELButtonText x:Name="IELButtonPageDeveloper" BorderThicknessBlock="3,3,3,3" Text="Страница разработчика" CornerRadius="6,6,6,6" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16" Grid.Row="1" PaddingContent="0,10,0,10" QBackground="{StaticResource BG_PastelBlue}" QBorderBrush="{StaticResource BB_PastelBlue}" QForeground="{StaticResource FG_PastelBlue}"/>
                    <GUI:IELButtonText x:Name="IELButtonPageConsole" BorderThicknessBlock="3,3,3,3" Text="Страница консоли" CornerRadius="6,6,6,6" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16" Grid.Row="2" PaddingContent="0,10,0,10" QBackground="{StaticResource BG_Olive}" QBorderBrush="{StaticResource BB_Olive}" QForeground="{StaticResource FG_Olive}"/>
                    <GUI:IELButtonText x:Name="IELButtonPageBrowser" BorderThicknessBlock="3,3,3,3" Text="Страница веб-браузера" CornerRadius="6,6,6,6" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16" Grid.Row="3" PaddingContent="0,10,0,10" QBackground="{StaticResource BG_Violet}" QBorderBrush="{StaticResource BB_Violet}" QForeground="{StaticResource FG_Violet}"/>
                </Grid>
            </Border>
        </Grid>
        <GUI:IELButtonText x:Name="IELButtonCancel" BorderThicknessBlock="3,3,3,3" Text="Отмена добавления" CornerRadius="6,6,6,6"  Grid.Row="1" Margin="10,3,10,3" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16" PaddingContent="0,10,0,10" QBackground="{StaticResource BG_Red}" QBorderBrush="{StaticResource BB_Red}" QForeground="{StaticResource FG_Red}"/>
    </Grid>
</Page>
