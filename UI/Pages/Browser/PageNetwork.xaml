<Base:PageBrowser
    x:Class="ApplicationOperPageLes.UI.Pages.Browser.PageNetwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Base="clr-namespace:OIEL.CORE.Browser;assembly=OIEL"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=IEL"
    xmlns:OIEL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
    xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.Browser"
    mc:Ignorable="d" d:DesignHeight="580.454" d:DesignWidth="707.727">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" BorderBrush="#FF132F1E" Background="#FF9BDAB6" Margin="0,3,0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="5,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="10" Height="10" Margin="2,5,2,0" RadiusX="5" RadiusY="5" Grid.Column="0">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:FieldModifier="private" x:Name="SolidColorBrushCheckConnect" Color="Black"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Width="10" Height="10" Margin="2,5,2,0" RadiusX="5" RadiusY="5" Grid.Column="1">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:FieldModifier="private" x:Name="SolidColorBrushCheckData" Color="Black"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Width="10" Height="10" Margin="2,5,2,0" RadiusX="5" RadiusY="5" Grid.Column="2">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:FieldModifier="private" x:Name="SolidColorBrushCheckDataConnectSocket" Color="Black"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Width="10" Height="10" Margin="2,5,2,0" RadiusX="5" RadiusY="5" Grid.Column="3" StrokeThickness="7">
                                <Rectangle.Fill>
                                    <SolidColorBrush x:FieldModifier="private" x:Name="SolidColorBrushCheckDataReceive" Color="Black"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <Image x:Name="IndicatorServer" Width="30" Height="30" Source="/UI/Images/ServerOff.png" Cursor="Help" Grid.RowSpan="1" Grid.Row="1"/>
                    </Grid>
                    <IEL:IELButtonText x:Name="IELButtonManagerConnection" Grid.Column="1" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource PastelBlue}" FontFamily="{DynamicResource Bree CYR var}" Text="Менеджер подключений" Margin="5,5,5,5" FontSize="14" MarginViewBox="5,6,5,6" CornerRadiusGuides="7.6,7.6,7.6,7.6" VisualGuide="RightArrow"/>
                    <IEL:IELButtonText x:Name="IELButtonProfile" Grid.Column="2" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Saffron}" FontFamily="{DynamicResource Bree CYR var}" Text="Ваш профиль" Margin="5,5,5,5" FontSize="14" MarginViewBox="5,6,5,6"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BorderManagerConnection" BorderBrush="#FF012F25" Panel.ZIndex="1" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" HorizontalAlignment="Left" Width="180">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="1,1.5" StartPoint="0.4,-0.2">
                                <GradientStop Color="#FF6ACCCA" Offset="0.014"/>
                                <GradientStop Color="#FF5E8F98" Offset="0.983"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Margin="2,2,2,2" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" BorderBrush="Black">
                                <IEL:IELScrollViewer x:Name="IELScrollViewerElementConnections">

                                </IEL:IELScrollViewer>
                            </Border>
                            <StackPanel Grid.Row="1">
                                <IEL:IELButtonText x:Name="IELButtonManipulateLocalServer" PaletteElement="{DynamicResource Fuzi_woozy}" CornerRadius="5,5,5,5" Text="Открыть сервер локальной сети" FontFamily="{DynamicResource Bree CYR var}" Grid.ColumnSpan="1" Margin="5,5,5,5"/>
                                <IEL:IELButtonText x:Name="IELButtonOpenNewConnection" Grid.Column="2" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Tangerine}" FontFamily="{DynamicResource Bree CYR var}" Text="Создать подключение" Margin="5,5,5,5" FontSize="14" MarginViewBox="5,6,5,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Margin="6,4,6,2" BorderBrush="#FF47657D" CornerRadius="5,5,5,5" BorderThickness="2,2,2,2" Grid.RowSpan="1">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#7F6C94CA"/>
                                    <GradientStop Color="#665C7588" Offset="0.997"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock x:Name="TextBlockNoConnection" Text="Подключение отсутствует" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Opacity="0.4"/>
                                <Grid>
                                    <IEL:IELScrollViewer x:Name="IELScrollHistoryMessage" AutoUpdateVisibleHorizontalScroll="False" ScrollForce="30">
                                    </IEL:IELScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="MessageInfo" Grid.Row="1" FontSize="16" Margin="8,0,8,2" Text="Инициализация успешна" TextAlignment="Right" FontFamily="{DynamicResource Bree CYR var}"/>
                    </Grid>
                </Grid>
                <Border x:Name="border" Grid.Row="1" BorderBrush="#FF0A272D" CornerRadius="2,2,7,7" BorderThickness="2,2,2,2" Margin="3,0,3,3" VerticalAlignment="Bottom" Height="56">
                    <Border.Background>
                        <SolidColorBrush Color="#FF2FA9C1" Opacity="0.7"/>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="20*"/>
                        </Grid.RowDefinitions>
                        <Grid ClipToBounds="True">
                            <Line x:Name="LineTextConnection" StrokeDashArray="2" StrokeDashCap="Triangle" X2="0" StrokeEndLineCap="Square" StrokeThickness="10" Stretch="Fill" VerticalAlignment="Top" Grid.Column="1" Margin="-10,-5,-10,0" X1="1" Stroke="{Binding BorderBrush, ElementName=border}" HorizontalAlignment="Left" Height="10"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <IEL:IELButtonImage x:Name="IELButtonClip" Grid.Column="0" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Saffron}" Margin="5,5,0,5" Source="/UI/Images/PaperClip.png" Height="33" MarginViewBox="2,2,2,2"/>
                            <IEL:IELTextBox x:Name="IELTextBoxMessage" PaletteElement="{DynamicResource PastelBlue}" TextBoxHorizontalAlignment="Left" TextBoxVerticalAlignment="Center" CornerRadius="8,8,8,8" Margin="5,4,2,4" Padding="2,2,2,2" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" MinHeight="30" Grid.ColumnSpan="1" Grid.Column="1" Text=""/>
                            <IEL:IELButtonText x:Name="IELButtonGoSend" Grid.Column="2" CornerRadius="6,6,6,6" PaletteElement="{DynamicResource Green}" Text="Отправить" Margin="2,5,5,5" FontFamily="{DynamicResource Bree CYR var}" FontSize="16"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Base:PageBrowser>
