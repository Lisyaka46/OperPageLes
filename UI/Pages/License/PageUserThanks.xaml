<Page x:Class="OperPage_les.Windows.Pages.License.PageUserThanks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.Windows.Pages.License"
      mc:Ignorable="d" 
      d:DesignHeight="213" d:DesignWidth="258.333"
      Title="PageUser">

    <Grid x:Name="MainGrid" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Image x:Name="ImageIconNickName" Grid.Row="0" Grid.RowSpan="2" Opacity="0.48" Panel.ZIndex="-1" HorizontalAlignment="Center" VerticalAlignment="Top" StretchDirection="DownOnly" Stretch="UniformToFill" Source="/UI/Images/Autor/VECTOR.jpg"/>
        <Border x:Name="BorderNickName" BorderBrush="Black" BorderThickness="2,2,2,2">
            <Grid Background="#99477563">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="90"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextBlockNickName" Text="A" FontSize="18" Style="{Binding Mode=OneWay, Source={StaticResource Tablon}}" FontWeight="Bold" Foreground="#FF56FF78" TextAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="1" Padding="5,0,5,0" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TextBlockPhrase" Text="A" FontStyle="Italic" Foreground="#FFC3BDDE" Grid.RowSpan="1" TextDecorations="Underline" Grid.Row="1" Padding="2,2,2,2" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"/>
                    <TextBlock Text="Фраза:" FontStyle="Italic" FontWeight="Bold" HorizontalAlignment="Left" FontSize="15" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight"/>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Background="#994C67A9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TextBlockMessage" TextWrapping="Wrap" Text="- за." FontStyle="Italic" Foreground="#FFC3BDDE" Grid.RowSpan="1" Panel.ZIndex="0" Grid.Row="1" FontSize="14"/>
            <TextBlock Text="Благодарен за:" FontStyle="Italic" FontWeight="Bold" Foreground="#FF171717" FontSize="16" Padding="2,0,4,0" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Page>
