<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.Description"
      xmlns:GUI="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=LibraryIEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL" x:Class="ApplicationOperPageLes.UI.Pages.Description.PageDescriptionAlias"
      Title="PageDescriptionAlias">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMainDescription" Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TextBlockNameAlias" FontSize="20" FontFamily="Cascadia Code" TextAlignment="Center" Margin="5,0,5,0" Text="Команда не выбрана" Padding="0,3,0,3" TextTrimming="CharacterEllipsis" FontWeight="Bold" LineStackingStrategy="BlockLineHeight" MinWidth="300"/>
        <Grid x:Name="GridDiscription" Grid.RowSpan="1" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TextBlockAlias" FontSize="16" FontFamily="Cascadia Code" Text="Команда не выбрана" Padding="0,3,0,3" TextTrimming="CharacterEllipsis" Grid.RowSpan="1" Grid.Row="1" TextDecorations="Underline" LineStackingStrategy="BlockLineHeight" Margin="10,0,10,0"/>
            <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="2" Margin="5,5,5,5" CornerRadius="5,5,5,5" Grid.RowSpan="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TextBlockAliasCommand" Text="TextBlock" VerticalAlignment="Center" Padding="0,5,0,5" FontSize="16" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" Margin="2,0,2,0" Grid.ColumnSpan="1" Grid.Column="1" FontFamily="Cascadia Code"/>
                        <TextBlock Text="alias*" VerticalAlignment="Center" Padding="0,5,0,5" FontSize="16" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" Margin="2,0,2,0" Grid.ColumnSpan="1" Grid.Column="0" FontFamily="{DynamicResource Bree CYR var}" FontStyle="Italic"/>
                    </Grid>
                    <TextBlock x:Name="TextBlockDescriptionAliasCommand" Grid.Row="1" Text="Текст" FontSize="16" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="2,0,2,0" Padding="0,2,0,2" />
                </Grid>
            </Border>
            <TextBlock x:Name="TextBlockDescriptionAlias" Grid.Row="3" Text="текст" FontSize="16" TextTrimming="CharacterEllipsis"  TextWrapping="Wrap" Margin="20,5,20,5" FontFamily="{DynamicResource Bree CYR var}"/>
        </Grid>
    </Grid>
</Page>
