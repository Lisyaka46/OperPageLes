<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPageLes.UI.Pages.Description"
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" x:Class="OperPageLes.UI.Pages.Description.PageDescriptionConsole"
      Title="PageDescriptionConsole">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid x:Name="GridMainDescription" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TextBlockNameCommand" FontSize="20" FontFamily="Cascadia Code" TextAlignment="Center" Margin="5,0,5,0" Text="Команда не выбрана" Padding="10,3,10,3" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" FontWeight="Bold" Grid.ColumnSpan="1" Grid.Column="0" Grid.Row="0"/>
            <Grid x:Name="GridDiscription" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextBlockDescriptionCountParameter" FontSize="16" VerticalAlignment="Center" Margin="5,0,5,0" TextTrimming="CharacterEllipsis" TextDecorations="Underline" FontFamily="Cascadia Code" Padding="0,2,0,2" Text="О командных параметрах"/>
                <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="1" CornerRadius="5,5,5,5" Margin="5,0,5,0" Padding="0,2,0,2">
                    <TextBlock x:Name="TextBlockTextCommand" TextWrapping="Wrap" Margin="5,0,5,0" FontSize="16" TextAlignment="Center" Grid.ColumnSpan="1" Text="Сама команда" MinWidth="200" MaxWidth="500" FontFamily="Cascadia Code" />
                </Border>
                <TextBlock x:Name="TextBlockMainDescriptionCommand" Grid.Row="2" Margin="20,5,20,5" FontSize="16" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Text="текст" FontFamily="{DynamicResource Bree CYR var}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
