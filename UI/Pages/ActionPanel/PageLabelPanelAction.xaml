<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.Windows.Pages.ActionPanel"
      xmlns:GUI="clr-namespace:IEL;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" x:Class="OperPage_les.Windows.Pages.ActionPanel.PageLabelElementActionPanel"
      mc:Ignorable="d" 
      d:DesignHeight="180" d:DesignWidth="150"
      Title="PageLabelActionPanel">

    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GUI:IELButtonTextKey x:Name="IELButtonExecuteLabel" Text="Выполнить" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" CharKeyKeyboard="D1" Margin="4,4,4,4" Style="{Binding Mode=OneWay, Source={StaticResource Bree CYR var}}" FontSize="16" PaddingContent="0,10,0,10">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FF40BF8E" Select="#FF45F7B2" Used="#FFB5FFE2" UsedState="False"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonChangeLabel" Text="Изменить" CornerRadius="6,6,6,6" CharKeyKeyboard="D2" Margin="4,4,4,4" Grid.Row="1" Grid.RowSpan="1" Style="{Binding Mode=OneWay, Source={StaticResource Bree CYR var}}" FontSize="16" PaddingContent="0,10,0,10">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FF4093BF" Select="#FF3FB4F1" Used="#FFA7DCF7" UsedState="False"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonRemoveLabel" Text="Удалить" CornerRadius="6,6,6,6" CharKeyKeyboard="D3" Margin="4,4,4,4" Grid.Row="2" Grid.RowSpan="1" Style="{Binding Mode=OneWay, Source={StaticResource Bree CYR var}}" FontSize="16" PaddingContent="0,10,0,10">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFF12727" Default="#FFEA7878" Select="#FFFF5D5D" Used="#FFF7CDCD" UsedState="False"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
    </Grid>
</Page>
