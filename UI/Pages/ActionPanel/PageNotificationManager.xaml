<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.ActionPanel"
      xmlns:UserElementControl="clr-namespace:ApplicationOperPageLes.UI.UserElementControl" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" x:Class="ApplicationOperPageLes.UI.Pages.ActionPanel.PageNotificationManager"
      MinWidth="50" MinHeight="50">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Менеджер оповещений" VerticalAlignment="Top" Padding="2,2,2,2" FontSize="16" FontFamily="{DynamicResource Plup}" TextAlignment="Center" Foreground="#FF8FD3F7" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="Center" Grid.RowSpan="1" Grid.Row="1" Focusable="False">
            <Grid x:Name="GridElementsLoading">
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
