<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.Windows.Frames"
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      x:Class="OperPage_les.Windows.Frames.PageMainConsolePanelAction">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GUI:IELButtonTextKey x:Name="IELButtonCrearConsole" Text="Очистить текст консоли" Margin="0,4,0,4" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" CharKeyKeyboard="D1" FontSize="16"  PaddingContent="0,10,0,10" FontFamily="{DynamicResource Bree CYR var}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting VisibleMouseImaging="True" StateVisualizationButton="Default">
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ Default="#FFA1AF65" NotEnabled="#FFE25770" Select="#FFB3BF82" Used="White"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonCommandBuffer" Text="Командный буфер" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" Grid.Row="1" CharKeyKeyboard="D2" Grid.RowSpan="1" FontSize="16"  PaddingContent="0,10,0,10" Margin="0,4,0,4" FontFamily="{DynamicResource Bree CYR var}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="RightArrow" VisibleMouseImaging="True">
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ Default="#FF65AFAD" NotEnabled="#FFE25770" Select="#FF14CFE8" Used="White"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonDiscriptionCommand" Text="Описание команд" Margin="0,4,0,4" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" Grid.Row="2" CharKeyKeyboard="D3" Grid.RowSpan="1" FontSize="16"  PaddingContent="0,10,0,10" FontFamily="{DynamicResource Bree CYR var}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ Default="#FF8BA6E8" Select="#FF8BBBE8" Used="#FFB3CAD4" NotEnabled="#FFE25770"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>

    </Grid>
</Page>
