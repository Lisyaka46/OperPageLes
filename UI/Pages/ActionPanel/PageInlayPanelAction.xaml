<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.UI.Pages.ActionPanel"
      xmlns:IEL="clr-namespace:IEL;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" x:Class="OperPage_les.UI.Pages.ActionPanel.PageInlayPanelAction"
      mc:Ignorable="d" 
      d:DesignHeight="270.544" d:DesignWidth="252.115"
      Title="PageActionInlay">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/FontsDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <IEL:IELButtonTextKey x:Name="IELButtonPageOpenInlay" Text="Открыть вкладку" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" CharKeyKeyboard="D1"  FontSize="16" BorderThicknessBlock="3,3,3,3" Margin="0,4,0,4" PaddingContent="0,10,0,10" FontFamily="{DynamicResource Bree CYR var}">
            <IEL:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ NotEnabled="#FF2F0404" Select="#FF0D1F12" Used="#FF232323"/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FF310000" Select="#FF0B1F18" Used="#FF171717"/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFE63F3F" Default="#FF2E9E6D" Select="#FF48C38D" Used="#FFAAF1D2"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </IEL:IELButtonTextKey.IELSettingObject>
        </IEL:IELButtonTextKey>
        <IEL:IELButtonTextKey x:Name="IELButtonPageDeleteInlay" Text="Удалить вкладку" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" CharKeyKeyboard="D2"  FontSize="16" BorderThicknessBlock="3,3,3,3" Grid.Row="1" PaddingContent="0,10,0,10" Margin="0,4,0,4" FontFamily="{DynamicResource Bree CYR var}">
            <IEL:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ NotEnabled="#FF2F0404" Select="#FF1F0D0D" Used="#FF232323"/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FF310000" Select="#FF1F0B0B" Used="#FF171717"/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ Default="#FFA97474" NotEnabled="#FFD04747" Select="#FFEF9696" Used="#FFF7D4D4"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </IEL:IELButtonTextKey.IELSettingObject>
        </IEL:IELButtonTextKey>

    </Grid>
</Page>
