<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      x:Class="ApplicationOperPageLes.UI.Pages.ActionPanel.PageConsole.PageMainConsolePanelAction">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GUI:IELButtonTextKey x:Name="IELButtonCrearConsole" Text="Очистить текст консоли" Margin="0,4,0,4" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" CharKeyKeyboard="D1" FontSize="16"  Padding="0,10,0,10" FontFamily="{DynamicResource Bree CYR var}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting VisibleMouseImaging="True"/>
            </GUI:IELButtonTextKey.IELSettingObject>
            <GUI:IELButtonTextKey.QBackground>
                <Classes:BrushSettingQ Default="#FFA1AF65" NotEnabled="#FFE25770" Select="#FFB3BF82" Used="White"/>
            </GUI:IELButtonTextKey.QBackground>
            <GUI:IELButtonTextKey.QBorderBrush>
                <Classes:BrushSettingQ Default="#FF08402F" NotEnabled="#FF671F1F" Select="#FF1B543E" Used="#FF285E5F"/>
            </GUI:IELButtonTextKey.QBorderBrush>
            <GUI:IELButtonTextKey.QForeground>
                <Classes:BrushSettingQ Select="Black" NotEnabled="Black" Used="Black" Default="Black"/>
            </GUI:IELButtonTextKey.QForeground>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonCommandBuffer" Text="Командный буфер" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" Grid.Row="1" CharKeyKeyboard="D2" Grid.RowSpan="1" FontSize="16"  Padding="0,10,0,10" Margin="0,4,0,4" FontFamily="{DynamicResource Bree CYR var}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="RightArrow" VisibleMouseImaging="True"/>
            </GUI:IELButtonTextKey.IELSettingObject>
            
            <GUI:IELButtonTextKey.QBorderBrush>
                <Classes:BrushSettingQ Default="#FF07403F" Select="#FF708D8E" Used="#FF7FC3D0"/>
            </GUI:IELButtonTextKey.QBorderBrush>
            <GUI:IELButtonTextKey.QForeground>
                <Classes:BrushSettingQ NotEnabled="Black" Default="Black" Select="Black" Used="Black"/>
            </GUI:IELButtonTextKey.QForeground>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonDiscriptionCommand" Text="Описание команд" Margin="0,4,0,4" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" Grid.Row="2" CharKeyKeyboard="D3" Grid.RowSpan="1" FontSize="16"  Padding="0,10,0,10" FontFamily="{DynamicResource Bree CYR var}">
            <GUI:IELButtonTextKey.QBackground>
                <Classes:BrushSettingQ Default="#FF8BA6E8" Select="#FF8BBBE8" Used="#FFB3CAD4" NotEnabled="#FFE25770"/>
            </GUI:IELButtonTextKey.QBackground>
            <GUI:IELButtonTextKey.QBorderBrush>
                <Classes:BrushSettingQ Default="#FF17395D" NotEnabled="#FF4E1B30" Select="#FF284771" Used="#FF046477"/>
            </GUI:IELButtonTextKey.QBorderBrush>
            <GUI:IELButtonTextKey.QForeground>
                <Classes:BrushSettingQ Default="Black" NotEnabled="#FF730528" Select="#FF222A2D" Used="#FF0B3340"/>
            </GUI:IELButtonTextKey.QForeground>
        </GUI:IELButtonTextKey>

    </Grid>
</Page>
