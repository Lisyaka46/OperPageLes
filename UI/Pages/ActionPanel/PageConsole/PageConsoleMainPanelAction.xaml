<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      x:Class="ApplicationOperPageLes.UI.Pages.ActionPanel.PageConsole.PageMainConsolePanelAction">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GUI:IELButtonTextKey x:Name="IELButtonCrearConsole" Text="Очистить текст консоли" Margin="0,4,0,4" Grid.ColumnSpan="1" FontSize="16" FontFamily="{DynamicResource Bree CYR var}"/>
        <GUI:IELButtonTextKey x:Name="IELButtonCommandBuffer" Text="Командный буфер" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" Grid.Row="1" Grid.RowSpan="1" FontSize="16" Margin="0,4,0,4" FontFamily="{DynamicResource Bree CYR var}"/>
        <GUI:IELButtonTextKey x:Name="IELButtonDiscriptionCommand" Text="Описание команд" Margin="0,4,0,4" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" Grid.Row="2" Grid.RowSpan="1" FontSize="16" FontFamily="{DynamicResource Bree CYR var}"/>

    </Grid>
</Page>
