<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPageLes.UI.Pages.ActionPanel"
      xmlns:GUI="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
      x:Class="OperPageLes.UI.Pages.ActionPanel.PageConsole.BufferPagePanelAction" Width="250" Height="250">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderBuffer" BorderBrush="#FF163C34" BorderThickness="3,3,3,3" Grid.Row="1" CornerRadius="3,3,3,3" Margin="4,4,4,4" Panel.ZIndex="0" ClipToBounds="True" Background="#B21B2F2E" MinHeight="60">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextBlockCounterBuffer" Text="00/00" Foreground="#FF80EAE2" Grid.Column="1" TextAlignment="Right" FontSize="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-3,0" Panel.ZIndex="1">
                    <TextBlock.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF163C26" Offset="0.568"/>
                            <GradientStop Color="#00163C26" Offset="1"/>
                        </RadialGradientBrush>
                    </TextBlock.Background>
                </TextBlock>
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Hidden" Grid.RowSpan="2" Grid.Row="0">
                    <Grid x:Name="GridBuffer" VerticalAlignment="Top"/>
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid Margin="0,5,0,0">
            <Grid.Resources>
                <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <GUI:IELButtonTextKey x:Name="IELButtonBackMainMenu" Text="Назад" FontSize="16" Margin="3,0,3,0" FontFamily="{DynamicResource Bree CYR var}" KeyActivateButton="Oem3" CornerRadiusKey="8,8,8,8" Height="50" MarginViewBox="5,7,5,7" Padding="10,0,10,0"/>
            <GUI:IELButtonTextKey x:Name="IELButtonClearBuffer" Text="Очистить" Grid.Column="1" FontSize="16" Margin="3,0,3,0" FontFamily="{DynamicResource Bree CYR var}" CornerRadiusKey="8,8,8,8" KeyActivateButton="D1" Height="50" MarginViewBox="5,7,5,7"/>
        </Grid>
    </Grid>
</Page>
