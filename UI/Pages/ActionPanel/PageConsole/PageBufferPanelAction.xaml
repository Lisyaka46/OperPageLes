<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.ActionPanel"
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      x:Class="ApplicationOperPageLes.UI.Pages.ActionPanel.PageConsole.PageBufferPanelAction">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderBuffer" BorderBrush="#FF163C34" BorderThickness="3,3,3,3" Grid.Row="1" CornerRadius="3,3,3,3" Margin="4,4,4,4" Panel.ZIndex="0" ClipToBounds="True" Background="#B21B2F2E" MinHeight="60">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextBlockCounterBuffer" Text="00/00" Foreground="#FF80EAE2" Grid.Column="1" TextAlignment="Right" FontSize="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-3,0" Panel.ZIndex="1">
                    <TextBlock.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF163C26" Offset="0.568"/>
                            <GradientStop Color="#00163C26" Offset="1"/>
                        </RadialGradientBrush>
                    </TextBlock.Background>
                </TextBlock>
                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Hidden" Grid.RowSpan="2" Grid.Row="0">
                    <Grid x:Name="GridBuffer"/>
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="98*"/>
                <ColumnDefinition Width="107*"/>
            </Grid.ColumnDefinitions>
            <GUI:IELButtonTextKey x:Name="IELButtonBackMainMenu" Text="Назад" CharKeyKeyboard="Oem3" FontSize="16" Margin="3,0,3,0" FontFamily="{DynamicResource Bree CYR var}" PaddingContent="5,0,5,0" >
                <GUI:IELButtonTextKey.QBackground>
                    <Classes:BrushSettingQ Default="#FF4DA6B7" NotEnabled="#FFC13750" Select="#FF4DD7F1" Used="White"/>
                </GUI:IELButtonTextKey.QBackground>
                <GUI:IELButtonTextKey.QBorderBrush>
                    <Classes:BrushSettingQ/>
                </GUI:IELButtonTextKey.QBorderBrush>
                <GUI:IELButtonTextKey.QForeground>
                    <Classes:BrushSettingQ/>
                </GUI:IELButtonTextKey.QForeground>
            </GUI:IELButtonTextKey>
            <GUI:IELButtonTextKey x:Name="IELButtonClearBuffer" Text="Очистить" CharKeyKeyboard="D1" Grid.Column="1" FontSize="16" Margin="3,0,3,0"  IsEnabled="False" FontFamily="{DynamicResource Bree CYR var}" PaddingContent="5,0,5,0">
                <GUI:IELButtonTextKey.QBackground>
                    <Classes:BrushSettingQ NotEnabled="#FFAF223B" Default="#FF988068" Select="#FFD2AD88" Used="White"/>
                </GUI:IELButtonTextKey.QBackground>
                <GUI:IELButtonTextKey.QBorderBrush>
                    <Classes:BrushSettingQ NotEnabled="#FF732525"/>
                </GUI:IELButtonTextKey.QBorderBrush>
                <GUI:IELButtonTextKey.QForeground>
                    <Classes:BrushSettingQ NotEnabled="#FFEA7C7C"/>
                </GUI:IELButtonTextKey.QForeground>
                <!--<GUI:IELButtonTextKey.IELSettingObject>
                    <ObjectSettings:IELButtonObjectSetting>
                        <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                            <Classes:BrushSettingQ/>
                        </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            <Classes:BrushSettingQ/>
                        </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            <Classes:BrushSettingQ NotEnabled="#FFC13750" Default="#FF988068" Select="#FFD2AD88" Used="White"/>
                        </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                    </ObjectSettings:IELButtonObjectSetting>
                </GUI:IELButtonTextKey.IELSettingObject>-->
            </GUI:IELButtonTextKey>
        </Grid>
    </Grid>
</Page>
