<Page
    x:Class="OperPageLes.UI.Pages.ActionPanel.Other.PageAudioControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:OperPageLes.UI.Pages.ActionPanel.Other"
    xmlns:Base="clr-namespace:IEL.UserElementsControl.Base;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    Title="PageVolumeControl" Width="260" Height="180">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border>
            <IEL:IELScrollViewer x:FieldModifier="private" x:Name="ScrollDevices" ScrollForce="20" AutoUpdateVisibleHorizontalScroll="False">
                
            </IEL:IELScrollViewer>
        </Border>
        <Slider x:FieldModifier="private" x:Name="SliderVolume" Maximum="100" Value="20" Foreground="{x:Null}" BorderBrush="{x:Null}" Background="{x:Null}" Cursor="Hand" Focusable="False" Panel.ZIndex="0" Grid.RowSpan="1" Grid.Row="1" Margin="0,2,0,2"/>
    </Grid>
</Page>
