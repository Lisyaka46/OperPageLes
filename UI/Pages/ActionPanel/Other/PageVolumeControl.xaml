<Page x:Class="ApplicationOperPageLes.UI.Pages.ActionPanel.Other.PageVolumeControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.ActionPanel.Other"
      Title="PageVolumeControl">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <ComboBox x:Name="ComboBoxAudioDevices" Margin="0,0,0,2">
                
            </ComboBox>
        </Grid>
        <Slider x:Name="SliderVolume" Maximum="100" Value="20" Foreground="{x:Null}" BorderBrush="{x:Null}" Background="{x:Null}" Cursor="Hand" Focusable="False" Panel.ZIndex="1" Grid.RowSpan="1" Grid.Row="1"/>

    </Grid>
</Page>
