<Page
    x:Class="OperPageLes.UI.Pages.ActionPanel.Other.PageAudioControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:OperPageLes.UI.Pages.ActionPanel.Other"
    xmlns:Base="clr-namespace:IEL.UserElementsControl.Base;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    Title="PageVolumeControl" Width="260" Height="180">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <IEL:IELScrollViewer x:FieldModifier="private" x:Name="ScrollDevices" ScrollForce="20" AutoUpdateVisibleHorizontalScroll="False"/>
        <Line Stroke="White" X2="1" Stretch="Uniform" VerticalAlignment="Bottom" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeThickness="2" Margin="3,0,3,-2"/>
        <Grid Grid.Row="1" Margin="3,5,3,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Slider x:FieldModifier="private" x:Name="SliderVolume" Maximum="100" Value="20" Foreground="{x:Null}" BorderBrush="{x:Null}" Background="{x:Null}" Cursor="SizeWE" Focusable="False" Panel.ZIndex="0" Margin="0,2,0,2" Grid.ColumnSpan="1" Grid.Column="0"/>
            <TextBlock x:Name="TextBlockValue" Grid.Column="1" Text="100" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource RussianRail G Pro}" FontSize="13" Foreground="White"/>
        </Grid>
    </Grid>
</Page>
