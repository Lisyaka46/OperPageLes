<Page x:Class="ApplicationOperPageLes.UI.Pages.ActionPanel.PageLabel.PageLabelSelectManipulatePanelAction"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.ActionPanel.PageLabel"
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      Title="PageLabelSelectManipulatePanelAction" Width="208">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GUI:IELButtonTextKey x:Name="IELButtonExecuteSelect" Text="Выделить" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" Margin="4,4,4,4"  FontSize="16" Padding="8,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}" Grid.Row="1" Background="{DynamicResource BG_Olive}" BorderBrush="{DynamicResource BB_Olive}" Foreground="{DynamicResource FG_Olive}"/>
        <GUI:IELButtonTextKey x:Name="IELButtonBack" Text="Назад" CornerRadius="6,6,6,6" Margin="4,4,4,4" Grid.Row="0" Grid.RowSpan="1"  FontSize="16" Padding="0,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}" BorderThickness="3,3,3,3" Background="{DynamicResource BG_PastelBlue}" BorderBrush="{DynamicResource BB_PastelBlue}" Foreground="{DynamicResource FG_PastelBlue}"/>
        <GUI:IELButtonTextKey x:Name="IELButtonClearSelect" Text="Снять выделение" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" Margin="4,4,4,4"  FontSize="16" Padding="8,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}" Grid.Row="2" Background="{DynamicResource BG_Cocoa}" BorderBrush="{DynamicResource BB_Cocoa}" Foreground="{DynamicResource FG_Cocoa}"/>
    </Grid>
</Page>
