<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:OperPageLes.UI.Pages.ActionPanel.PageLabel"
    xmlns:GUI="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
    xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=LibraryIEL"
    x:Class="OperPageLes.UI.Pages.ActionPanel.PageLabel.PageLabelElementActionPanel"
    Width="210" Height="294">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain" VerticalAlignment="Center">
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GUI:IELButtonTextKey x:Name="IELButtonExecuteLabel" Text="Выполнить" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" Margin="4,4,4,4"  FontSize="16" FontFamily="{DynamicResource Bree CYR var}" Grid.Row="0" PaletteElement="{DynamicResource Green}" KeyActivateButton="D1" Height="50" MarginViewBox="5,7,5,7"/>
        <GUI:IELButtonTextKey x:Name="IELButtonChangeLabel" Text="Изменить" CornerRadius="6,6,6,6" Margin="4,4,4,4" Grid.Row="1" Grid.RowSpan="1"  FontSize="16" FontFamily="{DynamicResource Bree CYR var}" PaletteElement="{DynamicResource Purple}" KeyActivateButton="D2" Height="50" MarginViewBox="5,7,5,7"/>
        <GUI:IELButtonTextKey x:Name="IELButtonRemoveLabel" Text="Удалить" CornerRadius="6,6,6,6" Margin="4,4,4,4" Grid.Row="2" Grid.RowSpan="1"  FontSize="16" FontFamily="{DynamicResource Bree CYR var}" PaletteElement="{DynamicResource PastelRed}" KeyActivateButton="D3" Height="50" MarginViewBox="5,7,5,7"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <GUI:IELButtonTextKey x:Name="IELButtonSetLabelTag" Text="Добавить тег" CornerRadius="6,6,6,6" Margin="6,4,4,4" Grid.Row="0" Grid.RowSpan="1"  FontSize="16" FontFamily="{DynamicResource Bree CYR var}" Grid.Column="1" PaletteElement="{DynamicResource Jade}" KeyActivateButton="D4" Height="50" MarginViewBox="5,7,5,7"/>
            <GUI:IELBlockInfoImage x:Name="IELBlockInfoTagLabel" CornerRadius="6,6,6,6" BorderThickness="3,3,3,3" Width="40" Height="40" Padding="4,0,4,0" Margin="4,0,3,0" PaletteElement="{DynamicResource Lime}"/>
        </Grid>
        <GUI:IELButtonTextKey x:Name="IELButtonActivateSelectMenu" Text="Выделение" CornerRadius="6,6,6,6" Margin="4,4,4,4" Grid.Row="4" Grid.RowSpan="1"  FontSize="16" FontFamily="{DynamicResource Bree CYR var}" PaletteElement="{DynamicResource PastelBlue}" KeyActivateButton="D5" Height="50" MarginViewBox="5,7,5,7" VisualGuide="RightArrow"/>
    </Grid>
</Page>
