<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.UI.Pages.ActionPanel.PageLabel"
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      x:Class="OperPage_les.UI.Pages.ActionPanel.PageLabel.PageLabelElementActionPanel"
      mc:Ignorable="d"
      Title="PageLabelActionPanel" Width="220">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GUI:IELButtonTextKey x:Name="IELButtonExecuteLabel" Text="Выполнить" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" CharKeyKeyboard="D1" Margin="4,4,4,4"  FontSize="16" PaddingContent="0,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}" Grid.Row="0">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FF40BF8E" Select="#FF45F7B2" Used="#FFB5FFE2"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonChangeLabel" Text="Изменить" CornerRadius="6,6,6,6" CharKeyKeyboard="D2" Margin="4,4,4,4" Grid.Row="1" Grid.RowSpan="1"  FontSize="16" PaddingContent="0,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="LeftArrow">
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FF4093BF" Select="#FF3FB4F1" Used="#FFA7DCF7"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonRemoveLabel" Text="Удалить" CornerRadius="6,6,6,6" CharKeyKeyboard="D3" Margin="4,4,4,4" Grid.Row="2" Grid.RowSpan="1"  FontSize="16" PaddingContent="0,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FFEA7878" Select="#FFFF5D5D" Used="#FFF7CDCD"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <GUI:IELButtonTextKey x:Name="IELButtonSetLabelTag" Text="Добавить тег" CornerRadius="6,6,6,6" CharKeyKeyboard="D4" Margin="6,4,4,4" Grid.Row="0" Grid.RowSpan="1"  FontSize="16" PaddingContent="0,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}" Grid.Column="1">
                <GUI:IELButtonTextKey.IELSettingObject>
                    <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="Default">
                        <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                            <Classes:BrushSettingQ/>
                        </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            <Classes:BrushSettingQ/>
                        </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FFA7974A" Select="#FFDEC85F" Used="#FFFFF4BC"/>
                        </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                    </ObjectSettings:IELButtonObjectSetting>
                </GUI:IELButtonTextKey.IELSettingObject>
            </GUI:IELButtonTextKey>
            <GUI:IELBlockInfoImage x:Name="IELBlockInfoTagLabel" CornerRadius="6,6,6,6" BorderThicknessBlock="3,3,3,3" Width="40" Height="40" PaddingContent="4,0,4,0" Margin="0,0,3,0">
                <GUI:IELBlockInfoImage.IELSettingObject>
                    <ObjectSettings:IELUsingObjectSetting IntervalHover="10">
                        <ObjectSettings:IELUsingObjectSetting.BorderBrushSetting>
                            <Classes:BrushSettingQ NotEnabled="#FF4C1616" Select="#FF425449" Used="#FF316763"/>
                        </ObjectSettings:IELUsingObjectSetting.BorderBrushSetting>
                        <ObjectSettings:IELUsingObjectSetting.BackgroundSetting>
                            <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FFB1A35F" Select="#FF60F369" Used="#FF49924E"/>
                        </ObjectSettings:IELUsingObjectSetting.BackgroundSetting>
                    </ObjectSettings:IELUsingObjectSetting>
                </GUI:IELBlockInfoImage.IELSettingObject>
            </GUI:IELBlockInfoImage>
        </Grid>
        <GUI:IELButtonTextKey x:Name="IELButtonActivateSelectMenu" Text="Выделение" CornerRadius="6,6,6,6" CharKeyKeyboard="D5" Margin="4,4,4,4" Grid.Row="4" Grid.RowSpan="1"  FontSize="16" FontFamily="{DynamicResource Deledda Open Regular}" PaddingContent="0,10,0,10">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="RightArrow">
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FF49BD65" Select="#FF49F573" Used="#FFA9FFBE"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
    </Grid>
</Page>
