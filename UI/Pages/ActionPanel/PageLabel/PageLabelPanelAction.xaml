<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.UI.Pages.ActionPanel.PageLabel"
      xmlns:GUI="clr-namespace:IEL;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
      x:Class="OperPage_les.UI.Pages.ActionPanel.PageLabel.PageLabelElementActionPanel"
      mc:Ignorable="d"
      Title="PageLabelActionPanel" Width="220">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GUI:IELButtonTextKey x:Name="IELButtonExecuteLabel" Text="Выполнить" CornerRadius="6,6,6,6" Grid.ColumnSpan="1" CharKeyKeyboard="D1" Margin="4,4,4,4"  FontSize="16" PaddingContent="0,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}" Grid.Row="1">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FF40BF8E" Select="#FF45F7B2" Used="#FFB5FFE2"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonChangeLabel" Text="Изменить" CornerRadius="6,6,6,6" CharKeyKeyboard="D2" Margin="4,4,4,4" Grid.Row="2" Grid.RowSpan="1"  FontSize="16" PaddingContent="0,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="LeftArrow">
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FF4093BF" Select="#FF3FB4F1" Used="#FFA7DCF7"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonRemoveLabel" Text="Удалить" CornerRadius="6,6,6,6" CharKeyKeyboard="D3" Margin="4,4,4,4" Grid.Row="3" Grid.RowSpan="1"  FontSize="16" PaddingContent="0,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FFEA7878" Select="#FFFF5D5D" Used="#FFF7CDCD"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <GUI:IELButtonTextKey x:Name="IELButtonCreateLabelTag" Text="Управление тегами" CornerRadius="6,6,6,6" CharKeyKeyboard="D4" Margin="4,4,4,4" Grid.Row="4" Grid.RowSpan="1"  FontSize="16" PaddingContent="0,10,0,10" FontFamily="{DynamicResource Deledda Open Regular}">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="LeftArrow">
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FFA7974A" Select="#FFDEC85F" Used="#FFFFF4BC"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
        <Grid>
            <ScrollViewer x:Name="ScrollViewerTags" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden">
                <Grid x:Name="GridMainVisibleTag"/>
            </ScrollViewer>
        </Grid>
        <GUI:IELButtonTextKey x:Name="IELButtonActivateSelectMenu" Text="Выделение" CornerRadius="6,6,6,6" CharKeyKeyboard="D5" Margin="4,4,4,4" Grid.Row="5" Grid.RowSpan="1"  FontSize="16" FontFamily="{DynamicResource Deledda Open Regular}" PaddingContent="0,10,0,10">
            <GUI:IELButtonTextKey.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="RightArrow">
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ NotEnabled="#FFDA4444" Default="#FF49BD65" Select="#FF49F573" Used="#FFA9FFBE"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </GUI:IELButtonTextKey.IELSettingObject>
        </GUI:IELButtonTextKey>
    </Grid>
</Page>
