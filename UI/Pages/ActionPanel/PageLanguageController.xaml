<Page
    x:Class="OperPageLes.UI.Pages.ActionPanel.PageLanguageController"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="400" Height="300">
    <Grid>
        <IEL:IELScrollViewer x:Name="LanguagesScrollController" Grid.Row="1" MinScrollSize="70" ThicknessScroll="12">
        </IEL:IELScrollViewer>
        <TextBlock x:Name="TextBlockUpdateInfo" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Text="Идёт обновление списка..." Padding="0,0,3,3" FontStyle="Italic" FontFamily="{DynamicResource Bree CYR var}"/>
    </Grid>
</Page>
