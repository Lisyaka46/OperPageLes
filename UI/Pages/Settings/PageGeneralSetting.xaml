<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OperPage_les.UI.Pages.Settings"
      xmlns:IEL="clr-namespace:IEL;assembly=IEL" xmlns:Classes="clr-namespace:IEL.Classes;assembly=IEL" x:Class="OperPage_les.UI.Pages.Settings.PageGeneralSetting"
      mc:Ignorable="d" 
      d:DesignHeight="370.818" d:DesignWidth="570"
      Title="PageGeneral" MinWidth="570">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120*" MinHeight="117"/>
            <RowDefinition Height="59*" MinHeight="50"/>
            <RowDefinition Height="111*" MinHeight="98"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderPathImageBackground" BorderBrush="Black" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Margin="6,6,6,6" Background="#B2485A44">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="29"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Image x:Name="ImageBackground" Source="/UI/Images/DoubleMouseButton.png" Grid.RowSpan="2" Panel.ZIndex="-1" Opacity="0.15" Stretch="UniformToFill" >
                    <Image.Effect>
                        <BlurEffect x:Name="BlurEffectImageBackground" KernelType="Box" RenderingBias="Quality" Radius="0"/>
                    </Image.Effect>
                </Image>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="131"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Изображение фона" Style="{Binding Mode=OneWay, Source={StaticResource Bree CYR var Regular}}" Margin="3,0,3,0" FontSize="14" VerticalAlignment="Center" Height="20"/>
                    <TextBlock x:Name="TextBlockFailedImageSetup" Grid.Column="1" TextWrapping="Wrap" Text="Не удалось установить изображение по ссылке или директории" FontSize="14" VerticalAlignment="Center" Foreground="White" FontStyle="Italic"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TextBoxPathMenuImage" Text="Директория" BorderThickness="1,0,1,0" Background="{x:Null}" Style="{Binding Mode=OneWay, Source={StaticResource Vollda}}" MaxLines="1" IsUndoEnabled="False" Focusable="False" Grid.RowSpan="1" Grid.Row="0" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="1" Margin="5,3,5,3"/>
                        <IEL:IELButtonText x:Name="IELButtonDialogDirectoryFile" Text="Обзор" VisibleMouseImaging="False" AnimationMillisecond="160" Style="{Binding Mode=OneWay, Source={StaticResource Vollda}}" BorderThicknessBlock="2,2,2,2" Grid.Column="1" Margin="3,3,3,3"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <IEL:IELButtonText x:Name="IELButtonSetTextClipboard" Text="Вставить ссылку из буфера" VisibleMouseImaging="False" AnimationMillisecond="160" Style="{Binding Mode=OneWay, Source={StaticResource Vollda}}" BorderThicknessBlock="2,2,2,2" Grid.Column="2" Margin="5,5,5,5"/>
                        <IEL:IELButtonText x:Name="IELButtonClearImage" Text="Убрать фон" VisibleMouseImaging="False" AnimationMillisecond="160" Style="{Binding Mode=OneWay, Source={StaticResource Vollda}}" BorderThicknessBlock="2,2,2,2" Grid.Column="0" Margin="5,5,5,5">
                            <IEL:IELButtonText.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FF778D98" NotEnabled="#FFFF1D65" Select="#FF35A1B5" Used="#FF3DEDE9" UsedState="False"/>
                            </IEL:IELButtonText.BackgroundSetting>
                        </IEL:IELButtonText>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,3,0,1">
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="40" MaxHeight="50"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>
            <Border x:Name="BorderBufferSize" BorderBrush="Black" BorderThickness="2,2,2,2" Margin="6,6,6,0" CornerRadius="5,5,5,5" Background="#B2485A44">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="11*" MinWidth="230"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Размер буфера" Style="{Binding Mode=OneWay, Source={StaticResource Bree CYR var Regular}}" FontSize="14" Padding="4,0,4,0" TextAlignment="Center" VerticalAlignment="Center" Height="19"/>
                    <Slider x:Name="SliderBufferSize" SmallChange="1" Maximum="80" Minimum="10" TickPlacement="BottomRight" TickFrequency="1" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#99FFFFFF"  IsSnapToTickEnabled="True" Value="10" Grid.Column="1" Grid.ColumnSpan="1" Margin="2,2,2,2" Grid.RowSpan="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <TextBlock x:Name="TextBlockSliderBufferSize" TextWrapping="Wrap" Text="00" Grid.Column="2" Style="{Binding Mode=OneWay, Source={StaticResource RussianRail G Pro}}" FontSize="16" VerticalAlignment="Center" Height="19"/>
                </Grid>
            </Border>
            <Border x:Name="BorderSettingBufferSize" BorderBrush="Black" BorderThickness="2,0,2,2" Panel.ZIndex="-1" CornerRadius="0,0,5,5" Margin="12,0,12,0" Background="#E5713131" Grid.RowSpan="1" Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="316"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Настройка активируется только после перезагрузки" Foreground="White" Padding="3,0,3,0" Style="{Binding Mode=OneWay, Source={StaticResource Vollda}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <IEL:IELButtonText x:Name="IELButtonTextClearValue" HorizontalAlignment="Left" Grid.Column="1" CornerRadius="5,5,5,5" Margin="8,3,0,3" Text="По умолчанию" PaddingContent="8,0,8,0"/>
                </Grid>
            </Border>
        </Grid>
        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="1" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#B2485A44">
            <CheckBox x:Name="CheckBoxBlurDataTimeImage" Content="Отображать размытие картинки в панели времени и даты" VerticalContentAlignment="Center" Padding="4,0,4,0" IsChecked="False" Cursor="Hand" FontSize="14" BorderBrush="Black" Background="#FF00DAD5" Style="{Binding Mode=OneWay, Source={StaticResource Bree CYR var Regular}}" Margin="4,0,0,0" HorizontalAlignment="Left"/>
        </Border>

    </Grid>
</Page>
