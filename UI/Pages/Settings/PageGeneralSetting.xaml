<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.Settings"
      xmlns:IEL="clr-namespace:IEL.GUI;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" xmlns:gif="http://wpfanimatedgif.codeplex.com" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" x:Class="ApplicationOperPageLes.UI.Pages.Settings.PageGeneralSetting"
      mc:Ignorable="d" 
      d:DesignHeight="626.41"
      Title="PageGeneral">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MaxHeight="60"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderPathImageBackground" BorderBrush="Black" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Margin="6,6,6,6" MaxWidth="600" ClipToBounds="True" Focusable="True">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="1"/>
                    <GradientStop Color="#FF7B5F5F" Offset="0.354"/>
                    <GradientStop Color="#FF225761" Offset="0.677"/>
                    <GradientStop Color="#FF00B1A6" Offset="0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.OpacityMask>
                    <RadialGradientBrush GradientOrigin="1,1" RadiusX="0.8" RadiusY="0.8" Center="0.5,0.5">
                        <GradientStop Color="Black" Offset="0.92"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Grid.OpacityMask>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock TextWrapping="Wrap" Text="Изображение фона"  FontSize="18" Grid.RowSpan="1" TextAlignment="Center" Padding="0,0,0,10" FontFamily="{DynamicResource RussianRail G Pro}">
                    <TextBlock.Background>
                        <RadialGradientBrush GradientOrigin="0.5,-1" RadiusX="0.3" RadiusY="1" Center="0.5,0">
                            <GradientStop Offset="1"/>
                            <GradientStop Color="#CC417AA5" Offset="0"/>
                        </RadialGradientBrush>
                    </TextBlock.Background>
                </TextBlock>

                <Image x:Name="ImageBackground" Panel.ZIndex="-1" Opacity="0.6" Grid.RowSpan="2" IsHitTestVisible="False" Stretch="UniformToFill" Source="/UI/Images/IconMainApplication.png" VerticalAlignment="Center" >
                    <Image.OpacityMask>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterX="0.5" CenterY="0.5"/>
                                    <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="Black" Offset="0.3"/>
                            <GradientStop Offset="1"/>
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.6"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                    <Image.Effect>
                        <BlurEffect x:Name="BlurEffectImageBackground" KernelType="Box" RenderingBias="Quality" Radius="0"/>
                    </Image.Effect>
                </Image>

                <Grid Grid.Row="1" Opacity="0.7">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.RowSpan="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto" MinHeight="34.73"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="ImageErrorBitmapBackground" Source="/UI/Images/Warning.png" Panel.ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <IEL:IELTextBox x:Name="IELTextBoxDirectoryBackground" FontSize="16"  Grid.RowSpan="1" CornerRadius="3,3,3,3" IsReadOnly="True" MaxHeight="40" Margin="50,0,50,0" Padding="0,2,0,2" FontFamily="{DynamicResource Bree CYR var}" Background="{DynamicResource BG_Olive}" BorderBrush="{DynamicResource BB_Olive}" Foreground="{DynamicResource FG_Olive}"/>
                        <TextBlock x:Name="TextBlockFailedImageSetup" TextWrapping="Wrap" Text="Не удалось установить изображение по ссылке или директории" FontSize="17" Foreground="White" FontStyle="Italic" Grid.Row="1" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Padding="0,2,0,2"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="147"/>
                        </Grid.ColumnDefinitions>
                        <IEL:IELButtonText x:Name="IELButtonClearImage" Text="Убрать фон"  BorderThickness="2,2,2,2" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,10,0" FontSize="14" Padding="0,5,0,5" FontFamily="{DynamicResource Bree CYR var}" Background="{DynamicResource BG_Red}" BorderBrush="{DynamicResource BB_Red}" Foreground="{DynamicResource FG_Red}" CornerRadius="5,5,5,5"/>
                        <IEL:IELButtonText x:Name="IELButtonSetTextClipboard" Text="Вставить ссылку из буфера" BorderThickness="2,2,2,2" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0" FontSize="14" Padding="0,5,0,5" FontFamily="{DynamicResource Bree CYR var}" Background="{DynamicResource BG_Green}" BorderBrush="{DynamicResource BB_Green}" Foreground="{DynamicResource FG_Green}" CornerRadius="5,5,5,5"/>
                        <IEL:IELButtonText x:Name="IELButtonDialogDirectoryFile" Text="Обзор"  BorderThickness="2,2,2,2" Grid.Column="2" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="14" Padding="0,5,0,5" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" VisualGuide="RightArrow" PaletteElement="{DynamicResource Purple}" CornerRadiusGuides="7.6,7.6,7.6,7.6"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="1" MaxWidth="600" Grid.RowSpan="1" Margin="0,6,0,6">
            <Grid.RowDefinitions>
                <RowDefinition MaxHeight="50" Height="Auto"/>
                <RowDefinition x:Name="RowDefinitionBufferSize" Height="50" MaxHeight="50" MinHeight="6"/>
            </Grid.RowDefinitions>
            <Border x:Name="BorderBufferSize" BorderBrush="Black" BorderThickness="2,2,2,2" Margin="6,6,6,0" CornerRadius="5,5,5,5" Background="#FF866A36" Padding="0,5,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition MinWidth="230"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Размер буфера"  FontSize="14" Padding="4,0,4,0" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource Bree CYR var}"/>
                    <Slider x:Name="SliderBufferSize" SmallChange="1" Maximum="80" Minimum="10" TickPlacement="BottomRight" TickFrequency="1" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#99FFFFFF"  IsSnapToTickEnabled="True" Value="10" Grid.Column="1" Grid.ColumnSpan="1" Margin="2,2,2,2" Grid.RowSpan="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Delay="100" IsMoveToPointEnabled="True"/>
                    <TextBlock x:Name="TextBlockSliderBufferSize" TextWrapping="Wrap" Text="00" Grid.Column="2"  FontSize="16" VerticalAlignment="Center" FontFamily="{DynamicResource Brenzo Slab Personal Use}" Padding="3,0,8,0" Width="30"/>
                </Grid>
            </Border>
            <Border x:Name="BorderSettingBufferSize" BorderBrush="Black" BorderThickness="2,0,2,2" Panel.ZIndex="-1" CornerRadius="0,0,5,5" Background="#FF772A2A" Grid.RowSpan="1" Grid.Row="1" Padding="0,2,0,2" Margin="12,0,12,0">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Настройка активируется только после перезагрузки" Foreground="White" Padding="10,0,10,0"  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontFamily="{DynamicResource Bree CYR var}"/>
                    <IEL:IELButtonText x:Name="IELButtonTextClearValue" Grid.Column="1" CornerRadius="5,5,5,5" Margin="5,3,5,3" Text="По умолчанию" Padding="8,0,8,0"  FontSize="14" FontFamily="{DynamicResource Vollda}" Background="{DynamicResource BG_PastelRed}" BorderBrush="{DynamicResource BB_PastelRed}" Foreground="{DynamicResource FG_PastelRed}"/>
                </Grid>
            </Border>
        </Grid>
        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="2" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#FF485A44" MaxWidth="600">
            <CheckBox x:Name="CheckBoxInternetConnectionMillisecond" Content="Отображать скорость отклика интернета в миллисекундах" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="14" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
        </Border>
        <Grid Grid.Row="3" MaxWidth="650">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border BorderBrush="Black" BorderThickness="3,3,3,3" Grid.Row="1" Margin="6,-6,6,6" CornerRadius="5,5,5,5" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="Black" BorderThickness="2,2,2,2" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#B26974CC" MaxWidth="600" Grid.RowSpan="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ссылка по умолчанию для веб-браузера"  Padding="4,0,4,0" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" FontSize="14" FontFamily="{DynamicResource Bree CYR var}"/>
                            <IEL:IELTextBox x:Name="IELTextBoxDefaultUrl" FontSize="15" Grid.RowSpan="1" CornerRadius="3,3,3,3" MaxHeight="40" Grid.Row="1" Margin="5,5,5,5" FontFamily="{DynamicResource RussianRail G Pro}" Background="{DynamicResource BG_Violet}" BorderBrush="{DynamicResource BB_Violet}" Foreground="{DynamicResource FG_Violet}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="6,6,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="0" CornerRadius="5,5,5,5" Background="#FF8C5DC8" MaxWidth="600">
                            <CheckBox x:Name="CheckBoxUsePageBrowser" Content="Использовать страницу браузера для открытия ссылок по умолчанию" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="14" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
                        </Border>
                        <Border BorderBrush="#72000000" Grid.Row="1" BorderThickness="2,0,0,0" Margin="10,2,0,2" MaxWidth="590">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="11*"/>
                                    <RowDefinition Height="9*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="0" CornerRadius="5,5,5,5" Background="#FF9B8FAB" Margin="6,6,0,6">
                                    <CheckBox x:Name="CheckBoxUseOnlyCreatePageBrowser" Content="Всегда создавать новую страницу браузера при открытии ссылки" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="14" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock TextWrapping="Wrap" Text="Свойства браузера" HorizontalAlignment="Left" Padding="5,0,5,0" FontSize="20" Panel.ZIndex="1" Foreground="#FF49C3DA"  Margin="20,0,0,0" FontFamily="{DynamicResource RussianRail G Pro}"/>
        </Grid>
    </Grid>
</Page>
