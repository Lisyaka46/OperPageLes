<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI"
    x:Class="OperPageLes.UI.Pages.Settings.PageGeneralSetting"
    Title="PageGeneral">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <StackPanel>
        <Border x:Name="BorderPathImageBackground" BorderBrush="Black" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" ClipToBounds="True" Focusable="True" Height="160" Margin="5,5,5,0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="1"/>
                    <GradientStop Color="#FF7B5F5F" Offset="0.354"/>
                    <GradientStop Color="#FF225761" Offset="0.677"/>
                    <GradientStop Color="#FF00B1A6" Offset="0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Image x:Name="ImageBackground" Panel.ZIndex="-1" Opacity="0.6" IsHitTestVisible="False" Source="/UI/Images/IconMainApplication.png" VerticalAlignment="Center" Stretch="UniformToFill" >
                    <Image.OpacityMask>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterX="0.5" CenterY="0.5"/>
                                    <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="Black" Offset="0.3"/>
                            <GradientStop Offset="1"/>
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.6"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                    <Image.Effect>
                        <BlurEffect x:Name="BlurEffectImageBackground" KernelType="Box" RenderingBias="Quality" Radius="0"/>
                    </Image.Effect>
                </Image>
                <Grid>
                    <Grid.OpacityMask>
                        <RadialGradientBrush GradientOrigin="1,1" RadiusX="0.8" RadiusY="0.8" Center="0.5,0.5">
                            <GradientStop Color="Black" Offset="0.92"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.OpacityMask>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock TextWrapping="Wrap" Text="Изображение фона"  FontSize="18" Grid.RowSpan="1" TextAlignment="Center" Padding="0,0,0,10" FontFamily="{DynamicResource RussianRail G Pro}">
                        <TextBlock.Background>
                            <RadialGradientBrush GradientOrigin="0.5,-1" RadiusX="0.3" RadiusY="1" Center="0.5,0">
                                <GradientStop Offset="1"/>
                                <GradientStop Color="#CC417AA5" Offset="0"/>
                            </RadialGradientBrush>
                        </TextBlock.Background>
                    </TextBlock>
                    <Grid Grid.Row="1" Opacity="0.95">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.RowSpan="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto" MinHeight="34.73"/>
                            </Grid.RowDefinitions>
                            <Image x:Name="ImageErrorBitmapBackground" Source="/UI/Images/Warning.png" Panel.ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,10,5" StretchDirection="DownOnly"/>
                            <IEL:IELTextBox x:Name="IELTextBoxDirectoryBackground" FontSize="16"  Grid.RowSpan="1" CornerRadius="3,3,3,3" IsReadOnly="True" MaxHeight="40" Margin="50,0,50,0" Padding="0,2,0,2" FontFamily="{DynamicResource Bree CYR var}"/>
                            <TextBlock x:Name="TextBlockFailedImageSetup" TextWrapping="Wrap" Text="Не удалось установить изображение по ссылке или директории" FontSize="17" Foreground="White" FontStyle="Italic" Grid.Row="1" TextAlignment="Center" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Padding="0,2,0,2"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,5" HorizontalAlignment="Center">
                            <IEL:IELButtonText x:Name="IELButtonClearImage" Text="Убрать фон"  BorderThickness="2,2,2,2" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" MarginViewBox="5,7,5,7"/>
                            <IEL:IELButtonText x:Name="IELButtonSetTextClipboard" Text="Вставить ссылку из буфера" BorderThickness="2,2,2,2" Grid.Column="1" FontSize="14" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" Margin="10,0,10,0" MarginViewBox="5,7,5,7"/>
                            <IEL:IELButtonText x:Name="IELButtonDialogDirectoryFile" Text="Обзор"  BorderThickness="2,2,2,2" Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="14" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" VisualGuide="RightArrow" CornerRadiusGuides="7.6,7.6,7.6,7.6" MarginViewBox="5,7,5,7"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Grid.RowSpan="1" Margin="0,5,0,0">
            <Grid.RowDefinitions>
                <RowDefinition MaxHeight="50" Height="Auto"/>
                <RowDefinition x:Name="RowDefinitionBufferSize" Height="50" MaxHeight="50" MinHeight="6"/>
            </Grid.RowDefinitions>
            <Border x:Name="BorderBufferSize" BorderBrush="Black" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Background="#FF866A36" Padding="0,5,0,5" Margin="5,0,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition MinWidth="230"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Размер буфера"  FontSize="14" Padding="4,0,4,0" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource Bree CYR var}"/>
                    <Slider x:Name="SliderBufferSize" SmallChange="1" Maximum="80" Minimum="10" TickPlacement="BottomRight" TickFrequency="1" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#99FFFFFF"  IsSnapToTickEnabled="True" Value="10" Grid.Column="1" Grid.ColumnSpan="1" Margin="2,2,2,2" Grid.RowSpan="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Delay="100" IsMoveToPointEnabled="True"/>
                    <TextBlock x:Name="TextBlockSliderBufferSize" TextWrapping="Wrap" Text="00" Grid.Column="2"  FontSize="16" VerticalAlignment="Center" FontFamily="{DynamicResource Brenzo Slab Personal Use}" Padding="3,0,8,0" Width="30"/>
                </Grid>
            </Border>
            <Border x:Name="BorderSettingBufferSize" BorderBrush="Black" BorderThickness="2,0,2,2" Panel.ZIndex="-1" CornerRadius="0,0,5,5" Background="#FF772A2A" Grid.RowSpan="1" Grid.Row="1" Padding="0,2,0,2" Margin="12,0,12,0">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Настройка активируется только после перезагрузки" Foreground="White" Padding="10,0,10,0"  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontFamily="{DynamicResource Bree CYR var}"/>
                    <IEL:IELButtonText x:Name="IELButtonTextClearValue" Grid.Column="1" CornerRadius="5,5,5,5" Margin="5,3,5,3" Text="По умолчанию" Padding="8,0,8,0"  FontSize="14" FontFamily="{DynamicResource Vollda}" HeightViewBox="20"/>
                </Grid>
            </Border>
        </Grid>
        <OIEL:OPLCheckBox x:Name="CheckBoxInternetConnectionMillisecond" Text="Отображать скорость отклика интернета в миллисекундах" FontFamily="{DynamicResource Bree CYR var}" FontSize="16" CheckBoxCornerRadius="5" CornerRadius="7,7,7,7" VerticalAlignment="Stretch" Margin="5,5,5,0" IsAnimatedSettingQ="True" HorizontalAlignment="Stretch"/>
        <OIEL:OPLCheckBox x:Name="CheckBoxLoadingBorderVisualizate" Text="Визуализировать загрузку в границе окна" FontFamily="{DynamicResource Bree CYR var}" FontSize="16" CheckBoxCornerRadius="5" CornerRadius="7,7,7,7" VerticalAlignment="Stretch" Margin="5,5,5,0" IsAnimatedSettingQ="True" HorizontalAlignment="Stretch"/>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border BorderBrush="Black" BorderThickness="3,3,3,3" Grid.Row="1" Margin="6,-6,6,6" CornerRadius="5,5,5,5" VerticalAlignment="Top">
                <StackPanel>
                    <Border BorderBrush="Black" BorderThickness="2,2,2,2" Margin="5,5,5,0" CornerRadius="5,5,5,5" Background="#B26974CC" Grid.RowSpan="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ссылка по умолчанию для веб-браузера"  Padding="4,0,4,0" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" FontSize="14" FontFamily="{DynamicResource Bree CYR var}"/>
                            <IEL:IELTextBox x:Name="IELTextBoxDefaultUrl" FontSize="15" Grid.RowSpan="1" CornerRadius="3,3,3,3" MaxHeight="40" Grid.Row="1" Margin="5,5,5,5" FontFamily="{DynamicResource RussianRail G Pro}"/>
                        </Grid>
                    </Border>
                    <OIEL:OPLCheckBox x:Name="CheckBoxUsePageBrowser" Text="Использовать страницу браузера для открытия ссылок по умолчанию" FontFamily="{DynamicResource Bree CYR var}" FontSize="16" CheckBoxCornerRadius="5" CornerRadius="7,7,7,7" VerticalAlignment="Stretch" Margin="5,5,5,0" IsAnimatedSettingQ="True" HorizontalAlignment="Stretch"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Line Stroke="Black" Y2="1" Stretch="Uniform" Margin="15,2,0,2" Grid.Column="0" StrokeThickness="2" StrokeDashArray="4" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <StackPanel Grid.Column="1">
                            <OIEL:OPLCheckBox x:Name="CheckBoxUseOnlyCreatePageBrowser" Text="Всегда создавать новую страницу браузера при открытии ссылки" FontFamily="{DynamicResource Bree CYR var}" FontSize="16" CheckBoxCornerRadius="5" CornerRadius="7,7,7,7" Margin="5,5,5,5" IsAnimatedSettingQ="True" Grid.ColumnSpan="1" Grid.Column="1" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock TextWrapping="Wrap" Text="Свойства браузера" HorizontalAlignment="Left" Padding="5,0,5,0" FontSize="20" Panel.ZIndex="1" Foreground="#FF49C3DA"  Margin="20,0,0,0" FontFamily="{DynamicResource RussianRail G Pro}"/>
        </Grid>
    </StackPanel>
</Page>
