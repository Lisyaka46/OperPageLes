<Page x:Class="ApplicationOperPageLes.UI.Pages.Settings.PageConsoleSetting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.Settings"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      Title="PageConsoleSetting" Width="516">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#B23195CA" MaxWidth="600" Grid.RowSpan="1">
            <CheckBox x:Name="CheckBoxHitUse" Content="Использовать подсказки к командам" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="14" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
        </Border>
    </Grid>
</Page>
