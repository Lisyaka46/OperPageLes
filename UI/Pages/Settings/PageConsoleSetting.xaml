<Page
    x:Class="OperPageLes.UI.Pages.Settings.PageConsoleSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:OperPageLes.UI.Pages.Settings"
    mc:Ignorable="d" 
    d:DesignHeight="450"
    Title="PageConsoleSetting" Width="516">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#B231CABF" MaxWidth="600" Grid.RowSpan="1">
            <CheckBox x:Name="CheckBoxHitUse" Content="Использовать подсказки к командам" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="14" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#B247F1B7" MaxWidth="600" Grid.RowSpan="1" Grid.Row="1">
            <CheckBox x:Name="CheckBoxMovePageExecuteBufferCommand" Content="Переходить на страницу где исполняется команда из буфера" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="14" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
        </Border>
        <Grid Grid.Row="2" MaxWidth="600" Grid.RowSpan="1" Margin="0,6,0,6">
            <Grid.RowDefinitions>
                <RowDefinition MaxHeight="60" Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="BorderBufferSize" BorderBrush="Black" BorderThickness="2,2,2,2" Margin="6,6,6,0" CornerRadius="5,5,5,5" Background="#FFAD9363" Padding="0,5,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Сила прокрутки визуализаторов" FontFamily="{DynamicResource Bree CYR var}" Margin="5,0,5,0" VerticalAlignment="Center" TextTrimming="WordEllipsis" Width="120" FontSize="14" Grid.IsSharedSizeScope="True" TextAlignment="Center"/>
                    <Slider x:Name="SliderScrollForce" SmallChange="1" Maximum="12" Minimum="2" TickFrequency="1" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#99FFFFFF"  IsSnapToTickEnabled="True" Value="4" Grid.Column="1" Grid.ColumnSpan="1" Margin="2,2,2,2" Grid.RowSpan="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Delay="100" IsMoveToPointEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TextBlockSliderScrollForce" TextWrapping="Wrap" Text="000" Grid.Column="2"  FontSize="16" VerticalAlignment="Center" FontFamily="{DynamicResource Brenzo Slab Personal Use}" Padding="3,0,8,0" Width="40"/>
                </Grid>
            </Border>
            <Border x:Name="BorderSettingScrollForce" BorderBrush="Black" BorderThickness="2,0,2,2" Panel.ZIndex="-1" CornerRadius="0,0,5,5" Background="#FF982929" Grid.RowSpan="1" Grid.Row="1" Padding="0,2,0,2" Margin="12,0,12,0" VerticalAlignment="Top" Height="50">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Text="Настройка активируется только после перезагрузки" Foreground="White" FontSize="14" FontFamily="{DynamicResource Bree CYR var}" TextTrimming="WordEllipsis" Margin="5,0,5,0"/>
                    <IEL:IELButtonText x:Name="IELButtonClearScrollForceValue" Grid.Column="1" CornerRadius="5,5,5,5" Margin="5,3,5,3" Text="По умолчанию" Padding="8,0,8,0"  FontSize="14" FontFamily="{DynamicResource Vollda}" HeightViewBox="20"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
