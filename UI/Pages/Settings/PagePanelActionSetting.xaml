<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:OperPageLes.UI.Pages.Settings"
    xmlns:GUI="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
    x:Class="OperPageLes.UI.Pages.Settings.PagePanelActionSetting"
    mc:Ignorable="d" d:DesignWidth="600" MaxWidth="620"
    Title="PagePanelActionSetting">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="52*"/>
        </Grid.RowDefinitions>
        <Grid Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="2,2,2,2" BorderBrush="Black" CornerRadius="5,5,5,5" Margin="5,5,5,5">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.6,1.2" StartPoint="0.5,0.3">
                        <GradientStop Color="#FF628C76"/>
                        <GradientStop Color="#FF5E798E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="1" TextTrimming="WordEllipsis" TextWrapping="Wrap" FontSize="14" FontFamily="{DynamicResource Bree CYR var}" Padding="2,2,2,2" TextAlignment="Center">
                        <Run Text="При назначении клавиш будьте внимательны." Foreground="#FFAAFF34" TextDecorations="Underline" FontSize="16"/>
                        <LineBreak/>
                        <Run Text="Приоритет нажатия клавиши выше, чем активация действия кнопки.">
                            <Run.Foreground>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.4,-1">
                                    <GradientStop Color="#FF5BE6E3"/>
                                    <GradientStop Color="#FFA3C6FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Run.Foreground>
                        </Run>
                        <LineBreak/>
                        <Run Text="Так же чем выше по позиции стоит параметр клавиши, тем выше у него приоритет срабатывания." Foreground="#FFC8FFD3" FontSize="12" FontStyle="Italic"/>
                    </TextBlock>
                    <Grid Grid.RowSpan="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" BorderBrush="Black" Margin="5,5,5,5" Padding="5,5,5,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="1.5,1" StartPoint="-0.5,-1">
                                    <GradientStop Color="#9F9AAD7F" Offset="0"/>
                                    <GradientStop Color="#7F7FAD95" Offset="0.731"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid x:Name="GridDemo" Grid.RowSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="150"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Демонстрация панели действий" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" Margin="3,0,3,0" Padding="10,0,10,3" TextAlignment="Center"/>
                                <Border x:Name="PanelActionDemo" BorderBrush="#FF275036" Background="#FF3D755F" CornerRadius="5,5,5,5" BorderThickness="3,3,3,3" Grid.RowSpan="1" Grid.Row="1" VerticalAlignment="Center" Width="200" Height="150" HorizontalAlignment="Center">
                                    <Grid>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <GUI:IELButtonTextKey x:Name="IELButtonDemo1" BorderThickness="2,2,2,2" CornerRadius="4,4,4,4" Text="Кнопка 1" VerticalAlignment="Center" FontFamily="{DynamicResource Bree CYR var}" FontSize="16" Height="40" Margin="5,2,5,2"/>
                                            <GUI:IELButtonTextKey x:Name="IELButtonDemo2" BorderThickness="2,2,2,2" CornerRadius="4,4,4,4" Text="Кнопка 2" VerticalAlignment="Center" FontFamily="{DynamicResource Bree CYR var}" Grid.Row="1" FontSize="16" Margin="5,2,5,2" Height="40"/>
                                            <GUI:IELButtonTextKey x:Name="IELButtonDemo3" Margin="5,2,5,2" BorderThickness="2,2,2,2" CornerRadius="4,4,4,4" Text="Кнопка 3" VerticalAlignment="Center" FontFamily="{DynamicResource Bree CYR var}" Grid.Row="2" FontSize="16" Height="40"/>
                                        </Grid>
                                        <TextBlock x:Name="ViewActivateRightClick" Text="RIGHT" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="1" FontFamily="{DynamicResource RussianRail G Pro}" FontSize="14" FontWeight="Bold" Padding="5,2,5,2" Background="#FFADADAD">
                                            <TextBlock.OpacityMask>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="Black" Offset="0.621"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </RadialGradientBrush>
                                            </TextBlock.OpacityMask>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.RowSpan="1" Grid.Column="1">
                            <Border x:Name="BorderPanelActionManipulate" BorderBrush="#FF2C2C46" BorderThickness="3,3,3,3" Margin="10,10,10,10" CornerRadius="5,5,5,5" Grid.RowSpan="1">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.2,-1">
                                        <GradientStop Color="#FF35486B"/>
                                        <GradientStop Color="#FF6464B1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="0" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#FF90A797" MaxWidth="600">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="CheckBoxKeyboardMode" Content="Режим клавиатуры" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="13" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
                                            <GUI:IELButtonText x:Name="IELButtonSetKeyKeboardMode" Grid.Column="1" Margin="2,2,2,2" CornerRadius="5,5,5,5" BorderThickness="1,1,1,1" Text="-" FontFamily="{DynamicResource Bree CYR var}" Focusable="True"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" BorderThickness="3,0,0,0" BorderBrush="#FF2C2C46" Margin="15,0,0,0">
                                        <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="1" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#FF90A797" MaxWidth="600" Grid.RowSpan="1" MinWidth="240">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="CheckBoxKeyboardRightClick" Content="Правая ориентация нажатия" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="13" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" FontFamily="{DynamicResource Bree CYR var}" HorizontalAlignment="Left"/>
                                                <GUI:IELButtonText x:Name="IELButtonSetKeyKeboardRightClick" Grid.Column="1" Margin="2,2,2,2" CornerRadius="5,5,5,5" BorderThickness="1,1,1,1" Text="-" FontFamily="{DynamicResource Bree CYR var}" Focusable="True"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                    <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="2" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#FF90A797" MaxWidth="600" Grid.RowSpan="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="CheckBoxKeyboardClosePanelAction" Content="Закрыть панель действий" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="13" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
                                            <GUI:IELButtonText x:Name="IELButtonSetKeyKeboardClosePanelAction" Grid.Column="1" Margin="2,2,2,2" CornerRadius="5,5,5,5" BorderThickness="1,1,1,1" Text="-" FontFamily="{DynamicResource Bree CYR var}" Focusable="True"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="1" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#FFBF87B0" MaxWidth="600">
                <CheckBox x:Name="CheckBoxExitKeyboardMode" Content="Сбрасывать режим клавиатуры при закрытии панели действий" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="14" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
            </Border>
        </Grid>
    </Grid>
</Page>
