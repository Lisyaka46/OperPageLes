<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.Settings"
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" x:Class="ApplicationOperPageLes.UI.Pages.Settings.PagePanelActionSetting"
      mc:Ignorable="d" d:DesignWidth="600" MaxWidth="600"
      Title="PagePanelActionSetting">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Page.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="2,2,2,2" BorderBrush="Black" CornerRadius="5,5,5,5" Margin="5,5,5,5">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.6,1.2" StartPoint="0.5,0.3">
                        <GradientStop Color="#FF628C76"/>
                        <GradientStop Color="#FF5E798E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="1" TextTrimming="WordEllipsis" TextWrapping="Wrap" FontSize="14" FontFamily="{DynamicResource Bree CYR var}" Padding="2,2,2,2" TextAlignment="Center">
                        <Run Text="При назначении клавиш будьте внимательны." Foreground="#FFAAFF34" TextDecorations="Underline" FontSize="16"/>
                        <LineBreak/>
                        <Run Text="Приоритет нажатия клавиши выше, чем активация действия кнопки.">
                            <Run.Foreground>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.4,-1">
                                    <GradientStop Color="#FF5BE6E3"/>
                                    <GradientStop Color="#FFA3C6FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Run.Foreground>
                        </Run>
                        <LineBreak/>
                        <Run Text="Так же чем выше по позиции стоит параметр клавиши, тем выше у него приоритет срабатывания." Foreground="#FFC8FFD3" FontSize="12" FontStyle="Italic"/>
                    </TextBlock>
                    <Grid Grid.RowSpan="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="146*"/>
                            <ColumnDefinition Width="147*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" BorderBrush="Black" Margin="5,5,5,5" Padding="5,5,5,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="1.5,1" StartPoint="-0.5,-1">
                                    <GradientStop Color="#9F9AAD7F" Offset="0"/>
                                    <GradientStop Color="#7F7FAD95" Offset="0.731"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid x:Name="GridDemo" Grid.RowSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="150"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Демонстрация панели действий" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" Margin="3,0,3,0" Padding="10,0,10,3" TextAlignment="Center"/>
                                <Border x:Name="PanelActionDemo" BorderBrush="#FF275036" Background="#FF3D755F" CornerRadius="5,5,5,5" BorderThickness="3,3,3,3" Grid.RowSpan="1" Grid.Row="1" VerticalAlignment="Center" Width="200" Height="150" HorizontalAlignment="Center">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="ViewActivateRightClick" Text="RIGHT" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="1" FontFamily="{DynamicResource RussianRail G Pro}" FontSize="14" FontWeight="Bold" Padding="2,2,2,2"/>
                                        <GUI:IELButtonTextKey x:Name="IELButtonDemo1" Margin="10,5,10,5" BorderThickness="2,2,2,2" CornerRadius="4,4,4,4" CharKeyKeyboard="D1" Text="Кнопка 1" VerticalAlignment="Center" FontFamily="{DynamicResource Bree CYR var}" FontSize="16" Padding="15,2,15,2">
                                            <!--<GUI:IELButtonTextKey.IELSettingObject>
                                                <ObjectSettings:IELButtonObjectSetting>
                                                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                        <Classes:BrushSettingQ Default="#FF74B1A4" NotEnabled="#FFFF6565" Select="#FF45CC98" Used="#FFB7FFE9"/>
                                                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                </ObjectSettings:IELButtonObjectSetting>
                                            </GUI:IELButtonTextKey.IELSettingObject>-->
                                        </GUI:IELButtonTextKey>
                                        <GUI:IELButtonTextKey x:Name="IELButtonDemo2" BorderThickness="2,2,2,2" CornerRadius="4,4,4,4" CharKeyKeyboard="D2" Text="Кнопка 2" VerticalAlignment="Center" FontFamily="{DynamicResource Bree CYR var}" Grid.Row="1" FontSize="16" Padding="15,2,15,2" Margin="10,5,10,5">
                                            <!--<GUI:IELButtonTextKey.IELSettingObject>
                                                <ObjectSettings:IELButtonObjectSetting>
                                                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                        <Classes:BrushSettingQ Default="#FF74B1A4" NotEnabled="#FFFF6565" Select="#FF45CC98" Used="#FFB7FFE9"/>
                                                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                </ObjectSettings:IELButtonObjectSetting>
                                            </GUI:IELButtonTextKey.IELSettingObject>-->
                                        </GUI:IELButtonTextKey>
                                        <GUI:IELButtonTextKey x:Name="IELButtonDemo3" Margin="10,5,10,5" BorderThickness="2,2,2,2" CornerRadius="4,4,4,4" CharKeyKeyboard="D3" Text="Кнопка 3" VerticalAlignment="Center" FontFamily="{DynamicResource Bree CYR var}" Grid.Row="2" FontSize="16" Padding="15,2,15,2">
                                            <!--<GUI:IELButtonTextKey.IELSettingObject>
                                                <ObjectSettings:IELButtonObjectSetting>
                                                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                        <Classes:BrushSettingQ Default="#FF74B1A4" NotEnabled="#FFFF6565" Select="#FF45CC98" Used="#FFB7FFE9"/>
                                                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                </ObjectSettings:IELButtonObjectSetting>
                                            </GUI:IELButtonTextKey.IELSettingObject>-->
                                        </GUI:IELButtonTextKey>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.RowSpan="1" Grid.Column="1">
                            <Border x:Name="BorderPanelActionManipulate" BorderBrush="#FF2C2C46" BorderThickness="3,3,3,3" Margin="10,10,10,10" CornerRadius="5,5,5,5" Grid.RowSpan="1">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.2,-1">
                                        <GradientStop Color="#FF35486B"/>
                                        <GradientStop Color="#FF6464B1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="0" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#FF90A797" MaxWidth="600">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="CheckBoxKeyboardMode" Content="Режим клавиатуры" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="13" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
                                            <GUI:IELButtonText x:Name="IELButtonSetKeyKeboardMode" Grid.Column="1" Margin="2,2,2,2" CornerRadius="5,5,5,5" BorderThickness="1,1,1,1" Text="-" FontFamily="{DynamicResource Bree CYR var}" Padding="3,0,3,0" Focusable="True">
                                                <!--<GUI:IELButtonText.IELSettingObject>
                                                    <ObjectSettings:IELButtonObjectSetting>
                                                        <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                            <Classes:BrushSettingQ Default="#FF6FD08D" Select="#FF5C9C7B" Used="#FFFFEBEB" NotEnabled="#FFFF5E5E"/>
                                                        </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                    </ObjectSettings:IELButtonObjectSetting>
                                                </GUI:IELButtonText.IELSettingObject>-->
                                            </GUI:IELButtonText>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="1" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#FF90A797" MaxWidth="600" Grid.RowSpan="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="CheckBoxKeyboardRightClick" Content="Правая ориентация нажатия" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="13" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
                                            <GUI:IELButtonText x:Name="IELButtonSetKeyKeboardRightClick" Grid.Column="1" Margin="2,2,2,2" CornerRadius="5,5,5,5" BorderThickness="1,1,1,1" Text="-" FontFamily="{DynamicResource Bree CYR var}" Padding="3,0,3,0" Focusable="True">
                                                <!--<GUI:IELButtonText.IELSettingObject>
                                                    <ObjectSettings:IELButtonObjectSetting>
                                                        <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                            <Classes:BrushSettingQ Default="#FF6FD08D" Select="#FF5C9C7B" Used="#FFFFEBEB" NotEnabled="#FFFF5E5E"/>
                                                        </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                    </ObjectSettings:IELButtonObjectSetting>
                                                </GUI:IELButtonText.IELSettingObject>-->
                                            </GUI:IELButtonText>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="2" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#FF90A797" MaxWidth="600" Grid.RowSpan="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="CheckBoxKeyboardClosePanelAction" Content="Закрыть панель действий" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="13" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
                                            <GUI:IELButtonText x:Name="IELButtonSetKeyKeboardClosePanelAction" Grid.Column="1" Margin="2,2,2,2" CornerRadius="5,5,5,5" BorderThickness="1,1,1,1" Text="-" FontFamily="{DynamicResource Bree CYR var}" Padding="3,0,3,0" Focusable="True">
                                                <!--<GUI:IELButtonText.IELSettingObject>
                                                    <ObjectSettings:IELButtonObjectSetting>
                                                        <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                            <Classes:BrushSettingQ Default="#FF6FD08D" Select="#FF5C9C7B" Used="#FFFFEBEB" NotEnabled="#FFFF5E5E"/>
                                                        </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                    </ObjectSettings:IELButtonObjectSetting>
                                                </GUI:IELButtonText.IELSettingObject>-->
                                            </GUI:IELButtonText>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="1" Margin="6,6,6,6" CornerRadius="5,5,5,5" Background="#FFBF87B0" MaxWidth="600">
                <CheckBox x:Name="CheckBoxExitKeyboardMode" Content="Сбрасывать режим клавиатуры при закрытии панели действий" VerticalContentAlignment="Center" Padding="4,4,4,4" IsChecked="False" Cursor="Hand" FontSize="14" BorderBrush="Black" Background="#FF00DAD5"  Margin="4,0,0,0" HorizontalAlignment="Left" FontFamily="{DynamicResource Bree CYR var}"/>
            </Border>
        </Grid>
    </Grid>
</Page>
