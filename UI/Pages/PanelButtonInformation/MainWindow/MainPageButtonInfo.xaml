<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:local="clr-namespace:OperPage_les.UI.Pages.PanelButtonInformation.MainWindow"
      xmlns:gif="http://wpfanimatedgif.codeplex.com"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" x:Class="OperPage_les.UI.Pages.PanelButtonInformation.MainWindow.MainPageButtonInfo"
      mc:Ignorable="d" 
      d:DesignHeight="42">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml" />
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <GUI:IELBlockInfoText x:Name="IELBlockInfoCurrentLanguage" Grid.Column="2"  Text="ENG" BorderThicknessBlock="2,2,2,2" FontWeight="Bold" CornerRadius="5,5,5,5" FontSize="14" PaddingContent="6,0,6,0" Margin="3,3,3,3" FontFamily="{DynamicResource RussianRail G Pro}">
            <GUI:IELBlockInfoText.IELSettingObject>
                <ObjectSettings:IELUsingObjectSetting>
                    <ObjectSettings:IELUsingObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ Default="#FF2D563E" NotEnabled="#FFF92929" Select="#FF4F5F56" Used="White"/>
                    </ObjectSettings:IELUsingObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELUsingObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELUsingObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELUsingObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ Default="#FF65A081" NotEnabled="#FFF92929" Select="#FF86E4B2" Used="White"/>
                    </ObjectSettings:IELUsingObjectSetting.BackgroundSetting>
                </ObjectSettings:IELUsingObjectSetting>
            </GUI:IELBlockInfoText.IELSettingObject>
            <GUI:IELBlockInfoText.Effect>
                <BlurEffect Radius="0"/>
            </GUI:IELBlockInfoText.Effect>
        </GUI:IELBlockInfoText>
        <GUI:IELBlockInfoText x:Name="IELBlockInfoStateRegister" Grid.Column="1"  FontWeight="Bold" FontSize="23" CornerRadius="5,5,5,5" PaddingContent="6,0,6,0" Margin="3,3,3,3" FontFamily="{DynamicResource RussianRail G Pro}">
            <GUI:IELBlockInfoText.IELSettingObject>
                <ObjectSettings:IELUsingObjectSetting>
                    <ObjectSettings:IELUsingObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELUsingObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELUsingObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ Default="#FF314E58" NotEnabled="#FFF92929" Select="#FF505E63" Used="White"/>
                    </ObjectSettings:IELUsingObjectSetting.BorderBrushSetting>
                    <ObjectSettings:IELUsingObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ Default="#FF5C9FBB" NotEnabled="#FFF92929" Select="#FF56A6E4" Used="White"/>
                    </ObjectSettings:IELUsingObjectSetting.BackgroundSetting>
                </ObjectSettings:IELUsingObjectSetting>
            </GUI:IELBlockInfoText.IELSettingObject>
            <GUI:IELBlockInfoText.Effect>
                <BlurEffect Radius="0"/>
            </GUI:IELBlockInfoText.Effect>
        </GUI:IELBlockInfoText>
        <Grid x:Name="GridInfoInternetConnection">
            <Grid.Effect>
                <BlurEffect/>
            </Grid.Effect>
            <GUI:IELBlockInfoImage x:Name="IELBlockInfoInternetConnection" Grid.Column="0" BorderThicknessBlock="2,2,2,2" Margin="3,3,3,3" PaddingContent="3,0,4,0" ImageMargin="2,0,2,8">
                <GUI:IELBlockInfoImage.IELSettingObject>
                    <ObjectSettings:IELUsingObjectSetting>
                        <ObjectSettings:IELUsingObjectSetting.BorderBrushSetting>
                            <Classes:BrushSettingQ Default="#FF277B4B" NotEnabled="#FFF92929" Select="#FF60C88D" Used="White"/>
                        </ObjectSettings:IELUsingObjectSetting.BorderBrushSetting>
                        <ObjectSettings:IELUsingObjectSetting.BackgroundSetting>
                            <Classes:BrushSettingQ Default="#FF01A78D" NotEnabled="#FFF92929" Select="#FF49E4CB" Used="White"/>
                        </ObjectSettings:IELUsingObjectSetting.BackgroundSetting>
                    </ObjectSettings:IELUsingObjectSetting>
                </GUI:IELBlockInfoImage.IELSettingObject>
            </GUI:IELBlockInfoImage>
            <TextBlock x:Name="TextBlockInternetConnectionMillisecond" TextWrapping="Wrap" Text="???" VerticalAlignment="Bottom" TextAlignment="Center" FontSize="8" FontWeight="Bold"  Margin="5,0,5,5" IsHitTestVisible="False" FontFamily="{DynamicResource RussianRail G Pro}"/>
        </Grid>
        <MediaElement x:Name="IndicatorLoadingInternetConnection" Panel.ZIndex="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Width="28" Height="28" LoadedBehavior="Play" UnloadedBehavior="Pause">
            <MediaElement.OpacityMask>
                <RadialGradientBrush>
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                    <GradientStop Color="Black" Offset="0.908"/>
                </RadialGradientBrush>
            </MediaElement.OpacityMask>
        </MediaElement>
    </Grid>
</Page>
