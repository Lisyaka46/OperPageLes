<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:GUI="clr-namespace:IEL.UserElementsControl;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
      xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Pages.PanelButtonInformation.MainWindow"
      xmlns:gif="http://wpfanimatedgif.codeplex.com"
      xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" x:Class="ApplicationOperPageLes.UI.Pages.PanelButtonInformation.MainWindow.MainPageButtonInfo"
      mc:Ignorable="d" 
      d:DesignHeight="42">
    <Page.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml" />
    </Page.Resources>
    <Grid x:Name="GridMain">
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <GUI:IELBlockInfoText x:Name="IELBlockInfoCurrentLanguage" Grid.Column="2"  Text="???" BorderThickness="2,2,2,2" FontWeight="Bold" CornerRadius="5,5,5,5" FontSize="14" Padding="6,0,6,0" Margin="3,3,3,3" FontFamily="{DynamicResource RussianRail G Pro}" Width="55" PaletteElement="{DynamicResource Violet}">
            <GUI:IELBlockInfoText.Effect>
                <BlurEffect Radius="0"/>
            </GUI:IELBlockInfoText.Effect>
        </GUI:IELBlockInfoText>
        <GUI:IELBlockInfoText x:Name="IELBlockInfoStateRegister" Grid.Column="1"  FontWeight="Bold" FontSize="23" CornerRadius="5,5,5,5" Padding="6,0,6,0" Margin="3,3,3,3" FontFamily="{DynamicResource RussianRail G Pro}" Width="40" PaletteElement="{DynamicResource Saffron}">
            <GUI:IELBlockInfoText.Effect>
                <BlurEffect Radius="0"/>
            </GUI:IELBlockInfoText.Effect>
        </GUI:IELBlockInfoText>
        <Grid x:Name="GridInfoInternetConnection">
            <Grid.Effect>
                <BlurEffect Radius="5"/>
            </Grid.Effect>
            <GUI:IELBlockInfoImage x:Name="IELBlockInfoInternetConnection" Grid.Column="0" BorderThickness="2,2,2,2" Margin="3,3,3,3" CornerRadius="5,5,5,5" Source="/UI/Images/Wifi.png" Padding="0,0,0,5" Width="39" PaletteElement="{DynamicResource Green}"/>
            <TextBlock x:Name="TextBlockInternetConnectionMillisecond" TextWrapping="Wrap" Text="???" VerticalAlignment="Bottom" TextAlignment="Center" FontSize="8" FontWeight="Bold"  Margin="5,0,5,4" IsHitTestVisible="False" FontFamily="{DynamicResource RussianRail G Pro}"/>
        </Grid>
        <MediaElement x:Name="IndicatorLoadingInternetConnection" Panel.ZIndex="1" IsHitTestVisible="False" Width="28" Height="28" LoadedBehavior="Play" UnloadedBehavior="Pause">
            <MediaElement.OpacityMask>
                <RadialGradientBrush>
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                    <GradientStop Color="Black" Offset="0.908"/>
                </RadialGradientBrush>
            </MediaElement.OpacityMask>
        </MediaElement>
        <GUI:IELBlockInfoImage x:Name="IELBlockInfoVolume" Grid.Column="3" BorderThickness="2,2,2,2" FontWeight="Bold" CornerRadius="5,5,5,5" FontSize="14" Margin="3,3,3,3" FontFamily="{DynamicResource RussianRail G Pro}" Width="50" Cursor="Hand" PaletteElement="{DynamicResource Jade}" Source="/UI/Images/Volume.png" Padding="0,0,10,0">
            <GUI:IELBlockInfoImage.Effect>
                <BlurEffect Radius="0"/>
            </GUI:IELBlockInfoImage.Effect>
        </GUI:IELBlockInfoImage>
        <TextBlock x:Name="TextBlockVolumeValue" Grid.Column="3" Text="100" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False" FontFamily="{DynamicResource October Pro Blk}"/>
    </Grid>
</Page>
