<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:GUI="clr-namespace:IEL;assembly=IEL"
             xmlns:local="clr-namespace:OperPage_les;assembly=OperPage_les" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" x:Class="OperPage_les.UI.UserElementControl.OPLLabelCommand" 
             mc:Ignorable="d" Cursor="Hand" Width="110" Height="110">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderSelectElement" Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,-5,-5,0" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Panel.ZIndex="1" Background="#CC40FF54" BorderBrush="#CC000000">
            <Image x:Name="ImageSelect" Margin="3,3,3,3"/>
        </Border>
        <Border x:Name="BorderMainLabel" BorderThickness="2,2,2,2" Background="White" CornerRadius="6,6,6,6" BorderBrush="Black" Grid.ColumnSpan="1" Grid.RowSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Image x:Name="ImageElementLabel" Grid.RowSpan="1" Source="/UI/Images/Labels/Link.png"/>
                <TextBlock x:Name="TextBlockNameLabel" TextWrapping="Wrap" Text="12345678901234567890" FontSize="14" FontWeight="Bold" TextAlignment="Center" Foreground="Black" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="2,0,2,0"/>

            </Grid>
        </Border>
    </Grid>
</UserControl>
