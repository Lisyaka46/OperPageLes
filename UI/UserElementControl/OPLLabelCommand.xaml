<Base:IELButtonBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:Base="clr-namespace:IEL.CORE.BaseUserControls;assembly=IEL"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL"
    xmlns:local="clr-namespace:ApplicationOperPageLes;assembly=ApplicationOperPageLes"
    xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
    x:Class="ApplicationOperPageLes.UI.UserElementControl.OPLLabelCommand" 
             mc:Ignorable="d" Cursor="Hand" Width="110" Height="110" CornerRadius="5,5,5,5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderSelectElement" Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,-5,-5,0" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Panel.ZIndex="1" BorderBrush="Black">
            <Image x:Name="ImageSelect" Margin="3,3,3,3"/>
        </Border>
        <Grid Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TextBlockNameLabel" TextWrapping="Wrap" Text="12345678901234567890" FontSize="14" FontWeight="Bold" TextAlignment="Center" Foreground="Black" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="2,0,2,0"/>
            <Grid>
                <Image x:Name="ImageElementLabel" Grid.RowSpan="1" Source="/UI/Images/Labels/Link.png" Grid.ColumnSpan="2"/>
                <Image x:Name="ImageFaviconLabel" Grid.RowSpan="1" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0">
                    <Image.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="Black" Offset="0.686"/>
                            <GradientStop Color="#00000000" Offset="0.958"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>
            </Grid>
        </Grid>
    </Grid>
</Base:IELButtonBase>
