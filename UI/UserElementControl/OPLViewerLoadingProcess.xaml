<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OperPageLes.UI.UserElementControl"
             xmlns:GUI="clr-namespace:IEL.GUI;assembly=IEL" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" x:Class="OperPageLes.UI.UserElementControl.OPLViewerLoadingProcess" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Border x:Name="BorderMain" BorderBrush="Black" BorderThickness="3,3,3,3" CornerRadius="5,5,5,5" Background="#FFF3F3F3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ProgressBarLoading" Grid.ColumnSpan="3" Opacity="0.6" Value="50" Background="{x:Null}" BorderBrush="{x:Null}">
                <ProgressBar.OpacityMask>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#00000000" Offset="0.01"/>
                        <GradientStop Color="#00000000" Offset="0.99"/>
                        <GradientStop Color="Black" Offset="0.95"/>
                        <GradientStop Color="Black" Offset="0.05"/>
                    </LinearGradientBrush>
                </ProgressBar.OpacityMask>
                <ProgressBar.Foreground>
                    <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                        <GradientStop Color="Red" Offset="0.114"/>
                        <GradientStop Color="#FF10D013" Offset="1"/>
                        <GradientStop Color="#FFE0BA50" Offset="0.358"/>
                        <GradientStop Color="#FFF1D653" Offset="0.651"/>
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
            </ProgressBar>
            <TextBlock x:Name="TextBlockName" Grid.Column="0" Text="Text Loading" Padding="5,0,5,0" VerticalAlignment="Center" FontSize="16" TextTrimming="CharacterEllipsis" MaxWidth="110" TextWrapping="Wrap" HorizontalAlignment="Left"/>
            <Border x:Name="BorderIndicator" BorderBrush="#FF007D9E" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Background="#FFC37EBD" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="40" Height="40" Margin="3,3,3,3" Opacity="0.8">
                <MediaElement x:Name="IndicatorLoading" Grid.Column="5" Stretch="UniformToFill" Margin="3,3,3,3" Opacity="0.8">
                    <MediaElement.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="Black" Offset="0.709"/>
                            <GradientStop Color="#00000000" Offset="0.844"/>
                        </RadialGradientBrush>
                    </MediaElement.OpacityMask>
                </MediaElement>
            </Border>
        </Grid>
    </Border>
</UserControl>
