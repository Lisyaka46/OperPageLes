<Base:OPLWindowBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ApplicationOperPageLes.Windows"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:Base="clr-namespace:ApplicationOperPageLes.UI.Windows.Base"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
    xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=LibraryIEL"
    x:Class="ApplicationOperPageLes.Windows.WindowDiscriptionCommands"
    mc:Ignorable="d"
    Title="Описание всех команд" Height="442" Width="850" WindowStartupLocation="CenterScreen" MinWidth="720" MinHeight="420" Foreground="Black" WindowStyle="None" AllowsTransparency="True" CornerRadius="15,15,15,15">
    <Base:OPLWindowBase.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Base:OPLWindowBase.Resources>
    <Base:OPLWindowBase.Background>
        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
            <GradientStop Color="#FF347C9A"/>
            <GradientStop Color="#FFA368B1" Offset="1"/>
            <GradientStop Color="#FF5A90A7" Offset="0.667"/>
        </LinearGradientBrush>
    </Base:OPLWindowBase.Background>
    <Base:OPLWindowBase.TitleForeground>
        <LinearGradientBrush EndPoint="0.9,1" StartPoint="0.1,0.1">
            <GradientStop Color="#FF1B2438" Offset="0.638"/>
            <GradientStop Color="#FF2F4152" Offset="0"/>
        </LinearGradientBrush>
    </Base:OPLWindowBase.TitleForeground>
    <WindowChrome.WindowChrome>
        <WindowChrome  ResizeBorderThickness="5" UseAeroCaptionButtons="False" CaptionHeight="35" CornerRadius="10,10,10,10" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="277*"/>
                    <ColumnDefinition Width="563*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" BorderBrush="Black" Margin="1,3,3,3" Background="#6640F7C3" Grid.ColumnSpan="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="21*"/>
                                <RowDefinition Height="4*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="GridMainButtonsPagesInformation" Grid.RowSpan="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <IEL:IELButtonText x:Name="IELButtonConsole" Text="Консольные команды" CornerRadius="6,6,6,6" FontWeight="Bold" Margin="3,3,3,3"  BorderThickness="2,2,2,2" FontFamily="{DynamicResource RussianRail G Pro}" Grid.Column="0" Grid.RowSpan="2" PaletteElement="{DynamicResource Jade}" MarginViewBox="5,7,5,7"/>
                                <IEL:IELButtonText x:Name="IELButtonAlias" Text="Алиасы" CornerRadius="6,6,6,6" FontWeight="Bold" Grid.Column="1" Margin="3,3,3,3"  BorderThickness="2,2,2,2" FontFamily="{DynamicResource RussianRail G Pro}" Grid.RowSpan="2" PaletteElement="{DynamicResource Jade}" MarginViewBox="5,7,5,7"/>
                            </Grid>
                            <Image x:Name="ImageSelectIndicator" Grid.Row="1" Width="22" Height="22" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-9,0,-7">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform x:Name="RotateTransformImageSelectIndicator" Angle="0"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" Background="#6634C89E" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Margin="0,3,3,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <IEL:IELButtonImage x:Name="IELImageButtonClose" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Grid.Column="6" Margin="3,3,3,3" Grid.ColumnSpan="1" PaletteElement="{DynamicResource Red}" Padding="0,2,0,2" MarginViewBox="5,2,5,2" Width="44" Height="39"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="1" Grid.RowSpan="1" Grid.Row="1" Margin="10,0,0,0">
                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2,2,2,2" Margin="1,3,3,3" CornerRadius="5,5,5,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="BorderButtonsManipulateInfoPage" Grid.RowSpan="1" Margin="3,3,3,3" BorderBrush="Black" BorderThickness="1,1,1,1" CornerRadius="5,5,5,5">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="1,1" StartPoint="0.5,-1.5">
                                        <GradientStop Color="#6665D09D"/>
                                        <GradientStop Color="#664AF9A5" Offset="0.988"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Grid.RowSpan="1" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <IEL:IELButtonText x:Name="IELButtonBack" Text="Назад" CornerRadius="5,5,5,5" BorderThickness="2,2,2,2" FontFamily="{DynamicResource Bree CYR var}" FontSize="14" Margin="3,3,3,3" PaletteElement="{DynamicResource Green}"/>
                                    <IEL:IELButtonText x:Name="IELButtonCloneTextCommand" Grid.Column="1" Text="Копировать" CornerRadius="5,5,5,5" Margin="3,3,3,3"  FontSize="14" BorderThickness="2,2,2,2" FontFamily="{DynamicResource Bree CYR var}" PaletteElement="{DynamicResource LightBlue}"/>
                                    <IEL:IELButtonImage x:Name="IELButtonInfoParameter" Grid.Column="2" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,3,3,3" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" PaletteElement="{DynamicResource PastelBlue}" MarginViewBox="2,2,2,2"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="3,3,3,3" BorderThickness="1,1,1,1" CornerRadius="5,5,5,5" BorderBrush="Black" Background="#6678C3A2">
                                <IEL:IELPageController x:Name="IELControllerDescription" LeftAnimateSwitch="-15,0,15,0" RightAnimateSwitch="15,0,-15,0"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Margin="0,0,10,0">
                    <Border BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" BorderBrush="Black" Margin="3,3,1,3" Background="#668DDEC7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <IEL:IELTextBox x:Name="IELInputSearchCommand" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Margin="5,8,2,8" Grid.ColumnSpan="1" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" PaletteElement="{DynamicResource Cocoa}" Text=""/>
                            <IEL:IELButtonImage x:Name="IELButtonSearchCommand" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Grid.Column="1" VerticalAlignment="Center" MinWidth="40" MinHeight="40" HorizontalAlignment="Center" Margin="2,0,5,0" Width="40" Height="40" PaletteElement="{DynamicResource Tangerine}" MarginViewBox="3,3,3,3"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="0" Grid.RowSpan="1" Grid.Row="1" Margin="0,0,10,0">
                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="2,2,2,2" BorderBrush="Black" CornerRadius="5,5,5,5" Margin="3,3,1,3">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.7,1" StartPoint="0.3,0">
                                <GradientStop Color="#663294E0" Offset="0.994"/>
                                <GradientStop Color="#33182631" Offset="0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <IEL:IELScrollViewer x:Name="ScrollViewerElements" Background="#269BA481" VerticalScrollAligment="Left" AutoUpdateVisibleHorizontalScroll="False" ScrollForce="20">
                        </IEL:IELScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <IEL:IELBlockMessage x:Name="IELMessageInfo" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,1,0,0" OffsetLeftRight="4" OffsetUpDown="4" RadiusDefault="18" DefaultBackground="#FF7EACC5" DefaultBorderBrush="#FF091B2F" DefaultForeground="#FF00230C" FontSize="14" Grid.Row="1" FontFamily="{DynamicResource Bree CYR var}" />
    </Grid>
</Base:OPLWindowBase>