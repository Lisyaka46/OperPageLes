<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AAC20.Windows"
        xmlns:GUI="clr-namespace:IEL;assembly=IEL"
        x:Class="AAC20.Windows.WindowDiscriptionCommands"
        mc:Ignorable="d"
        Title="Описание всех команд" Height="439" Width="850" Icon="/UI/Images/LogoDC.png" WindowStartupLocation="CenterOwner" Background="#FF527562" MinWidth="720" MinHeight="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MaxHeight="40" MinHeight="30" Height="20*"/>
            <RowDefinition Height="197*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="171*"/>
                <ColumnDefinition Width="174*"/>
                <ColumnDefinition Width="253*"/>
                <ColumnDefinition Width="59*"/>
            </Grid.ColumnDefinitions>
            <GUI:IELButtonText x:Name="IELButtonConsole" FontFamily="Calibri" Text="Консольные команды" CornerRadius="6,6,6,6" FontWeight="Bold" Margin="3,0,3,0" Grid.RowSpan="1" VisibleMouseImaging="False"/>
            <GUI:IELButtonText x:Name="IELButtonSoft" FontFamily="Calibri" Text="Пользоват. команды" CornerRadius="6,6,6,6" FontWeight="Bold" Grid.Column="1" Margin="3,0,3,0" Grid.RowSpan="1" VisibleMouseImaging="False"/>
            <GUI:IELTextBox x:Name="IELInputSearchCommand" Grid.Column="2" BorderThicknessBlock="4,2,4,2" CornerRadius="6,6,6,6" Margin="3,0,0,0" Grid.RowSpan="1"/>
            <GUI:IELImageButton x:Name="IELButtonSearchCommand" Grid.Column="3" Imaging="/UI/Images/Search.png" ImageMargin="1,1,1,1" BorderThicknessBlock="3,3,3,3" Margin="7,0,7,0" Grid.RowSpan="1"/>
            <Rectangle Grid.Row="1" Margin="0,2,0,0" Grid.ColumnSpan="5">
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,-1" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#FF081D14" Offset="1"/>
                        <GradientStop Color="#FF279063"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18*" MaxWidth="190" MinWidth="140"/>
                <ColumnDefinition Width="67*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="GridMainElements" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition x:Name="ScrollColumnDefinition" Width="13" MaxWidth="13"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BorderScroll" BorderBrush="Black" BorderThickness="2,0,2,0" Grid.Column="1">
                    <Rectangle x:Name="RectangleScrollBar" Stroke="Black" VerticalAlignment="Top" Height="34" RadiusX="3" RadiusY="3" Fill="Black" HorizontalAlignment="Center" Width="7"/>
                </Border>
                <Grid x:Name="GridElements"/>
            </Grid>
            <Grid x:Name="GridMainDescription" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="29*"/>
                    <RowDefinition Height="365*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextBlockNameCommand" TextWrapping="Wrap" Text="Консольная команда: &quot;Print&quot;" FontSize="16" FontStyle="Italic" FontFamily="Cascadia Code SemiBold" TextAlignment="Center" Margin="5,2,5,2"/>
                <Grid x:Name="GridDiscription" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35*"/>
                        <RowDefinition Height="33*" MaxHeight="40" MinHeight="33"/>
                        <RowDefinition Height="297*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TextBlockDescriptionCountParameter" TextWrapping="Wrap" Text="Включает в себя 1 и более параметров" FontSize="16" VerticalAlignment="Center" Margin="5,0,5,0" FontStyle="Italic"/>
                    <Border BorderBrush="Black" BorderThickness="0,1,0,1" Grid.RowSpan="1" Grid.Row="1">
                        <Grid Margin="2,2,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500*"/>
                                <ColumnDefinition Width="33*" MinWidth="33" MaxWidth="40"/>
                                <ColumnDefinition Width="133"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TextBlockTextCommand" TextWrapping="Wrap" Text="Print* text, text2" Margin="5,0,5,0" FontSize="14" TextAlignment="Center" Grid.ColumnSpan="1" VerticalAlignment="Center" Height="19"/>
                            <GUI:IELButtonText x:Name="IELButtonCloneTextCommand" Grid.Column="2" Text="Копировать" FontFamily="Bahnschrift" CornerRadius="6,6,6,6" Margin="3,0,3,0" VisibleMouseImaging="False"/>
                            <GUI:IELImageButton x:Name="IELButtonInfoParameter" Grid.Column="1" Imaging="/UI/Images/Logo03.png" ImageMargin="2,2,2,2" BorderThicknessBlock="2,2,2,2" CornerRadius="6,6,6,6" Panel.ZIndex="2" Margin="2,0,2,0"/>
                        </Grid>
                    </Border>
                    <Border x:Name="BorderContextMenuParameter" BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="5,5,5,5" Margin="122,15,0,0" Grid.RowSpan="3" Background="#D82D8A80" Panel.ZIndex="1" Width="380" Height="155">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" Margin="0,1,0,0" TextWrapping="Wrap" Text="Символ &quot;~&quot; является пропускным символом, альтернамивой &quot; &quot;, для записи пропущенного символа в параметры нужно ввести &quot;~~&quot;" VerticalAlignment="Top" FontSize="14" Width="370"/>
                            <TextBlock HorizontalAlignment="Center" Margin="0,71,0,0" TextWrapping="Wrap" Text="Символ &quot;%&quot; является специальным символом (Одинарный символ пропускается):" VerticalAlignment="Top" FontSize="14" Width="329" TextAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Left" Margin="3,111,0,0" TextWrapping="Wrap" Text="- Для записи &quot;%&quot; в параметры нужно ввести &quot;%%&quot;" VerticalAlignment="Top" FontSize="14"/>
                            <TextBlock HorizontalAlignment="Left" Margin="3,129,0,0" TextWrapping="Wrap" Text="- Для записи &quot;,&quot; в параметры нужно ввести &quot;%,&quot;" VerticalAlignment="Top" FontSize="14"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TextBlockMainDescriptionCommand" Grid.Row="2" TextWrapping="Wrap" Text="Команда отвечает" Margin="5,5,5,5" FontSize="14" FontFamily="Lucida Fax" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
