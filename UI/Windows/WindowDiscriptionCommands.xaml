<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationOperPageLes.Windows"
        xmlns:IEL="clr-namespace:IEL.GUI;assembly=IEL"
        xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
        xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
        x:Class="ApplicationOperPageLes.Windows.WindowDiscriptionCommands"
        mc:Ignorable="d"
        Title="Описание всех команд" Height="442" Width="850" WindowStartupLocation="CenterScreen" MinWidth="720" MinHeight="30" Foreground="Black">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Window.Background>
        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
    </Window.Background>
    <Grid>
        <Border BorderThickness="5,5,5,5" CornerRadius="10,10,10,10">
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush EndPoint="0.4,-0.5" StartPoint="1.4,0">
                    <GradientStop x:Name="GradientStopBackground1" Color="#FF164952"/>
                    <GradientStop x:Name="GradientStopBackground2" Color="#FF399E97" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="297*"/>
                    <ColumnDefinition Width="547*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
                    <Border BorderThickness="2,2,2,2" CornerRadius="0,5,5,0" BorderBrush="Black" Margin="1,3,3,3" Background="#6640F7C3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="21*"/>
                                <RowDefinition Height="4*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="GridMainButtonsPagesInformation" Grid.RowSpan="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <IEL:IELButtonText x:Name="IELButtonConsole" Text="Консольные команды" CornerRadius="6,6,6,6" FontWeight="Bold" Margin="3,3,3,3"  BorderThickness="2,2,2,2" FontFamily="{DynamicResource RussianRail G Pro}" Grid.Column="0" Padding="5,0,5,0" MinWidth="175" Grid.RowSpan="2">
                                    <!--<IEL:IELButtonText.QBackground>
                                        <Classes:BrushSettingQ Default="#FFA1AF85" NotEnabled="#FFAD354B" Select="#FFD3F58E" Used="#FFF9FFED"/>
                                    </IEL:IELButtonText.QBackground>
                                    <IEL:IELButtonText.QBorderBrush>
                                        <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                                    </IEL:IELButtonText.QBorderBrush>
                                    <IEL:IELButtonText.QForeground>
                                        <Classes:BrushSettingQ Default="Black" NotEnabled="Black" Select="Black" Used="Black"/>
                                    </IEL:IELButtonText.QForeground>-->
                                </IEL:IELButtonText>
                                <IEL:IELButtonText x:Name="IELButtonAlias" Text="Алиасы" CornerRadius="6,6,6,6" FontWeight="Bold" Grid.Column="1" Margin="3,3,3,3"  BorderThickness="2,2,2,2" FontFamily="{DynamicResource RussianRail G Pro}" Padding="5,0,5,0" MinWidth="175" Grid.RowSpan="2">
                                    <!--<IEL:IELButtonText.QBackground>
                                        <Classes:BrushSettingQ Default="#FF5EC0C7" NotEnabled="#FFAD354B" Select="#FF3497C1" Used="#FF5EC7A8"/>
                                    </IEL:IELButtonText.QBackground>
                                    <IEL:IELButtonText.QBorderBrush>
                                        <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                                    </IEL:IELButtonText.QBorderBrush>
                                    <IEL:IELButtonText.QForeground>
                                        <Classes:BrushSettingQ Default="Black" NotEnabled="Black" Select="Black" Used="Black"/>
                                    </IEL:IELButtonText.QForeground>-->
                                </IEL:IELButtonText>
                            </Grid>
                            <Image x:Name="ImageSelectIndicator" Grid.Row="1" Source="/UI/Images/Arrow.png" Width="22" Height="22" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-9,0,-7">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform x:Name="RotateTransformImageSelectIndicator" Angle="0"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="1" Grid.RowSpan="1" Grid.Row="1">
                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2,2,2,2" Margin="1,3,3,3" CornerRadius="0,5,5,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="BorderButtonsManipulateInfoPage" Grid.RowSpan="1" Margin="3,3,3,3" BorderBrush="Black" BorderThickness="1,1,1,1" CornerRadius="5,5,5,5">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="1,1" StartPoint="0.5,-1.5">
                                        <GradientStop Color="#6665D09D"/>
                                        <GradientStop Color="#664AF9A5" Offset="0.988"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Grid.RowSpan="1" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <IEL:IELButtonText x:Name="IELButtonBack" Text="Назад" CornerRadius="5,5,5,5" BorderThickness="2,2,2,2" Padding="10,2,10,2" FontFamily="{DynamicResource Bree CYR var}" FontSize="14" Margin="3,3,3,3" MinWidth="100">
                                        <!--<IEL:IELButtonText.QBackground>
                                            <Classes:BrushSettingQ Default="#FF9DA1C8" NotEnabled="#FFF74141" Select="#FF93DAFF" Used="#FFFBFBFF"/>
                                        </IEL:IELButtonText.QBackground>
                                        <IEL:IELButtonText.QBorderBrush>
                                            <Classes:BrushSettingQ Default="Black" NotEnabled="Black" Select="Black" Used="Black"/>
                                        </IEL:IELButtonText.QBorderBrush>
                                        <IEL:IELButtonText.QForeground>
                                            <Classes:BrushSettingQ Default="Black" NotEnabled="Black" Select="Black" Used="Black"/>
                                        </IEL:IELButtonText.QForeground>-->
                                        <IEL:IELButtonText.IELSettingObject>
                                            <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="LeftArrow"/>
                                        </IEL:IELButtonText.IELSettingObject>
                                    </IEL:IELButtonText>
                                    <IEL:IELButtonText x:Name="IELButtonCloneTextCommand" Grid.Column="1" Text="Копировать" CornerRadius="5,5,5,5" Margin="3,3,3,3"  FontSize="16" BorderThickness="2,2,2,2" Padding="10,2,10,2" FontFamily="{DynamicResource Bree CYR var}">
                                        <!--<IEL:IELButtonText.QBackground>
                                            <Classes:BrushSettingQ Default="#FF5996CE" Select="#FF49D0FD" Used="#FF29DAB5" NotEnabled="#FFF74141"/>
                                        </IEL:IELButtonText.QBackground>
                                        <IEL:IELButtonText.QBorderBrush>
                                            <Classes:BrushSettingQ Default="Black" NotEnabled="Black" Select="Black" Used="Black"/>
                                        </IEL:IELButtonText.QBorderBrush>
                                        <IEL:IELButtonText.QForeground>
                                            <Classes:BrushSettingQ Default="Black" NotEnabled="Black" Select="Black" Used="Black"/>
                                        </IEL:IELButtonText.QForeground>-->
                                    </IEL:IELButtonText>
                                    <IEL:IELButtonImage x:Name="IELButtonInfoParameter" Grid.Column="2" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,3,3,3" Imaging="/UI/Images/LightBulb.png" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                                        <!--<IEL:IELButtonImage.QBackground>
                                            <Classes:BrushSettingQ NotEnabled="#FFDC8A8A" Select="#FF9ABAD8" Used="#FFEFF7FF" Default="#FF8595A4"/>
                                        </IEL:IELButtonImage.QBackground>-->
                                    </IEL:IELButtonImage>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="3,3,3,3" BorderThickness="1,1,1,1" CornerRadius="5,5,5,5" BorderBrush="Black" Background="#6678C3A2">
                                <IEL:IELPageController x:Name="IELControllerDescription" LeftAnimateSwitch="-15,0,15,0" RightAnimateSwitch="15,0,-15,0"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                <Grid>
                    <Border BorderThickness="2,2,2,2" CornerRadius="5,0,0,5" BorderBrush="Black" Margin="3,3,1,3" Background="#668DDEC7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <IEL:IELTextBox x:Name="IELInputSearchCommand" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Margin="3,8,3,8" Text="" Grid.ColumnSpan="1" FontSizeText="16" FontFamily="{DynamicResource Bree CYR var}">
                                <!--<IEL:IELTextBox.QBackground>
                                    <Classes:BrushSettingQ Default="#FF5AB394" NotEnabled="#FFAD354B" Select="#FF6DD4A2" Used="#FFC1EDE2"/>
                                </IEL:IELTextBox.QBackground>
                                <IEL:IELTextBox.QBorderBrush>
                                    <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                                </IEL:IELTextBox.QBorderBrush>
                                <IEL:IELTextBox.QForeground>
                                    <Classes:BrushSettingQ Default="Black" NotEnabled="Black" Select="Black" Used="Black"/>
                                </IEL:IELTextBox.QForeground>-->
                            </IEL:IELTextBox>
                            <IEL:IELButtonImage x:Name="IELButtonSearchCommand" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Grid.Column="1" VerticalAlignment="Center" MinWidth="40" MinHeight="40" HorizontalAlignment="Center" Margin="4,0,4,0" Padding="1,1,1,1" Width="45" Height="45" ImageMargin="4,4,4,4">
                                <!--<IEL:IELButtonImage.QBackground>
                                    <Classes:BrushSettingQ Default="#FF5EACC7" NotEnabled="#FFAD354B" Select="#FF59D4FF" Used="#FFD6E2E6"/>
                                </IEL:IELButtonImage.QBackground>
                                <IEL:IELButtonImage.QBorderBrush>
                                    <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                                </IEL:IELButtonImage.QBorderBrush>-->
                            </IEL:IELButtonImage>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="0" Grid.RowSpan="1" Grid.Row="1">
                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="2,2,2,2" BorderBrush="Black" CornerRadius="5,0,0,5" Margin="3,3,1,3">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.7,1" StartPoint="0.3,0">
                                <GradientStop Color="#663294E0" Offset="0.994"/>
                                <GradientStop Color="#33182631" Offset="0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ScrollViewer x:Name="ScrollViewerElements" Background="#269BA481">
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <IEL:IELBlockMessage x:Name="IELMessageInfo" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,1,0,0" OffsetLeftRight="4" OffsetUpDown="4" RadiusDefault="18" DefaultBackground="#FF7EACC5" DefaultBorderBrush="#FF091B2F" DefaultForeground="#FF00230C" FontSize="14" Grid.Row="1" FontFamily="{DynamicResource Bree CYR var}" />
    </Grid>
</Window>
