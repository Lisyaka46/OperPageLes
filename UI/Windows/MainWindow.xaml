<Window
        xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Windows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:IEL="clr-namespace:IEL.GUI;assembly=IEL"
        xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
        xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
        x:Name="window" x:Class="ApplicationOperPageLes.UI.Windows.MainWindow"
        mc:Ignorable="d"
        Title="Главное меню" WindowStartupLocation="CenterScreen" MinWidth="770" MinHeight="500" WindowStyle="None" Background="{x:Null}" AllowsTransparency="True" Icon="/UI/Images/IconMainApplication.png">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Border x:Name="BorderLeftWidth" Width="7" HorizontalAlignment="Left" Background="White" Cursor="SizeWE" Panel.ZIndex="1"></Border>
        <Border x:Name="BorderTopHeight" Height="3" VerticalAlignment="Top" Background="White" Panel.ZIndex="1"></Border>
        <Border x:Name="BorderRightWidth" Width="3" HorizontalAlignment="Right" Background="White" Cursor="SizeWE" Panel.ZIndex="1"/>
        <Border x:Name="BorderDownHeight" Height="3" VerticalAlignment="Bottom" Background="White" Panel.ZIndex="1"></Border>
        <Border Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Lime" Panel.ZIndex="1"></Border>
        <Border Width="3" Height="3" Background="Lime" VerticalAlignment="Top" HorizontalAlignment="Right" Panel.ZIndex="1"></Border>
        <Border Width="3" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="Lime" Panel.ZIndex="2"></Border>
        <Border Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Lime" Panel.ZIndex="1"></Border>
        <Border x:Name="BorderWindowMain" CornerRadius="40,40,40,40" Background="Black">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image HorizontalAlignment="Left" VerticalAlignment="Top" Source="{Binding Icon, ElementName=window}" Width="20" Height="20" Margin="25,0,1,0" IsHitTestVisible="False" Grid.ColumnSpan="1"/>
                <TextBlock Text="{Binding Title, ElementName=window}" FontFamily="{DynamicResource RussianRail G Pro}" Grid.ColumnSpan="1" Grid.Column="1" VerticalAlignment="Top" Margin="1,0,0,0" FontSize="16">
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <GradientStop Color="#FF1300FF"/>
                            <GradientStop Color="Red" Offset="0.5"/>
                            <GradientStop Color="#FF71D400" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </Grid>
        </Border>
        <Border x:Name="BorderWindowMainContent" BorderBrush="#FFF0F0F0" Background="#FF21888A" CornerRadius="15,15,15,15" Margin="20,20,20,20">
            <Border x:Name="BorderColorMain" CornerRadius="13,13,13,13">
                <Border.Background>
                    <ImageBrush x:Name="ImageMenu" Opacity="1" Stretch="UniformToFill"/>
                </Border.Background>
                <Grid x:Name="GridMain" RenderTransformOrigin="0.5,0.5">
                    <IEL:IELPanelAction x:Name="IELActionPanelMain" HorizontalAlignment="Left" Margin="124,84,0,0" VerticalAlignment="Top" Panel.ZIndex="2" Background="{DynamicResource BG_Cocoa}" BorderBrush="{DynamicResource BB_Cocoa}" Foreground="{DynamicResource FG_Cocoa}" CornerRadius="3,3,3,3"/>
                    <Grid Panel.ZIndex="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="53"/>
                            <RowDefinition/>
                            <RowDefinition Height="56"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0,0,0,2" BorderBrush="Black">
                            <Border x:Name="BorderButtonsUp" BorderBrush="#FF35755F" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="4,2,4,2" Grid.RowSpan="1" Focusable="True">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.47,-2.5">
                                        <GradientStop Color="#CC78A08C" Offset="0.99"/>
                                        <GradientStop Color="#D80082AD" Offset="0.129"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.FocusVisualStyle>
                                    <Style>
                                        <Setter Property="Control.Template" Value="{x:Null}"/>
                                    </Style>
                                </Border.FocusVisualStyle>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="50"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto" MinWidth="50"/>
                                        <ColumnDefinition Width="Auto" MinWidth="50"/>
                                        <ColumnDefinition Width="Auto" MinWidth="50"/>
                                    </Grid.ColumnDefinitions>
                                    <IEL:IELButtonImage x:Name="IELImageButtonHelp" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Grid.Column="3" Margin="3,3,3,3" Grid.ColumnSpan="1" Background="{StaticResource BG_Jade}" BorderBrush="{StaticResource BB_Jade}" Foreground="{StaticResource FG_Jade}"/>
                                    <IEL:IELButtonImage x:Name="IELButtonSettings" Grid.ColumnSpan="1" Grid.Column="4" CornerRadius="6,6,6,6" Padding="2,2,2,2" Margin="3,3,3,3" Background="{DynamicResource BG_Purple}" BorderBrush="{DynamicResource BB_Purple}" Foreground="{DynamicResource FG_Purple}"/>
                                    <IEL:IELButtonImage x:Name="ImageLogoApplication" CornerRadius="6,6,6,6" Background="{DynamicResource BG_Lime}" BorderBrush="{DynamicResource BB_Lime}" Foreground="{DynamicResource FG_Red}"/>
                                    <IEL:IELButtonImage x:Name="IELImageButtonClose" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Grid.Column="2" Margin="3,3,3,3" Grid.ColumnSpan="1" Background="{StaticResource BG_Red}" BorderBrush="{StaticResource BB_Red}" Foreground="{StaticResource FG_Red}"/>
                                </Grid>
                            </Border>
                        </Border>
                        <Border Grid.Row="2" BorderThickness="0,3,0,0" BorderBrush="Black" VerticalAlignment="Center">
                            <Grid Margin="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="53"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BorderImageInformation" BorderBrush="#FF29B1C3" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="4,4,4,4" Background="#D8C2DFD4" Grid.ColumnSpan="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <IEL:IELButtonImage x:Name="IELImageButtonMenu" CornerRadius="5,5,5,5" Margin="3,3,3,3" Background="{StaticResource BG_PastelBlue}" BorderBrush="{StaticResource BB_PastelBlue}" Foreground="{StaticResource FG_PastelBlue}"/>
                                        <IEL:IELButtonText x:Name="IELImageButtonBackButtons" Grid.Column="1" Margin="3,3,3,3" Text="&lt;" FontSize="25" FontWeight="Bold" FontFamily="{DynamicResource October Pro Blk}" Background="{StaticResource BG_Tangerine}" BorderBrush="{StaticResource BB_Tangerine}" Foreground="{StaticResource FG_Tangerine}" CornerRadius="5,5,5,5" Padding="6,5,6,0"/>
                                        <Grid Grid.Column="2">
                                            <IEL:IELPageController x:Name="IELPageControllerButtons" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Grid>
                                        <IEL:IELButtonText x:Name="IELImageButtonNextButtons" Grid.Column="3" Margin="3,3,3,3" CornerRadius="5,5,5,5" Text="&gt;" FontSize="25" FontWeight="Bold" FontFamily="{DynamicResource October Pro Blk}" Background="{StaticResource BG_Tangerine}" BorderBrush="{StaticResource BB_Tangerine}" Foreground="{StaticResource FG_Tangerine}" Padding="6,5,6,0"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="BorderDateTime" BorderBrush="#FF528A86" BorderThickness="2,2,2,2" Margin="4,4,4,4" CornerRadius="10,10,10,10" Grid.ColumnSpan="1" Grid.Column="1" HorizontalAlignment="Right">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="0.5,2" StartPoint="0.3,-2">
                                            <GradientStop Color="#FFCDFFEC" Offset="0.22"/>
                                            <GradientStop Color="#FF85A8E2" Offset="0.938"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid MinWidth="120">
                                        <TextBlock x:Name="TextBlockTime" TextWrapping="Wrap" Text="00:00:00" FontSize="14"  FontWeight="Bold" FontFamily="{DynamicResource RussianRail G Pro}" Grid.RowSpan="1" HorizontalAlignment="Left" Padding="3,0,3,0" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="TextBlockData" TextWrapping="Wrap" Text="00.00.0000" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}" Grid.Row="1" Padding="3,0,3,0" VerticalAlignment="Bottom" Margin="0,0,0,3" FontWeight="Bold" />
                                    </Grid>
                                </Border>
                                <Border x:Name="BorderIndicator" BorderBrush="#FF007D9E" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="4,4,4,4" Background="#FFC37EBD" Grid.Column="2">
                                    <Grid>
                                        <Border x:Name="BorderNotificationIndicator" BorderThickness="2,2,2,2" BorderBrush="#FF007D9E" Background="#FFFBC4F6" CornerRadius="5,5,5,5" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False"/>
                                        <MediaElement x:Name="IndicatorLoading" Grid.Column="5" Stretch="UniformToFill" Margin="2,2,2,2" Source="/UI/Images/Media/Loading/LoadingDefault.mp4" IsHitTestVisible="False">
                                            <MediaElement.OpacityMask>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="Black" Offset="0.709"/>
                                                    <GradientStop Color="#00000000" Offset="0.844"/>
                                                </RadialGradientBrush>
                                            </MediaElement.OpacityMask>
                                        </MediaElement>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Panel.ZIndex="1" Width="350">
                            <Frame x:Name="FrameNewInlayBrowser"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.Effect>
                                <BlurEffect x:Name="IELBrowserPageBlurEffect" Radius="0"/>
                            </Grid.Effect>
                            <IEL:IELBrowserPage x:Name="IELBrowserPageMain" Grid.Row="1" FontFamily="{DynamicResource RussianRail G Pro}" FontSize="16" FontStyle="Italic" Background="{DynamicResource BG_Olive}" BorderBrush="{DynamicResource BB_Olive}" Foreground="{DynamicResource FG_Olive}">
                                <IEL:IELBrowserPage.IELButtonAddInlay>
                                    <IEL:IELButtonImage HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Background="{DynamicResource BG_PastelBlue}" BorderBrush="{DynamicResource BB_PastelBlue}" Foreground="{DynamicResource FG_PastelBlue}"/>
                                </IEL:IELBrowserPage.IELButtonAddInlay>
                            </IEL:IELBrowserPage>
                        </Grid>
                    </Grid>
                    <IEL:IELBlockMessage x:Name="IELMessageMain" Grid.Column="0" HorizontalAlignment="Left" Margin="219,82,0,0" Grid.Row="0" VerticalAlignment="Top" Text="Отображаемый текст" OffsetUpDown="6" Panel.ZIndex="2" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" OffsetLeftRight="6" FontFamily="{DynamicResource Deledda Open Regular}" DefaultBackground="#FFC5FBE4" FontSize="14" RadiusDefault="15" RadiusMagnite="2"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
