<Window
        xmlns:local="clr-namespace:AAC20.UI.Windows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:GUI="clr-namespace:IEL;assembly=IEL"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:Classes="clr-namespace:IEL.Classes;assembly=IEL"
        x:Name="window" x:Class="AAC20.UI.Windows.MainWindow"
        mc:Ignorable="d"
        Title="Главное меню" WindowStartupLocation="CenterScreen" FontFamily="Arial" FontSize="14" FontWeight="Bold" Background="#FF33615E" MinWidth="770" MinHeight="500" Icon="/UI/Images/Logo02.png" Width="800" Height="600" RenderTransformOrigin="0.5,0.5">
    <Grid x:Name="GridMain" RenderTransformOrigin="0.5,0.5">
        <GUI:IELPanelAction x:Name="IELActionPanelMain" HorizontalAlignment="Left" Margin="124,84,0,0" VerticalAlignment="Top" Panel.ZIndex="2"/>
        <Image x:Name="ImageMenu" Panel.ZIndex="1" Stretch="UniformToFill">
            <Image.Effect>
                <BlurEffect x:Name="BlurEffectImageMenu" Radius="0" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>
        <Grid Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="455*"/>
                <ColumnDefinition Width="209*" MaxWidth="230"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40*" MinHeight="40" MaxHeight="50"/>
                <RowDefinition Height="451*"/>
                <RowDefinition Height="53"/>
                <RowDefinition Height="40*" MaxHeight="52" MinHeight="40"/>
            </Grid.RowDefinitions>
            <Border x:Name="BorderButtonsUp" BorderBrush="#FF386951" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="2,2,2,2" Grid.ColumnSpan="2" Grid.RowSpan="1" Focusable="True">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.498,-0.5">
                        <GradientStop Color="#CC386951" Offset="0.99"/>
                        <GradientStop Color="#D8537E8C" Offset="0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template" Value="{x:Null}"/>
                    </Style>
                </Border.FocusVisualStyle>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="37"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1" Margin="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="163*"/>
                            <ColumnDefinition Width="329*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <GUI:IELImageButton x:Name="IELButtonSettings" Imaging="/UI/Images/Settings.png" Grid.ColumnSpan="1" Grid.Column="2" ImageMargin="2,2,2,2" AnimationMillisecond="140" Margin="3,1,0,1" BorderThicknessBlock="2,2,2,2">
                            <GUI:IELImageButton.ForegroundSetting>
                                <Classes:BrushSettingQ Default="#FF1F262F" NotEnabled="#FF5F1717" Select="#FF232F31" Used="#FF093831"/>
                            </GUI:IELImageButton.ForegroundSetting>
                            <GUI:IELImageButton.BorderBrushSetting>
                                <Classes:BrushSettingQ Default="#FF3D4848" NotEnabled="#FFD24B64" Select="#FF475B5B" Used="#FF0E5B5B"/>
                            </GUI:IELImageButton.BorderBrushSetting>
                            <GUI:IELImageButton.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FF50A79D" Select="#FF46C5B6" NotEnabled="#FFC13750" Used="White"/>
                            </GUI:IELImageButton.BackgroundSetting>
                        </GUI:IELImageButton>
                        <GUI:IELButtonText x:Name="IELButtonLabel" RenderTransformOrigin="0,0" Text="Ярлыки" FontWeight="Bold" FontFamily="Trebuchet MS" Margin="3,1,3,1" AnimationMillisecond="140" VisibleMouseImaging="False" BorderThicknessBlock="2,2,2,2">
                            <GUI:IELButtonText.ForegroundSetting>
                                <Classes:BrushSettingQ Default="#FF1F262F" NotEnabled="#FF5F1717" Select="#FF232F31" Used="#FF093831"/>
                            </GUI:IELButtonText.ForegroundSetting>
                            <GUI:IELButtonText.BorderBrushSetting>
                                <Classes:BrushSettingQ Default="#FF3D4848" NotEnabled="#FFD24B64" Select="#FF475B5B" Used="#FF0E5B5B"/>
                            </GUI:IELButtonText.BorderBrushSetting>
                            <GUI:IELButtonText.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FF50A79D" Select="#FF46C5B6" NotEnabled="#FFC13750" Used="White"/>
                            </GUI:IELButtonText.BackgroundSetting>
                        </GUI:IELButtonText>
                    </Grid>
                    <GUI:IELImageButton x:Name="ImageLogoApplication" Imaging="/UI/Images/Logo02.png" CornerRadius="6,6,6,6" AnimationMillisecond="250" BorderThickness="0.1,0.1,0.1,0.1">
                        <GUI:IELImageButton.BorderBrushSetting>
                            <Classes:BrushSettingQ Default="#00000000" NotEnabled="#00000000" Select="#00000000" Used="#00000000"/>
                        </GUI:IELImageButton.BorderBrushSetting>
                        <GUI:IELImageButton.BackgroundSetting>
                            <Classes:BrushSettingQ Default="#00000000" NotEnabled="#FFA55B5B" Select="#7F457560" Used="#9950A79D"/>
                        </GUI:IELImageButton.BackgroundSetting>
                    </GUI:IELImageButton>
                </Grid>
            </Border>
            <Grid Grid.Column="2" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="89*"/>
                    <ColumnDefinition Width="45*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ImageIndificator" gif:ImageBehavior.AnimatedSource="/UI/Images/Loading.gif" Margin="9,7,9,7" Grid.Column="1"/>
                <GUI:IELButtonText x:Name="ButtonReturnCommand" FontFamily="Trebuchet MS" Text="Выполнить" Margin="2,4,2,5" CornerRadius="10,10,10,10" Grid.ColumnSpan="1" VisibleMouseImaging="False" AnimationMillisecond="160" BorderThicknessBlock="3,3,3,3">
                    <GUI:IELButtonText.BackgroundSetting>
                        <Classes:BrushSettingQ Default="#FF55C7A5" NotEnabled="#FFCE4867" Select="#FF47F9C4" Used="White"/>
                    </GUI:IELButtonText.BackgroundSetting>
                </GUI:IELButtonText>
            </Grid>
            <Grid x:Name="GridMainComponents" Grid.Row="1" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition x:Name="BrowserPageColumn" Width="420" MaxWidth="420" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BorderConsole" BorderBrush="#FF315842" BorderThickness="3,3,3,3" Grid.ColumnSpan="1" Margin="2,2,2,2" Panel.ZIndex="1">
                    <Grid x:Name="GridConsole">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <RichTextBox x:Name="RichTextBoxMainMessage" Background="#CC4A7B60" SelectionBrush="#FF115236" BorderThickness="0,0,0,0" FontSize="14" MinWidth="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsReadOnly="True" FontWeight="Normal" Focusable="False" Cursor="Cross" VerticalScrollBarVisibility="Auto" Panel.ZIndex="1" BorderBrush="{x:Null}"/>
                    </Grid>
                </Border>
                <Border x:Name="BorderFrameComponent" BorderBrush="#FF5F5F5F" BorderThickness="2,2,2,2" Grid.Column="1" Background="#CC4A7B7A" Panel.ZIndex="0" MinWidth="220" Margin="2,2,2,2">
                    <Grid x:Name="GridFrameComponent">
                        <GUI:IELBrowserPage x:Name="IELBrowserPageMain">
                            <GUI:IELBrowserPage.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#CC4A7B60" NotEnabled="#CCEC5656" Select="#CC63A07E" Used="#CC47E08B"/>
                            </GUI:IELBrowserPage.BackgroundSetting>
                        </GUI:IELBrowserPage>

                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TimeDataColumnDefinition" Width="124" MaxWidth="124"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BorderImageInformation" BorderBrush="#FF315842" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="3,3,3,3" Background="#CC4A7B60" Grid.Column="1" Grid.ColumnSpan="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="43"/>
                            <ColumnDefinition Width="43"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="43"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="43"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BorderInternetConnection" BorderBrush="#FF085D2D" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Padding="3,3,3,3" Background="#FF5CBBAC" Margin="3,3,3,3" Cursor="Help">
                            <Image x:Name="ImageInternetConnection" RenderTransformOrigin="0.5,0.5" Source="/UI/Images/WifiOff.png" Margin="-2,0,0,0">
                                <Image.Effect>
                                    <BlurEffect x:Name="BlurEffectImageInternetConnection" Radius="0" KernelType="Box" RenderingBias="Quality"/>
                                </Image.Effect>
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                        <SkewTransform AngleY="0"/>
                                        <RotateTransform Angle="0"/>
                                        <TranslateTransform Y="0" X="0"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                        </Border>
                        <GUI:IELImageButton x:Name="IELButtonBrowserPageVisible" Grid.Column="5" Margin="3,3,3,3" CornerRadius="100,100,100,100" Imaging="/UI/Images/Arrow.png" RenderTransformOrigin="0.5,0.5" AnimationMillisecond="140" IntervalHover="1000" BorderThicknessBlock="2,2,2,2">
                            <GUI:IELImageButton.BorderBrushSetting>
                                <Classes:BrushSettingQ Default="Black" NotEnabled="#FF400817" Select="#FF151729" Used="#FF173128"/>
                            </GUI:IELImageButton.BorderBrushSetting>
                            <GUI:IELImageButton.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FF3EBAD2" NotEnabled="#FFE24267" Select="#FF26DEDA" Used="White"/>
                            </GUI:IELImageButton.BackgroundSetting>
                        </GUI:IELImageButton>
                        <Border x:Name="BorderStateRegister" BorderBrush="#FF314E58" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Background="#FF5C9FBB" Margin="3,3,3,3" Grid.Column="1" Cursor="Help">
                            <TextBlock x:Name="TextBlockRegister" TextWrapping="Wrap" Text="А" TextAlignment="Center" VerticalAlignment="Center" FontSize="23" Style="{Binding Mode=OneWay, Source={StaticResource RussianRail G Pro}}" FontWeight="Bold">
                                <TextBlock.Effect>
                                    <BlurEffect x:Name="BlurEffectTextBlockRegister" Radius="0" KernelType="Box" RenderingBias="Quality"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                        <Border x:Name="BorderCurrentLanguage" BorderBrush="#FF2D563E" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Background="#FF65A081" Margin="3,3,3,3" Grid.Column="2" Cursor="Help">
                            <TextBlock x:Name="TextBlockLanguage" TextWrapping="Wrap" Text="ENG" TextAlignment="Center" VerticalAlignment="Center" Style="{Binding Mode=OneWay, Source={StaticResource RussianRail G Pro}}" FontWeight="Bold">
                                <TextBlock.Effect>
                                    <BlurEffect x:Name="BlurEffectLanguage" RenderingBias="Quality" Radius="0" KernelType="Box"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                        <GUI:IELImageButton x:Name="IELImageButtonHelp" Grid.Column="3" Margin="3,3,3,3" CornerRadius="5,5,5,5" Imaging="/UI/Images/LightBulb.png" ImageMargin="1,1,1,1" BorderThicknessBlock="2,2,2,2">
                            <GUI:IELImageButton.BorderBrushSetting>
                                <Classes:BrushSettingQ Default="#FF697535" NotEnabled="#FFC15555" Select="#FF879451" Used="#FF99A954" UsedState="False"/>
                            </GUI:IELImageButton.BorderBrushSetting>
                            <GUI:IELImageButton.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FF9EAD84" NotEnabled="#FFC15E5E" Select="#FFA6C179" Used="#FFD4F797" UsedState="False"/>
                            </GUI:IELImageButton.BackgroundSetting>
                        </GUI:IELImageButton>
                    </Grid>
                </Border>
                <Border x:Name="BorderDateTime" BorderBrush="#FF315842" BorderThickness="2,2,2,2" Margin="3,3,3,3" CornerRadius="10,10,10,10" Background="#CC94ADC5" Grid.ColumnSpan="1">
                    <Grid MinWidth="114">
                        <TextBlock x:Name="TextBlockTime" TextWrapping="Wrap" Text="00:00:00" FontSize="16" FontFamily="Cascadia Code" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,2,0,0"/>
                        <TextBlock x:Name="TextBlockData" TextWrapping="Wrap" Text="00.00.0000" FontFamily="Cascadia Code" FontSize="16" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,0,0,2"/>
                    </Grid>
                </Border>
            </Grid>
            <GUI:IELTextBox x:Name="TextBoxCommandInput" CornerRadius="4,4,4,4" Grid.Column="0" Grid.Row="3" Margin="3,3,3,3" MinWidth="100" BorderThicknessBlock="3,3,3,3" Grid.ColumnSpan="2" ForgroundNaming="#FF11FF81" Panel.ZIndex="1" Text=""/>
            <GUI:IELButtonText x:Name="ButtonReboot" Text="Перезапустить" CornerRadius="10,10,10,10" Margin="8,2,7,3" Grid.Column="2" FontWeight="Bold" FontFamily="Trebuchet MS" VisibleMouseImaging="False" BorderThicknessBlock="3,3,3,3">
                <GUI:IELButtonText.BorderBrushSetting>
                    <Classes:BrushSettingQ Default="#FF103823" NotEnabled="#FF502727" Select="#FF2D3C21" Used="#FF2F2D2D"/>
                </GUI:IELButtonText.BorderBrushSetting>
                <GUI:IELButtonText.BackgroundSetting>
                    <Classes:BrushSettingQ Default="#FF79BF61" NotEnabled="#FFE0496C" Select="#FF93EC75" Used="#FFF2FFE8"/>
                </GUI:IELButtonText.BackgroundSetting>
            </GUI:IELButtonText>
            <Border x:Name="BorderHintCommand" BorderThickness="2,2,2,2" Grid.Row="1" Panel.ZIndex="0" Margin="3,0,0,37" Grid.RowSpan="3" CornerRadius="4,4,0,4" Height="70" VerticalAlignment="Bottom" Width="142" Grid.ColumnSpan="2" HorizontalAlignment="Left" Padding="0,5,0,0">
                <Border.BorderBrush>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#008FA260" Offset="0.06"/>
                        <GradientStop Color="#FF8FA065" Offset="0.15"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#008FA260" Offset="0.03"/>
                        <GradientStop Color="#FF8FA065" Offset="0.15"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid x:Name="GridHint"/>
                    <Grid x:Name="GridHintCommandParameter" Panel.ZIndex="1" Margin="2,2,2,2">
                        <TextBlock x:Name="TextBlockHintCommand" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Close" VerticalAlignment="Top" Margin="2,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <GUI:IELBlockMessage x:Name="IELMessageMain" Grid.Column="0" HorizontalAlignment="Left" Margin="219,82,0,0" Grid.Row="0" VerticalAlignment="Top" RadiusMagnite="2" Text="Hello" OffsetUpDown="6" Panel.ZIndex="2" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" RadiusDefault="15" OffsetLeftRight="6" FontFamily="Trebuchet MS"/>
    </Grid>
</Window>
