<Window
        xmlns:local="clr-namespace:OperPage_les.UI.Windows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:GUI="clr-namespace:IEL;assembly=IEL"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
        xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
        xmlns:resx="clr-namespace:OperPage_les.Properties"
        x:Name="window" x:Class="OperPage_les.UI.Windows.MainWindow"
        mc:Ignorable="d"
        Title="Главное меню" WindowStartupLocation="CenterScreen" FontFamily="Arial" FontSize="14" FontWeight="Bold" Background="#FF33615E" MinWidth="770" MinHeight="500" Width="800" Height="600" RenderTransformOrigin="0.5,0.5">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/FontsDictionary.xaml"/>
    </Window.Resources>
    <Grid x:Name="GridMain" RenderTransformOrigin="0.5,0.5">
        <GUI:IELPanelAction x:Name="IELActionPanelMain" HorizontalAlignment="Left" Margin="124,84,0,0" VerticalAlignment="Top" Panel.ZIndex="2"/>
        <Image x:Name="ImageMenu" Panel.ZIndex="1" Stretch="UniformToFill">
            <Image.Effect>
                <BlurEffect x:Name="BlurEffectImageMenu" Radius="0" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>
        <Grid Panel.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="53"/>
                <RowDefinition/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>
            <Border x:Name="BorderButtonsUp" BorderBrush="#FF35755F" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="2,2,2,2" Grid.RowSpan="1" Focusable="True">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.47,-2.5">
                        <GradientStop Color="#CC78A08C" Offset="0.99"/>
                        <GradientStop Color="#D80082AD" Offset="0.129"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template" Value="{x:Null}"/>
                    </Style>
                </Border.FocusVisualStyle>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="50"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto" MinWidth="50"/>
                        <ColumnDefinition Width="Auto" MinWidth="50"/>
                    </Grid.ColumnDefinitions>
                    <GUI:IELButtonImage x:Name="IELImageButtonHelp" CornerRadius="6,6,6,6" ImageMargin="1,1,1,1" BorderThicknessBlock="2,2,2,2" Grid.Column="2" Margin="3,3,3,3" Grid.ColumnSpan="1">
                        <GUI:IELButtonImage.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ Default="#FF697535" NotEnabled="#FFC15555" Select="#FF879451" Used="#FF99A954"/>
                                </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#FF9EAD84" NotEnabled="#FFC15E5E" Select="#FFA6C179" Used="#FFD4F797"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </GUI:IELButtonImage.IELSettingObject>
                    </GUI:IELButtonImage>
                    <GUI:IELButtonImage x:Name="IELButtonSettings" Grid.ColumnSpan="1" Grid.Column="3" CornerRadius="6,6,6,6" PaddingContent="2,2,2,2" Margin="3,3,3,3">
                        <GUI:IELButtonImage.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ Default="#00000000" NotEnabled="#00000000" Select="#00000000" Used="#00000000"/>
                                </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#00000000" Select="#99266FA7" NotEnabled="#CCC13750" Used="#A52891E2"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </GUI:IELButtonImage.IELSettingObject>
                    </GUI:IELButtonImage>
                    <GUI:IELButtonImage x:Name="ImageLogoApplication" CornerRadius="6,6,6,6" ImageMargin="2,2,2,2">
                        <GUI:IELButtonImage.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ Default="#00000000" NotEnabled="#00000000" Select="#00000000" Used="#00000000"/>
                                </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#00000000" NotEnabled="#FFA55B5B" Select="#7F457560" Used="#9950A79D"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </GUI:IELButtonImage.IELSettingObject>
                    </GUI:IELButtonImage>
                </Grid>
            </Border>
            <Border Grid.Row="2" BorderThickness="0,3,0,0" BorderBrush="Black" VerticalAlignment="Center">
                <Grid Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition x:Name="TimeDataColumnDefinition" Width="121" MaxWidth="124"/>
                        <ColumnDefinition Width="53"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Border x:Name="BorderImageInformation" BorderBrush="#FF29B1C3" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="3,3,3,3" Background="#D8C2DFD4" Grid.ColumnSpan="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <GUI:IELButtonImage x:Name="IELImageButtonMenu" CornerRadius="5,5,5,5" ImageMargin="6,6,6,6" BorderThicknessBlock="2,2,2,2" Margin="3,3,3,3">
                                    <GUI:IELButtonImage.IELSettingObject>
                                        <ObjectSettings:IELButtonObjectSetting>
                                            <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                                <Classes:BrushSettingQ Default="#FF25546D" NotEnabled="#FFC15555" Select="#FF446B80" Used="#FF4B768C"/>
                                            </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                            <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                <Classes:BrushSettingQ Default="#FF0AA5C3" NotEnabled="#FFC15E5E" Select="#FF44BFF3" Used="#FF83E6F9"/>
                                            </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                        </ObjectSettings:IELButtonObjectSetting>
                                    </GUI:IELButtonImage.IELSettingObject>
                                </GUI:IELButtonImage>
                                <GUI:IELButtonText x:Name="IELImageButtonBackButtons" Grid.Column="1" Margin="3,3,3,3" CornerRadius="5,5,5,5" Text="&lt;" FontSize="30"  FontWeight="Bold" BorderThicknessBlock="2,2,2,2" PaddingContent="4,0,5,6" FontFamily="{DynamicResource RussianRail G Pro}">
                                    <GUI:IELButtonText.IELSettingObject>
                                        <ObjectSettings:IELButtonObjectSetting>
                                            <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                                <Classes:BrushSettingQ NotEnabled="#FFFF4354" Select="Black" Used="Black"/>
                                            </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                            <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                <Classes:BrushSettingQ Default="#00000000" NotEnabled="#66FF0101" Select="#33000000" Used="#66005B38"/>
                                            </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                        </ObjectSettings:IELButtonObjectSetting>
                                    </GUI:IELButtonText.IELSettingObject>
                                </GUI:IELButtonText>
                                <Grid Grid.Column="2">
                                    <GUI:IELPageController x:Name="IELPageControllerButtons" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                                <GUI:IELButtonText x:Name="IELImageButtonNextButtons" Grid.Column="3" Margin="3,3,3,3" CornerRadius="5,5,5,5" Text="&gt;" FontSize="30"  FontWeight="Bold" PaddingContent="5,0,4,6" BorderThicknessBlock="2,2,2,2" FontFamily="{DynamicResource RussianRail G Pro}">
                                    <GUI:IELButtonText.IELSettingObject>
                                        <ObjectSettings:IELButtonObjectSetting>
                                            <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                                <Classes:BrushSettingQ NotEnabled="#FFFF4354" Select="Black" Used="Black"/>
                                            </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                            <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                                <Classes:BrushSettingQ Default="#00000000" NotEnabled="#66FF0101" Select="#33000000" Used="#66005B38"/>
                                            </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                        </ObjectSettings:IELButtonObjectSetting>
                                    </GUI:IELButtonText.IELSettingObject>
                                </GUI:IELButtonText>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border x:Name="BorderDateTime" BorderBrush="#FF528A86" BorderThickness="2,2,2,2" Margin="3,3,3,3" CornerRadius="10,10,10,10" Grid.ColumnSpan="1" Grid.Column="1">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,2" StartPoint="0.3,-2">
                                <GradientStop Color="#FFCDFFEC" Offset="0.22"/>
                                <GradientStop Color="#FF85A8E2" Offset="0.938"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid MinWidth="114">
                            <Grid>
                                <Grid.Effect>
                                    <BlurEffect/>
                                </Grid.Effect>
                                <Rectangle x:Name="VisualRectangleDateTimeBackground" Margin="0" RadiusX="9.75" RadiusY="9.75">
                                    <Rectangle.Fill>
                                        <VisualBrush Visual="{Binding ElementName=ImageMenu}" Stretch="UniformToFill" AutoLayoutContent="False" Opacity="0.5"/>
                                    </Rectangle.Fill>
                                    <Rectangle.CacheMode>
                                        <BitmapCache/>
                                    </Rectangle.CacheMode>
                                </Rectangle>
                            </Grid>
                            <TextBlock x:Name="TextBlockTime" TextWrapping="Wrap" Text="00:00:00" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,3,0,0"  FontWeight="Bold" FontFamily="{DynamicResource RussianRail G Pro}"/>
                            <TextBlock x:Name="TextBlockData" TextWrapping="Wrap" Text="00.00.0000" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,0,0,3" FontFamily="{DynamicResource RussianRail G Pro}" />
                        </Grid>
                    </Border>
                    <Border x:Name="BorderIndicator" BorderBrush="#FF007D9E" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="3,3,3,3" Background="#CC77B0FD" Grid.Column="2">
                        <Image x:Name="ImageIndicator" Margin="5,5,5,5" Grid.Column="5"/>
                    </Border>
                </Grid>
            </Border>
            <GUI:IELBrowserPage x:Name="IELBrowserPageMain" Margin="0,1,0,0" Grid.Row="1">
                <GUI:IELBrowserPage.IELSettingObject>
                    <ObjectSettings:IELObjectSetting>
                        <ObjectSettings:IELObjectSetting.BackgroundSetting>
                            <Classes:BrushSettingQ Default="#9969AFAE" NotEnabled="#99960000" Select="#992FD6D4" Used="#9931C887"/>
                        </ObjectSettings:IELObjectSetting.BackgroundSetting>
                    </ObjectSettings:IELObjectSetting>
                </GUI:IELBrowserPage.IELSettingObject>
                <GUI:IELBrowserPage.IELButtonAddInlay>
                    <GUI:IELButtonImage HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" BorderThicknessBlock="2,2,2,2" ImageMargin="5,5,5,5" CornerRadius="5,5,5,5">
                        <GUI:IELButtonImage.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#FF3A9896" NotEnabled="#FFC52146" Select="#FF5FCECC" Used="#FF5FCEA8"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </GUI:IELButtonImage.IELSettingObject>
                    </GUI:IELButtonImage>
                </GUI:IELBrowserPage.IELButtonAddInlay>
            </GUI:IELBrowserPage>
        </Grid>
        <GUI:IELBlockMessage x:Name="IELMessageMain" Grid.Column="0" HorizontalAlignment="Left" Margin="219,82,0,0" Grid.Row="0" VerticalAlignment="Top" RadiusMagnite="2" Text="Hello" OffsetUpDown="6" Panel.ZIndex="2" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" RadiusDefault="15" OffsetLeftRight="6" FontFamily="Trebuchet MS" DefaultBackground="#FFC5FBE4"/>
    </Grid>
</Window>
