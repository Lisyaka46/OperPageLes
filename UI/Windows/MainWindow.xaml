<Base:OPLWindowBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
    xmlns:Base="clr-namespace:OPLAPI.OIEL.UserElementsControl.Base;assembly=OPLAPI"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI"
    x:Name="window" x:Class="OperPageLes.UI.Windows.MainWindow"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen" Background="{x:Null}" Width="800" Height="650" MinWidth="700" MinHeight="550" WindowStyle="None" AllowsTransparency="True">
    <Base:OPLWindowBase.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Base:OPLWindowBase.Resources>
    <Base:OPLWindowBase.TitleForeground>
        <LinearGradientBrush>
            <GradientStop Color="#FFC5C4B3" Offset="0.384"/>
            <GradientStop Color="#FFA1CAC0" Offset="1"/>
        </LinearGradientBrush>
    </Base:OPLWindowBase.TitleForeground>
    <WindowChrome.WindowChrome>
        <WindowChrome  ResizeBorderThickness="5" UseAeroCaptionButtons="False" CaptionHeight="35" CornerRadius="10,10,10,10" />
    </WindowChrome.WindowChrome>
    <Border x:Name="BorderWindowMainContent" CornerRadius="15,15,15,15">
        <Border.Background>
            <ImageBrush x:Name="ImageMenu" Stretch="UniformToFill"/>
        </Border.Background>
        <Border x:Name="BorderColorMain" CornerRadius="13,13,13,13" BorderBrush="Black" BorderThickness="1,1,1,1">
            <Grid x:Name="GridMain" RenderTransformOrigin="0.5,0.5">
                <Grid.Resources>
                    <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
                </Grid.Resources>
                <Grid Panel.ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="53"/>
                        <RowDefinition/>
                        <RowDefinition Height="56"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TextBlockVersion" Grid.Row="0" Text="*.*.*.**" Grid.ColumnSpan="1" VerticalAlignment="Top" HorizontalAlignment="Right" Padding="5,5,5,0" FontFamily="{DynamicResource Deledda Open Regular}" Margin="0,-20,0,0" FontWeight="Bold" FontSize="14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <IEL:IELButtonText x:Name="IELButtonBack" CornerRadius="10,10,10,10" MarginViewBox="0,0,0,2" Margin="5,5,6,5" Width="80" RenderTransformOrigin="0.5,0.5" FontFamily="{DynamicResource Bree CYR var}" Text="Назад" VisualGuide="LeftArrow" CornerRadiusGuides="7,7,7,7"/>
                        <Border x:Name="BorderButtonsUp" BorderBrush="#FF35755F" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="0,2,5,2" Grid.RowSpan="1" Focusable="True" Grid.ColumnSpan="1" Grid.Column="1">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.47,-2.5">
                                    <GradientStop Color="#CC78A08C" Offset="0.99"/>
                                    <GradientStop Color="#D80082AD" Offset="0.129"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.FocusVisualStyle>
                                <Style>
                                    <Setter Property="Control.Template" Value="{x:Null}"/>
                                </Style>
                            </Border.FocusVisualStyle>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <IEL:IELButtonImage x:Name="ImageLogoApplication" CornerRadius="6,6,6,6" MarginViewBox="2,2,2,2" Margin="3,3,3,3"/>
                                    <IEL:IELButtonImage x:Name="IELLangApplication" CornerRadius="6,6,6,6" MarginViewBox="2,2,2,2" Margin="3,3,3,3"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                                    <IEL:IELButtonImage x:Name="IELOpenDataFolder" CornerRadius="6,6,6,6" MarginViewBox="0,-3,0,0" Margin="3,3,3,3"/>
                                    <IEL:IELButtonImage x:Name="IELButtonSettings" CornerRadius="6,6,6,6" Margin="3,3,0,3" MarginViewBox="2,2,2,2"/>
                                    <IEL:IELButtonImage x:Name="IELButtonTheme" CornerRadius="6,6,6,6" Margin="3,3,0,3" MarginViewBox="4,4,4,4"/>
                                    <IEL:IELButtonImage x:Name="IELButtonCollapse" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Margin="3,3,0,3" MarginViewBox="1,1,1,1"/>
                                    <IEL:IELButtonImage x:Name="IELButtonClose" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Margin="3,3,3,3" MarginViewBox="0,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid x:FieldModifier="private" x:Name="GridContentFromBrowser" Grid.Row="1"/>
                    <Grid Grid.Row="2" Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="53"/>
                        </Grid.ColumnDefinitions>
                        <Border Margin="4,4,4,4" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" BorderBrush="#FF795671" Background="#CC98658D">
                            <StackPanel Orientation="Horizontal">
                                <IEL:IELButtonImage x:Name="IELButtonHomeBrowser" Margin="3,3,0,3" CornerRadius="7,7,7,7" Grid.ColumnSpan="1" MarginViewBox="0,0,0,0"/>
                                <IEL:IELButtonImage x:Name="IELButtonAddLabel" Margin="3,3,0,3" CornerRadius="7,7,7,7" Grid.ColumnSpan="1" Grid.Column="1" MarginViewBox="0,0,0,0"/>
                                <IEL:IELButtonImage x:Name="IELButtonInstallAppPage" Margin="3,3,3,3" CornerRadius="7,7,7,7" Grid.ColumnSpan="1" Grid.Column="1" MarginViewBox="0,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BorderImageInformation" BorderBrush="#FF29B1C3" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="4,4,4,4" Background="#D8C2DFD4" Grid.ColumnSpan="1" Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <Grid x:Name="GridInfoInternetConnection">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <IEL:IELBlockInfoImage x:Name="IELBlockInfoInternetConnection" Grid.Column="0" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Grid.RowSpan="2" Margin="3,3,0,3" Padding="0,0,0,7" Width="45" Focusable="False" Cursor="Arrow" IsAnimatedSettingQ="False" IsEnabledSettingQ="False"/>
                                    <TextBlock x:Name="TextBlockInternetConnectionMillisecond" TextWrapping="Wrap" Text="2999ms" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" IsHitTestVisible="False" FontFamily="{DynamicResource Bree CYR var}" Grid.Row="1" Margin="3,0,0,3" FontSize="11"/>
                                </Grid>
                                <IEL:IELBlockInfoText x:Name="IELBlockInfoStateRegister" Grid.Column="1"  FontWeight="Bold" FontSize="23" CornerRadius="5,5,5,5" Padding="6,0,6,0" Margin="3,3,0,3" FontFamily="{DynamicResource RussianRail G Pro}" Width="40" Focusable="False" Cursor="Hand" IsAnimatedSettingQ="False" IsEnabledSettingQ="False"/>
                                <IEL:IELBlockInfoText x:Name="IELBlockInfoCurrentLanguage" Grid.Column="2"  Text="" BorderThickness="2,2,2,2" FontWeight="Bold" CornerRadius="5,5,5,5" FontSize="14" Padding="6,0,6,0" Margin="3,3,0,3" FontFamily="{DynamicResource RussianRail G Pro}" Width="55" Focusable="False" Cursor="Arrow" IsAnimatedSettingQ="False" IsEnabledSettingQ="False"/>
                                <Grid>
                                    <IEL:IELBlockInfoImage x:Name="IELBlockInfoVolume" BorderThickness="2,2,2,2" FontWeight="Bold" CornerRadius="5,5,5,5" FontSize="14" Margin="3,3,3,3" FontFamily="{DynamicResource RussianRail G Pro}" Width="50" Cursor="Hand" IsAnimatedSettingQ="False" IsEnabledSettingQ="False" Padding="0,0,5,0"/>
                                    <Ellipse x:Name="EllipseBig" Stroke="Black" StrokeDashArray="100" StrokeDashOffset="89" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeDashCap="Round" StrokeThickness="2" Width="30" Height="30" StrokeMiterLimit="1" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Ellipse.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform/>
                                                <RotateTransform Angle="-45"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="EllipseMiddle" Stroke="Black" StrokeDashArray="100" StrokeDashOffset="93" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeDashCap="Round" StrokeThickness="2" Width="20" Height="20" StrokeMiterLimit="1" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Ellipse.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="-45"/>
                                            </TransformGroup>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="EllipseLittle" Stroke="Black" StrokeDashArray="100" StrokeDashOffset="97" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeDashCap="Round" StrokeThickness="2" Width="10" Height="10" StrokeMiterLimit="1" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Ellipse.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="-45"/>
                                            </TransformGroup>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BorderDateTime" BorderBrush="#FF528A86" BorderThickness="2,2,2,2" Margin="0,4,0,4" CornerRadius="10,10,10,10" Grid.Column="2" HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5,2" StartPoint="0.3,-2">
                                    <GradientStop Color="#FFCDFFEC" Offset="0.22"/>
                                    <GradientStop Color="#FF85A8E2" Offset="0.938"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid MinWidth="120">
                                <TextBlock x:Name="TextBlockTime" TextWrapping="Wrap" Text="00:00:00" FontSize="14"  FontWeight="Bold" Grid.RowSpan="1" HorizontalAlignment="Left" Padding="5,0,5,0" VerticalAlignment="Top" Margin="0,3,0,0" FontFamily="{DynamicResource RussianRail G Pro}"/>
                                <TextBlock x:Name="TextBlockData" TextWrapping="Wrap" Text="00.00.0000" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}" Grid.Row="1" Padding="5,0,5,0" VerticalAlignment="Bottom" Margin="0,0,0,3" FontWeight="Bold" />
                            </Grid>
                        </Border>
                        <Border x:Name="BorderIndicator" BorderBrush="#FF02637D" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="4,4,4,4" Background="#FFC37EBD" Grid.Column="3">
                            <Grid IsHitTestVisible="False">
                                <Ellipse x:Name="NotificationIndicator" Stroke="#FF02637D" Fill="#FFFBC4F6" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="1" StrokeThickness="2" Margin="0,-4,-4,0"/>
                                <OIEL:OPLVisualLoading x:FieldModifier="private" x:Name="VisualLoadingElement" Margin="4,4,4,4" BorderBrush="#FF381035"/>
                                <Viewbox Margin="11,13,11,13" VerticalAlignment="Center">
                                    <TextBlock x:FieldModifier="internal" x:Name="TextBlockCountLoadingProcess" Text="1" FontFamily="{DynamicResource Deledda Open Regular}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="1,0,0,0"/>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Base:OPLWindowBase>
