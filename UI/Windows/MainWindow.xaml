<Base:OPLWindowBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
    xmlns:Base="clr-namespace:ApplicationOperPageLes.UI.Windows.Base"
    xmlns:OPL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
    xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=LibraryIEL"
    x:Name="window" x:Class="ApplicationOperPageLes.UI.Windows.MainWindow"
    mc:Ignorable="d"
    Title="Главное меню" WindowStartupLocation="CenterScreen" Background="{x:Null}" Icon="/UI/Images/IconMainApplication.png" Width="800" Height="650" MinWidth="700" MinHeight="550" WindowStyle="None" AllowsTransparency="True">
    <Base:OPLWindowBase.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Base:OPLWindowBase.Resources>
    <Base:OPLWindowBase.TitleForeground>
        <LinearGradientBrush>
            <GradientStop Color="#FFC5C4B3" Offset="0.384"/>
            <GradientStop Color="#FFA1CAC0" Offset="1"/>
        </LinearGradientBrush>
    </Base:OPLWindowBase.TitleForeground>
    <WindowChrome.WindowChrome>
        <WindowChrome  ResizeBorderThickness="5" UseAeroCaptionButtons="False" CaptionHeight="35" CornerRadius="10,10,10,10" />
    </WindowChrome.WindowChrome>
    <Border x:Name="BorderWindowMainContent" CornerRadius="15,15,15,15">
        <Border.Background>
            <ImageBrush x:Name="ImageMenu"/>
        </Border.Background>
        <Border x:Name="BorderColorMain" CornerRadius="13,13,13,13">
            <Grid x:Name="GridMain" RenderTransformOrigin="0.5,0.5">
                <Grid.Resources>
                    <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
                </Grid.Resources>
                <IEL:IELPanelAction x:Name="IELActionPanelMain" HorizontalAlignment="Left" Margin="124,84,0,0" VerticalAlignment="Top" Panel.ZIndex="2" PaletteElement="{DynamicResource Cocoa}" CornerRadius="3,3,3,3"/>
                <Grid Panel.ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="53"/>
                        <RowDefinition/>
                        <RowDefinition Height="56"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="BorderButtonsUp" BorderBrush="#FF35755F" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="4,2,4,2" Grid.RowSpan="1" Focusable="True">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.47,-2.5">
                                <GradientStop Color="#CC78A08C" Offset="0.99"/>
                                <GradientStop Color="#D80082AD" Offset="0.129"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.FocusVisualStyle>
                            <Style>
                                <Setter Property="Control.Template" Value="{x:Null}"/>
                            </Style>
                        </Border.FocusVisualStyle>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="50"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" MinWidth="50"/>
                                <ColumnDefinition Width="Auto" MinWidth="50"/>
                            </Grid.ColumnDefinitions>
                            <IEL:IELButtonImage x:Name="ImageLogoApplication" CornerRadius="6,6,6,6" PaletteElement="{DynamicResource Lime}" MarginViewBox="5,2,5,2" Margin="3,3,3,3"/>
                            <IEL:IELButtonImage x:Name="IELButtonTheme" Grid.ColumnSpan="1" Grid.Column="2" CornerRadius="6,6,6,6" Padding="0,2,0,2" Margin="3,3,3,3" PaletteElement="{DynamicResource Chocolate}" MarginViewBox="5,2,5,2"/>
                            <IEL:IELButtonImage x:Name="IELButtonSettings" Grid.ColumnSpan="1" Grid.Column="3" CornerRadius="6,6,6,6" Padding="0,2,0,2" Margin="3,3,3,3" PaletteElement="{DynamicResource Purple}" MarginViewBox="5,2,5,2"/>
                            <IEL:IELButtonImage x:Name="IELImageButtonCollapse" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Grid.Column="4" Margin="3,3,3,3" Grid.ColumnSpan="1" PaletteElement="{DynamicResource LightBlue}" Padding="0,2,0,2" MarginViewBox="5,1,5,1"/>
                            <IEL:IELButtonImage x:Name="IELImageButtonClose" CornerRadius="6,6,6,6" BorderThickness="2,2,2,2" Grid.Column="5" Margin="3,3,3,3" Grid.ColumnSpan="1" PaletteElement="{DynamicResource Red}" Padding="0,2,0,2" MarginViewBox="5,2,5,2"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="13*"/>
                            <ColumnDefinition Width="19*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="53"/>
                        </Grid.ColumnDefinitions>
                        <Border Margin="4,4,4,4" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" BorderBrush="#FF795671" Background="#CC98658D">
                            
                        </Border>
                        <Border x:Name="BorderImageInformation" BorderBrush="#FF29B1C3" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="4,4,4,4" Background="#D8C2DFD4" Grid.ColumnSpan="1" Grid.Column="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <IEL:IELButtonImage x:Name="IELImageButtonMenu" CornerRadius="5,5,5,5" Margin="3,3,3,3" PaletteElement="{DynamicResource Red}" MarginViewBox="5,2,5,2" Padding="0,2,0,2"/>
                                <IEL:IELButtonText x:Name="IELImageButtonBackButtons" Grid.Column="1" Margin="3,3,3,3" Text="&lt;" FontSize="25" FontWeight="Bold" FontFamily="{DynamicResource October Pro Blk}" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Tangerine}" HeightViewBox="30" MarginViewBox="5,5,5,0"/>
                                <Grid Grid.Column="2">
                                    <IEL:IELPageController x:Name="IELPageControllerButtons" VerticalAlignment="Center" MinWidth="330"/>
                                </Grid>
                                <IEL:IELButtonText x:Name="IELImageButtonNextButtons" Grid.Column="3" Margin="3,3,3,3" CornerRadius="5,5,5,5" Text="&gt;" FontSize="25" FontWeight="Bold" FontFamily="{DynamicResource October Pro Blk}" PaletteElement="{DynamicResource Tangerine}" HeightViewBox="30" MarginViewBox="5,5,5,0"/>
                            </Grid>
                        </Border>
                        <Border x:Name="BorderDateTime" BorderBrush="#FF528A86" BorderThickness="2,2,2,2" Margin="0,4,0,4" CornerRadius="10,10,10,10" Grid.Column="2" HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5,2" StartPoint="0.3,-2">
                                    <GradientStop Color="#FFCDFFEC" Offset="0.22"/>
                                    <GradientStop Color="#FF85A8E2" Offset="0.938"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid MinWidth="120">
                                <TextBlock x:Name="TextBlockTime" TextWrapping="Wrap" Text="00:00:00" FontSize="14"  FontWeight="Bold" FontFamily="{DynamicResource RussianRail G Pro}" Grid.RowSpan="1" HorizontalAlignment="Left" Padding="5,0,5,0" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TextBlockData" TextWrapping="Wrap" Text="00.00.0000" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}" Grid.Row="1" Padding="5,0,5,0" VerticalAlignment="Bottom" Margin="0,0,0,3" FontWeight="Bold" />
                            </Grid>
                        </Border>
                        <Border x:Name="BorderIndicator" BorderBrush="#FF02637D" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="4,4,4,4" Background="#FFC37EBD" Grid.Column="3">
                            <Grid>
                                <Border x:Name="BorderNotificationIndicator" BorderThickness="2,2,2,2" BorderBrush="#FF02637D" Background="#FFFBC4F6" CornerRadius="5,5,5,5" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False" Panel.ZIndex="1"/>
                                <MediaElement x:Name="IndicatorLoading" Grid.Column="5" Stretch="UniformToFill" Margin="2,2,2,2" IsHitTestVisible="False">
                                    <MediaElement.OpacityMask>
                                        <RadialGradientBrush>
                                            <GradientStop Color="Black" Offset="0.709"/>
                                            <GradientStop Color="#00000000" Offset="0.844"/>
                                        </RadialGradientBrush>
                                    </MediaElement.OpacityMask>
                                </MediaElement>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Panel.ZIndex="1" Width="350">
                        <Frame x:Name="FrameNewInlayBrowser" Margin="0,-5,0,-5"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.Effect>
                            <BlurEffect x:Name="IELBrowserPageBlurEffect" Radius="0"/>
                        </Grid.Effect>
                        <OPL:OPLBrowserPage x:Name="IELBrowserPageMain" Grid.Row="1" FontFamily="{DynamicResource RussianRail G Pro}" FontSize="16" FontStyle="Italic" Background="#CC245848" BorderBrush="#B2FFFFFF" Margin="4,4,4,4"/>
                    </Grid>
                </Grid>
                <IEL:IELBlockMessage x:Name="IELMessageMain" Grid.Column="0" HorizontalAlignment="Left" Margin="219,82,0,0" Grid.Row="0" VerticalAlignment="Top" Text="Отображаемый текст" OffsetUpDown="6" Panel.ZIndex="2" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" OffsetLeftRight="6" FontFamily="{DynamicResource Deledda Open Regular}" DefaultBackground="#FFC5FBE4" FontSize="14" RadiusDefault="15" RadiusMagnite="2"/>
            </Grid>
        </Border>
    </Border>
</Base:OPLWindowBase>
