<Window
    x:Class="OperPageLes.UI.Windows.Dialogs.DialogSaveWait"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:OperPageLes.UI.Windows.Dialogs"
    xmlns:OIEL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
    Title="Сохранение..." Height="150" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{x:Null}" AllowsTransparency="True" Topmost="True" UseLayoutRounding="True" ShowInTaskbar="False" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Border x:Name="BorderMain" BorderThickness="3,3,3,3" CornerRadius="5,5,5,5" BorderBrush="#FF5D7A77">
        <Border.Background>
            <RadialGradientBrush x:Name="RadialGradientBackground" RadiusX="0.8" RadiusY="0.8" Center="0.8,0.8" GradientOrigin="0.8,0.8">
                <GradientStop Color="#FF618C83"/>
                <GradientStop Color="#FF7FB7B6" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,2" BorderBrush="#FF4A7990">
                <Border.OpacityMask>
                    <LinearGradientBrush EndPoint="0.8,7.2" StartPoint="0.2,-4.7">
                        <GradientStop Color="#4C000000" Offset="0.07"/>
                        <GradientStop Color="#4C000000" Offset="0.93"/>
                        <GradientStop Color="Black" Offset="0.3"/>
                        <GradientStop Color="Black" Offset="0.7"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                        <GradientStop Color="#00000000" Offset="0"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>
                <TextBlock x:Name="TextBlockHead" TextWrapping="Wrap" Text="Происходит сохранение ваших самых важных данных" FontSize="17" TextAlignment="Center" Padding="0,2,0,2" FontFamily="{DynamicResource Deledda Open Regular}" HorizontalAlignment="Center"/>
            </Border>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="GridProgressBar" Grid.Row="1" ClipToBounds="True">
                    <Line x:Name="LineProgress" StrokeThickness="18" X2="441" Stroke="#FF5D7A77" VerticalAlignment="Bottom" StrokeStartLineCap="Round" HorizontalAlignment="Left" StrokeDashCap="Round" StrokeEndLineCap="Round" X1="3"/>
                    <TextBlock x:Name="TextBlockInfoSaving" Padding="2,0,2,0" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" Text="Обновление" FontSize="14" FontFamily="{DynamicResource Bree CYR var}" Grid.RowSpan="1" Grid.Row="1" Panel.ZIndex="1"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="BorderIndicator" BorderBrush="#FF445856" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Margin="0,0,3,3" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="35" Height="35" Padding="2,2,2,2">
                            <Grid>
                                <OIEL:OPLVisualLoading x:Name="VisualLoading" BorderBrush="#FF445856"/>
                                <TextBlock x:Name="TextBlockTime" TextWrapping="Wrap" Text="00" TextAlignment="Center" FontFamily="{DynamicResource Tablon}" Grid.ColumnSpan="1" VerticalAlignment="Center" Padding="0,2,0,0" Grid.Column="1" FontSize="10"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
