<Window x:Class="ApplicationOperPageLes.UI.Windows.Dialogs.DialogQDataSpectrum"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Windows.Dialogs"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=IEL"
        mc:Ignorable="d"
        Title="DialogQDataSpectrum" Height="450" Width="490" ResizeMode="NoResize">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Black" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Margin="5,5,5,5">
            <Border.Background>
                <LinearGradientBrush EndPoint="1,1.3" StartPoint="1,0">
                    <GradientStop Color="#FF00FFED"/>
                    <GradientStop Color="#FF00E2FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <IEL:IELBlockInfoText x:Name="IELBlockExample80" Width="80" Height="80" Margin="5,5,5,5" CornerRadius="5,5,5,5" Text="Example" FontSize="16" IsHitTestVisible="False" Focusable="False"/>
                    <IEL:IELBlockInfoText x:Name="IELBlockExample50" Width="50" Height="50" Grid.Column="1" VerticalAlignment="Bottom" Margin="5,5,5,5" CornerRadius="5,5,5,5" Text="Example" FontSize="11" IsHitTestVisible="False" Focusable="False"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <IEL:IELBlockInfoText x:Name="IELBlockExampleB80" Width="80" Height="80" Margin="5,5,5,5" CornerRadius="5,5,5,5" Text="Example" FontSize="16" FontWeight="Bold" IsHitTestVisible="False" Focusable="False"/>
                    <IEL:IELBlockInfoText x:Name="IELBlockExampleB50" Width="50" Height="50" Grid.Column="1" VerticalAlignment="Bottom" Margin="5,5,5,5" CornerRadius="5,5,5,5" Text="Example" FontSize="11" FontWeight="Bold" IsHitTestVisible="False" Focusable="False"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="NameSpectrum" Text="Spectrum" VerticalAlignment="Center" Margin="5,0,5,0" FontSize="16" TextDecorations="Underline" FontWeight="SemiBold" FontFamily="{DynamicResource Deledda Open Regular}" TextAlignment="Center" Padding="0,10,0,0"/>
                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1,1,1,1" CornerRadius="5,5,5,5" Margin="2,2,2,2" Background="White">
                        <Grid x:Name="GridColors" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TextBlockSelectIndicator" Text="&gt;" FontFamily="{DynamicResource Tablon}" Panel.ZIndex="1" HorizontalAlignment="Left" Grid.RowSpan="3" VerticalAlignment="Top" FontSize="32" Margin="0,8,0,0"/>
                            <Grid>
                                <TextBlock Text="BG" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16" IsHitTestVisible="False" Margin="-70,0,0,0"/>
                                <Border x:Name="BorderColorBackground" Width="100" Height="50" Grid.Row="0" Margin="5,15,5,5" CornerRadius="10,10,10,10" Background="Red" HorizontalAlignment="Center"/>
                                
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBlock Text="BB" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16" IsHitTestVisible="False" Margin="-70,0,0,0"/>
                                <Border x:Name="BorderColorBorderBrush" Width="100" Height="50" Grid.Row="1" Margin="5,15,5,5" CornerRadius="5,5,5,5" Background="Red" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <TextBlock Text="FG" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16" IsHitTestVisible="False" Margin="-70,0,0,0"/>
                                <Border x:Name="BorderColorForeground" Width="100" Height="50" Grid.Row="2" Margin="5,15,5,5" CornerRadius="5,5,5,5" Background="Red" HorizontalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <colorpicker:StandardColorPicker x:Name="ColorPicker" x:FieldModifier="private" Grid.Column="1" HexRepresentation="ARGB" BorderThickness="2,2,2,2" Margin="5,5,5,5" MinHeight="0" FontFamily="{DynamicResource Deledda Open Regular}" FontWeight="Bold" FontSize="10" ShowFractionalPart="False" BorderBrush="Black"/>
    </Grid>
</Window>
