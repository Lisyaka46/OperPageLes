<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Windows.Dialogs"
        xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
        xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=LibraryIEL"
        xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
        x:Class="ApplicationOperPageLes.UI.Windows.Dialogs.DialogGenDataLabelTag"
        Height="450" Width="450" WindowStartupLocation="CenterScreen" Background="#FF5BBFAF"  ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="5,10,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="49*"/>
                <RowDefinition Height="250*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock TextWrapping="Wrap" Text="Имя тега:" VerticalAlignment="Center" Padding="5,5,5,5" FontSize="18" FontFamily="Comic Sans MS"/>
                <IEL:IELTextBox x:Name="IELTextBoxNameTag" Grid.Column="1" FontSize="16" TextBoxVerticalAlignment="Stretch" TextBoxHorizontalAlignment="Stretch" CornerRadius="4,4,4,4"  Text="" FontFamily="{DynamicResource Deledda Open Regular}"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <IEL:IELButtonText x:Name="IELButtonComplete" Grid.Column="1" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Text="Создать" FontSize="18"  Padding="30,4,30,4" FontFamily="{DynamicResource Bree CYR var}" VerticalAlignment="Center" Margin="5,0,5,0"/>
                <IEL:IELButtonText x:Name="IELButtonClose" Grid.Column="0" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" Text="Отмена" FontSize="18"  Padding="30,4,30,4" FontFamily="{DynamicResource Bree CYR var}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,5,0"/>
            </Grid>
        </Grid>
        <TextBlock x:Name="TextBlockTitle" TextWrapping="Wrap" Text="Создание тега для ярлыка" VerticalAlignment="Center" TextAlignment="Center" FontSize="20" Padding="0,4,0,4"  Background="#FF43E1FF" FontFamily="{DynamicResource RussianRail G Pro}">
            <TextBlock.OpacityMask>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="0.9"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.OpacityMask>
        </TextBlock>
    </Grid>
</Window>
