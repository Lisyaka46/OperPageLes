<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperPageLes.UI.Windows.Dialogs"
        xmlns:IEL="clr-namespace:IEL.GUI;assembly=IEL"
        xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL"
        xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
        x:Class="OperPageLes.UI.Windows.Dialogs.DialogGenDataLabelTag"
        Height="450" Width="450" WindowStartupLocation="CenterScreen" Background="#FF5BBFAF"  ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="5,10,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="49*"/>
                <RowDefinition Height="250*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <IEL:IELTextBox x:Name="IELTextBoxNameTag" Grid.Column="1" FontSizeText="16" TextBoxVerticalAlignment="Stretch" TextBoxHorizontalAlignment="Stretch" CornerRadius="4,4,4,4"  Text="" FontFamily="{DynamicResource Deledda Open Regular}">
                    <IEL:IELTextBox.IELSettingObject>
                        <ObjectSettings:IELObjectSetting>
                            <ObjectSettings:IELObjectSetting.ForegroundSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELObjectSetting.ForegroundSetting>
                            <ObjectSettings:IELObjectSetting.BorderBrushSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELObjectSetting.BorderBrushSetting>
                            <ObjectSettings:IELObjectSetting.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FF41ECB1" Select="#FF68B399" Used="#FF5DF174" NotEnabled="#FFF55757"/>
                            </ObjectSettings:IELObjectSetting.BackgroundSetting>
                        </ObjectSettings:IELObjectSetting>
                    </IEL:IELTextBox.IELSettingObject>
                </IEL:IELTextBox>
                <TextBlock TextWrapping="Wrap" Text="Имя тега:" VerticalAlignment="Center" Padding="5,5,5,5" FontSize="18" FontFamily="Comic Sans MS"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <IEL:IELButtonText x:Name="IELButtonComplete" Grid.Column="1" BorderThicknessBlock="2,2,2,2" CornerRadius="5,5,5,5" Text="Создать" FontSize="18"  PaddingContent="30,4,30,4" FontFamily="{DynamicResource Bree CYR var}" VerticalAlignment="Center" Margin="5,0,5,0">
                    <IEL:IELButtonText.IELSettingObject>
                        <ObjectSettings:IELButtonObjectSetting StateVisualizationButton="Default">
                            <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                            <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FF1ECDDA" NotEnabled="#FFEC4A4A" Select="#FFF895F9" Used="#FFBEF2FF"/>
                            </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        </ObjectSettings:IELButtonObjectSetting>
                    </IEL:IELButtonText.IELSettingObject>
                </IEL:IELButtonText>
                <IEL:IELButtonText x:Name="IELButtonClose" Grid.Column="0" BorderThicknessBlock="2,2,2,2" CornerRadius="5,5,5,5" Text="Отмена" FontSize="18"  PaddingContent="30,4,30,4" FontFamily="{DynamicResource Bree CYR var}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,5,0">
                    <IEL:IELButtonText.IELSettingObject>
                        <ObjectSettings:IELButtonObjectSetting>
                            <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                <Classes:BrushSettingQ Default="#FFFF7BBD" Select="#FF946E96" Used="#FFFFC4E2" NotEnabled="#FFF94C4C"/>
                            </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                            <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                <Classes:BrushSettingQ/>
                            </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        </ObjectSettings:IELButtonObjectSetting>
                    </IEL:IELButtonText.IELSettingObject>
                </IEL:IELButtonText>
            </Grid>
        </Grid>
        <TextBlock x:Name="TextBlockTitle" TextWrapping="Wrap" Text="Создание тега для ярлыка" VerticalAlignment="Center" TextAlignment="Center" FontSize="20" Padding="0,4,0,4"  Background="#FF43E1FF" FontFamily="{DynamicResource RussianRail G Pro}">
            <TextBlock.OpacityMask>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="0.9"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.OpacityMask>
        </TextBlock>
        <IEL:IELButtonImage HorizontalAlignment="Left" Margin="-73,105,0,0" Grid.Row="1" VerticalAlignment="Top"/>

    </Grid>
</Window>
