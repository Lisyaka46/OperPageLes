<Base:OPLWindowBase
    x:Class="ApplicationOperPageLes.UI.Windows.Dialogs.DialogConnect"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Base="clr-namespace:ApplicationOperPageLes.UI.Windows.Base"
    xmlns:OIEL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=IEL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Windows.Dialogs"
    mc:Ignorable="d" Height="200" Width="276" WindowStyle="None" AllowsTransparency="True" Background="#FF4DDAD0" TitleForeground="#FF053B3C" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontSize="7">
    <WindowChrome.WindowChrome>
        <WindowChrome  ResizeBorderThickness="5" UseAeroCaptionButtons="False" CaptionHeight="35" CornerRadius="10,10,10,10" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TextBlockIndicatorConnect" Text="Идёт попытка подключения..." VerticalAlignment="Bottom" FontSize="14" HorizontalAlignment="Center" FontStyle="Italic" Margin="0,0,0,3"/>
            <IEL:IELButtonImage x:Name="IELButtonCancel" Width="28" Height="28" Grid.Column="1" HorizontalAlignment="Right" Margin="3,3,5,3" CornerRadius="3,3,3,3" PaletteElement="{DynamicResource Red}" MarginViewBox="2,2,2,2"/>
        </Grid>
        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Grid Grid.RowSpan="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <IEL:IELTextBox x:Name="IELTextBoxPort" FontFamily="{DynamicResource RussianRail G Pro}" Grid.RowSpan="1" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource PlumCrayola}" FontSize="16" Text="49151" TextBoxHorizontalAlignment="Center" Grid.Column="2" Margin="2,0,5,0" MaxLength="5" Grid.ColumnSpan="1" Width="90"/>
                <IEL:IELTextBox x:Name="IELTextBoxIP" FontFamily="{DynamicResource RussianRail G Pro}" Grid.RowSpan="1" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource PlumCrayola}" FontSize="16" TextBoxHorizontalAlignment="Center" Grid.Column="0" Margin="5,0,2,0" MaxLength="15" Width="155"/>
                <TextBlock Grid.Column="1" Text=":" FontSize="36" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{DynamicResource Tablon}" FontWeight="Bold" Margin="-2,-11,0,-6"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="3">
            <IEL:IELButtonText x:Name="IELComplete" Text="Открыть" CornerRadius="5,5,5,5" CornerRadiusGuides="7.6,7.6,7.6,7.6" VisualGuide="RightArrow" PaletteElement="{DynamicResource Aquamarine}" FontFamily="{DynamicResource Bree CYR var}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="30" Margin="0,0,5,5" MarginViewBox="5,3,5,3"/>
        </Grid>
    </Grid>
</Base:OPLWindowBase>
