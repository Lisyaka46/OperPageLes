<Base:OPLWindowBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:OperPageLes.UI.Windows.Dialogs"
    xmlns:OPL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=LibraryIEL"
    xmlns:Base="clr-namespace:OperPageLes.UI.Windows.Base"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
    x:Class="OperPageLes.UI.Windows.Dialogs.DialogManipulateLabelTags" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Title="Менеджер тегов" Width="460" Height="360" TitleForeground="#FF9EE1ED">
    <Base:OPLWindowBase.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Base:OPLWindowBase.Resources>
    <Base:OPLWindowBase.Background>
        <RadialGradientBrush x:FieldModifier="private" x:Name="BackGroundRadialBrush" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#FF239DA0" Offset="0.354"/>
            <GradientStop Color="#00239DA0" Offset="1"/>
        </RadialGradientBrush>
    </Base:OPLWindowBase.Background>
    <WindowChrome.WindowChrome>
        <WindowChrome  ResizeBorderThickness="5" UseAeroCaptionButtons="False" CaptionHeight="35" CornerRadius="10,10,10,10" />
    </WindowChrome.WindowChrome>
    <Grid>
        <IEL:IELBlockMessage x:Name="BlockMessage" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="2" DefaultBackground="#FF52FBEF" DefaultBorderBrush="#FF93968B" RadiusDefault="13" RadiusMagnite="0" Text="" FontFamily="{DynamicResource Bree CYR var}" FontSize="14"/>
        <Border x:Name="BorderTags" BorderBrush="Black" BorderThickness="2,2,2,2" CornerRadius="15,15,15,15" Margin="5,5,5,5">
            <Border.Background>
                <LinearGradientBrush EndPoint="1.2,0" StartPoint="0,-0.14" Opacity="0.85">
                    <GradientStop Color="#FF61BB7F" Offset="0.625"/>
                    <GradientStop Color="#FFA78551" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <IEL:IELScrollViewer x:FieldModifier="private" x:Name="ScrollViewerTags" Margin="5,0,10,0" VerticalScrollAligment="Left" ScrollForce="30"/>
                <Border x:Name="BorderAddTag" VerticalAlignment="Bottom" Height="60" Panel.ZIndex="1" BorderThickness="10,3,0,3" Margin="0,0,0,5" HorizontalAlignment="Right" Width="400" BorderBrush="#FF33543C" CornerRadius="10,0,0,10" Background="#FF4C6753">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Создание нового тега" FontFamily="{DynamicResource RussianRail G Pro}" Foreground="#FFB4F6FF" Margin="5,0,5,0"/>
                        <Grid Grid.RowSpan="1" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <IEL:IELButtonText x:FieldModifier="private" x:Name="IELButtonCancelAddTag" PaletteElement="{DynamicResource Fuzi_woozy}" Text="Отмена" FontFamily="{DynamicResource Bree CYR var}" Grid.ColumnSpan="1" VerticalAlignment="Center" Margin="3,5,3,5" VisualGuide="RightArrow" MarginViewBox="0,4,0,4" CornerRadius="5,5,5,5" CornerRadiusGuides="7,7,7,7"/>
                            <IEL:IELBlockInfoImage x:Name="IELBlockInfoAddTag" Grid.Column="1" Margin="0,3,0,3" CornerRadius="8,8,8,8" PaletteElement="{DynamicResource LightBlue}" Width="33" Cursor="Help" Height="33" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <IEL:IELTextBox x:Name="IELTextBoxAddTag" Grid.Column="2" Margin="3,3,3,3" CornerRadius="4,4,4,4" PaletteElement="{DynamicResource Aquamarine}" FontFamily="{DynamicResource Vollda}" Padding="1,5,1,0" Grid.ColumnSpan="1" Text="Тег" FontSize="17"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="1" BorderThickness="0,2,0,0" BorderBrush="#4C000000" Padding="0,3,0,3">
                    <Grid HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <IEL:IELButtonText x:Name="IELButtonRemoveTag" CornerRadius="5,5,5,5" Text="Удалить" Padding="5,0,5,0"  BorderThickness="2,2,2,2" FontSize="16" Grid.Column="0" FontFamily="{DynamicResource Bree CYR var}" Margin="5,2,5,2" PaletteElement="{DynamicResource PastelRed}" VerticalAlignment="Center"/>
                        <IEL:IELButtonText x:Name="IELButtonChangeTag" CornerRadius="5,5,5,5" Margin="5,2,5,2" Grid.Column="1" Text="Изменить" Padding="5,0,5,0"  BorderThickness="2,2,2,2" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" PaletteElement="{DynamicResource PastelBlue}" VerticalAlignment="Center"/>
                        <IEL:IELButtonText x:Name="IELButtonComplete" CornerRadius="5,5,5,5" Grid.Column="3" Text="Готово"  BorderThickness="2,2,2,2" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" Padding="5,0,5,0" Margin="5,2,5,2" PaletteElement="{DynamicResource Green}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Base:OPLWindowBase>
