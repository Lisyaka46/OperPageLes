<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:OperPageLes.UI.Windows.Dialogs"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI"
    xmlns:OPL="clr-namespace:OperPageLes.UI.UserElementsControl.Default"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
    xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=LibraryIEL" 
    x:Class="OperPageLes.UI.Windows.Dialogs.DialogGenLabel"
    Title="Создание ярлыка" WindowStartupLocation="CenterScreen" Background="{x:Null}" ResizeMode="NoResize" Width="360" Height="470">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Grid Background="#FF1FB5B9">
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Grid>
            <Border BorderBrush="#FF479871" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Grid.RowSpan="1" Grid.ColumnSpan="1" Grid.Column="1" Grid.Row="1" Background="#4C16E498" Margin="5,5,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Viewbox Margin="10,100,10,0" VerticalAlignment="Top" Height="250" StretchDirection="DownOnly" Panel.ZIndex="1" HorizontalAlignment="Left">
                        <OPL:OPLHitInterpreter x:Name="HitInterpreter" Width="250" Grid.Row="0" Height="10" PaletteElement="{DynamicResource PastelBlue}" HorizontalAlignment="Left" BorderThickness="3,1,3,3" VerticalAlignment="Top" CornerRadius="0,0,6,6" MaxHeight="250" Margin="0,0,0,0" Padding="0,0,0,0" IsEnabledSettingQ="False"/>
                    </Viewbox>
                    <StackPanel>
                        <Grid Margin="5,5,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <IEL:IELTextBox x:Name="IELTextBoxNameLabel" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" BorderThickness="1.7,1.7,1.7,1.7" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource LightBlue}" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,0" MaxLength="64"/>
                            <TextBlock x:Name="TextBlockNameShortcut" Grid.Row="0" TextWrapping="Wrap" VerticalAlignment="Center"  FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}">
                                <Run x:Name="RunNameShortcut">n</Run><Run x:Name="RunNameRequiredSymbol">*</Run>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="5,5,5,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" VerticalAlignment="Bottom" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}">
                                <Run x:Name="RunCommandShortcut">c</Run><Run x:Name="RunCommandRequiredSymbol">*</Run>
                            </TextBlock>
                            <IEL:IELTextBox x:Name="IELTextBoxCommand" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" BorderThickness="1.7,1.7,1.7,1.7" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource PastelBlue}" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,0" VerticalAlignment="Top" Grid.Row="1"/>
                        </Grid>
                        <Grid Margin="5,5,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <IEL:IELTextBox x:Name="IELTextBoxDescription" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" BorderThickness="1.7,1.7,1.7,1.7" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Tangerine}" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,0" Panel.ZIndex="0"/>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Bottom" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}">
                                <Run x:Name="RunDescriptionShortcut">d</Run>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="5,5,5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Используемый спектр темы:" VerticalAlignment="Center" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}"/>
                            <IEL:IELBlockInfoText x:Name="ButtonSelectSpectrumTheme" Width="30" Height="30" CornerRadius="6,6,6,6" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="5,5,5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Параметры ярлыка:" VerticalAlignment="Center" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}"/>
                            
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="26*"/>
                <RowDefinition Height="26*"/>
            </Grid.RowDefinitions>
            <IEL:IELButtonText x:Name="IELButtonCreateLabel" BorderThickness="2,2,2,2" Text="Создать ярлык" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" CornerRadiusGuides="7.6,7.6,7.6,7.6" PaletteElement="{DynamicResource Jade}" Margin="2,2,2,2"/>
            <IEL:IELButtonText x:Name="IELButtonCancel" Text="Отмена" Grid.Row="1" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" CornerRadiusGuides="7.6,7.6,7.6,7.6" PaletteElement="{DynamicResource Red}" Margin="2,2,2,2"/>
        </Grid>
    </Grid>
</Window>
