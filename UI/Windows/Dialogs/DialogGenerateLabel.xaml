<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Windows.Dialogs"
        xmlns:IEL="clr-namespace:IEL.GUI;assembly=IEL"
        xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
        xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" 
        x:Class="ApplicationOperPageLes.UI.Windows.Dialogs.DialogGenLabel"
        Title="Создание ярлыка" WindowStartupLocation="CenterScreen" Background="{x:Null}" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Grid Background="#FF1FB5B9">
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Border BorderBrush="#FF479871" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Grid.RowSpan="1" Grid.ColumnSpan="1" Grid.Column="1" Grid.Row="1" Background="#4C16E498" Margin="5,5,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <IEL:IELTextBox x:Name="IELTextBoxNameLabel" Text="ыва" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" Margin="5,0,5,0" BorderThickness="1.7,1.7,1.7,1.7" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource LightBlue}" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,0"/>
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Название ярлыка*" VerticalAlignment="Center" Margin="5,0,5,0"  FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Команда ярлыка*" VerticalAlignment="Bottom" Margin="5,10,5,0" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}"/>
                        <IEL:IELTextBox x:Name="IELTextBoxCommand" Text="фыва" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" Margin="5,0,5,0" BorderThickness="1.7,1.7,1.7,1.7" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource PastelBlue}" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,0"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12*"/>
                            <RowDefinition Height="37*"/>
                        </Grid.RowDefinitions>
                        <IEL:IELTextBox x:Name="IELTextBoxDescription" Text="Еуче" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" Margin="5,0,5,0" BorderThickness="1.7,1.7,1.7,1.7" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Tangerine}" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,0"/>
                        <TextBlock TextWrapping="Wrap" Text="Описание ярлыка" VerticalAlignment="Bottom" Margin="5,10,5,0" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="26*"/>
                <RowDefinition Height="26*"/>
            </Grid.RowDefinitions>
            <IEL:IELButtonText x:Name="IELButtonCreateLabel" BorderThickness="2,2,2,2" Text="Создать ярлык" FontSize="16" Padding="0,7,0,7" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" CornerRadiusGuides="7.6,7.6,7.6,7.6" PaletteElement="{DynamicResource Jade}" Margin="2,2,2,2"/>
            <IEL:IELButtonText x:Name="IELButtonCancel" Text="Отмена" Grid.Row="1" FontSize="16" Padding="0,7,0,7" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" CornerRadiusGuides="7.6,7.6,7.6,7.6" PaletteElement="{DynamicResource Red}" Margin="2,2,2,2"/>
        </Grid>
    </Grid>
</Window>
