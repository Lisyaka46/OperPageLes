<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:OperPageLes.UI.Windows.Dialogs"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OPL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
    xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=LibraryIEL" 
    x:Class="OperPageLes.UI.Windows.Dialogs.DialogGenLabel"
    Title="Создание ярлыка" WindowStartupLocation="CenterScreen" Background="{x:Null}" ResizeMode="NoResize" Width="300" Height="430">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Grid Background="#FF1FB5B9">
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>
        <Grid>
            <Border BorderBrush="#FF479871" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Grid.RowSpan="1" Grid.ColumnSpan="1" Grid.Column="1" Grid.Row="1" Background="#4C16E498" Margin="5,5,5,5">
                <StackPanel>
                    <Grid Grid.Row="0" Margin="5,5,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <IEL:IELTextBox x:Name="IELTextBoxNameLabel" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" BorderThickness="1.7,1.7,1.7,1.7" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource LightBlue}" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,0" MaxLength="64"/>
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Название ярлыка*" VerticalAlignment="Center"  FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="5,5,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Команда ярлыка*" VerticalAlignment="Bottom" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}"/>
                        <IEL:IELTextBox x:Name="IELTextBoxCommand" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" BorderThickness="1.7,1.7,1.7,1.7" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource PastelBlue}" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,0"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="5,5,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12*"/>
                            <RowDefinition Height="37*"/>
                        </Grid.RowDefinitions>
                        <IEL:IELTextBox x:Name="IELTextBoxDescription" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" BorderThickness="1.7,1.7,1.7,1.7" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Tangerine}" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,0"/>
                        <TextBlock TextWrapping="Wrap" Text="Описание ярлыка" VerticalAlignment="Bottom" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="5,5,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Используемый спектр темы:" VerticalAlignment="Center" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}"/>
                        <IEL:IELBlockInfoText x:Name="ButtonSelectSpectrumTheme" Width="30" Height="30" CornerRadius="6,6,6,6" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="26*"/>
                <RowDefinition Height="26*"/>
            </Grid.RowDefinitions>
            <IEL:IELButtonText x:Name="IELButtonCreateLabel" BorderThickness="2,2,2,2" Text="Создать ярлык" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" CornerRadiusGuides="7.6,7.6,7.6,7.6" PaletteElement="{DynamicResource Jade}" Margin="2,2,2,2"/>
            <IEL:IELButtonText x:Name="IELButtonCancel" Text="Отмена" Grid.Row="1" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="5,5,5,5" CornerRadiusGuides="7.6,7.6,7.6,7.6" PaletteElement="{DynamicResource Red}" Margin="2,2,2,2"/>
        </Grid>
    </Grid>
</Window>
