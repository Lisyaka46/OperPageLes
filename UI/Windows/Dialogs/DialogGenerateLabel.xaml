<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Windows.Dialogs"
        xmlns:IEL="clr-namespace:IEL.GUI;assembly=IEL"
        xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
        xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" 
        x:Class="ApplicationOperPageLes.UI.Windows.Dialogs.DialogGenLabel"
        Title="Создание ярлыка" WindowStartupLocation="CenterScreen" Background="{x:Null}" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Grid Background="#FF1FB5B9">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Border BorderBrush="#FF6D6D6D" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Grid.RowSpan="1" Grid.ColumnSpan="1" Grid.Column="1" Grid.Row="1" Background="#4C356352" Margin="5,5,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <IEL:IELTextBox x:Name="IELTextBoxNameLabel" Text="" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" Margin="5,0,5,0" BorderThickness="1.7,1.7,1.7,1.7"/>
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Название ярлыка*" VerticalAlignment="Center" Margin="5,0,5,0"  FontSize="14" Padding="0,0,0,2" FontFamily="{DynamicResource Bree CYR var}"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Команда ярлыка*" VerticalAlignment="Center" Margin="5,0,5,0" FontSize="14"  Padding="0,8,0,2" FontFamily="{DynamicResource Bree CYR var}"/>
                        <IEL:IELTextBox x:Name="IELTextBoxCommand" Text="" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" Margin="5,0,5,0" BorderThickness="1.7,1.7,1.7,1.7"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12*"/>
                            <RowDefinition Height="37*"/>
                        </Grid.RowDefinitions>
                        <IEL:IELTextBox x:Name="IELTextBoxDescription" Text="" TextBoxVerticalAlignment="Center" FontSize="16" Grid.RowSpan="1" Grid.Row="1" Margin="5,0,5,0" BorderThickness="1.7,1.7,1.7,1.7"/>
                        <TextBlock TextWrapping="Wrap" Text="Описание ярлыка" VerticalAlignment="Top" Margin="5,0,5,0" Padding="0,8,0,2" FontSize="14" FontFamily="{DynamicResource Bree CYR var}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="26*"/>
                <RowDefinition Height="26*"/>
            </Grid.RowDefinitions>
            <IEL:IELButtonText x:Name="IELButtonCreateLabel" BorderThickness="2,2,2,2" Text="Создать ярлык" FontSize="16" Padding="15,5,15,5" FontFamily="{DynamicResource Bree CYR var}">
                <!--<IEL:IELButtonText.IELSettingObject>
                    <ObjectSettings:IELButtonObjectSetting>
                        <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                            <Classes:BrushSettingQ Default="#FF102B1B" Select="#FF133C24" Used="#FF34423A" NotEnabled="#FF521717"/>
                        </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            <Classes:BrushSettingQ Default="#FF102B1B" Select="#FF133C24" Used="#FF34423A" NotEnabled="#FF521717"/>
                        </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            <Classes:BrushSettingQ Default="#FF44B373" Select="#FF4DE88E" Used="#FFA7F1C6" NotEnabled="#FF942E2E"/>
                        </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                    </ObjectSettings:IELButtonObjectSetting>
                </IEL:IELButtonText.IELSettingObject>-->
            </IEL:IELButtonText>
            <IEL:IELButtonText x:Name="IELButtonCancel" BorderThickness="4,2,2,2" Text="Отмена" Grid.Row="1" FontSize="16" Padding="15,5,15,5" FontFamily="{DynamicResource Bree CYR var}">
                <!--<IEL:IELButtonText.IELSettingObject>
                    <ObjectSettings:IELButtonObjectSetting>
                        <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            <Classes:BrushSettingQ Default="#FFCA7474" NotEnabled="#FFE03939" Select="#FFFF7575" Used="#FFFDCBCB"/>
                        </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                            <Classes:BrushSettingQ Default="#FF332525" Select="#FF422C2C" Used="#FF423434" NotEnabled="#FF521717"/>
                        </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            <Classes:BrushSettingQ Default="#FF332525" Select="#FF422C2C" Used="#FF423434" NotEnabled="#FF521717"/>
                        </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                    </ObjectSettings:IELButtonObjectSetting>
                </IEL:IELButtonText.IELSettingObject>-->
            </IEL:IELButtonText>
        </Grid>
    </Grid>
</Window>
