<Base:OPLWindowBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OperPageLes.UI.Windows.Dialogs"
    xmlns:Base="clr-namespace:OPLAPI.OIEL.UserElementsControl.Base;assembly=OPLAPI"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=LibraryIEL"
    xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=LibraryIEL"
    x:Class="OperPageLes.UI.Windows.Dialogs.DialogInputProgramKey"
    Title="Ввод ключа доступа" Height="320" Width="565" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" AllowsTransparency="True" RenderTransformOrigin="0.5,0.5">
    <Base:OPLWindowBase.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Base:OPLWindowBase.Resources>
    <Base:OPLWindowBase.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:FieldModifier="private" x:Name="SourceScaleTransform" ScaleX="1" ScaleY="1"/>
            <SkewTransform x:FieldModifier="private" x:Name="SourceSkewTransform" AngleX="0" AngleY="0"/>
            <RotateTransform x:FieldModifier="private" x:Name="SourceRotateTransform" Angle="0" CenterX="-50"/>
        </TransformGroup>
    </Base:OPLWindowBase.RenderTransform>
    <Base:OPLWindowBase.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF8EB9C7"/>
            <GradientStop Color="#FFA6DCCE" Offset="1"/>
        </LinearGradientBrush>
    </Base:OPLWindowBase.Background>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="0,0,5,5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="45">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <IEL:IELButtonText x:Name="IELButtonInput" Grid.Column="1" BorderThickness="2,2,2,2" Text="Ввод" FontFamily="{DynamicResource Bree CYR var}" CornerRadius="10,10,10,10" PaletteElement="{DynamicResource Green}" Margin="5,0,0,0" Padding="10,3,10,3"/>
            <IEL:IELButtonText x:Name="IELButtonCancel" Grid.Column="0" BorderThickness="2,2,2,2" Text="Отмена" FontFamily="{DynamicResource Bree CYR var}" Margin="0,0,5,0" CornerRadius="10,10,10,10" PaletteElement="{DynamicResource Red}" Padding="10,3,10,3"/>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock TextWrapping="Wrap" Text="Для продолжения использования системы необходимо ввести ключ доступа" FontSize="20" FontFamily="{DynamicResource Deledda Open Regular}" Padding="10,5,10,5"/>
            <Border BorderBrush="Black" BorderThickness="2,2,2,2" Grid.Row="1" Margin="5,5,5,5" CornerRadius="6,6,6,6" Background="#FFD6DEFF">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="Введите ключ который подходит под указанный упаковщик" FontSize="16" FontFamily="{DynamicResource Deledda Open Regular}" Padding="5,5,5,5" TextAlignment="Center" Grid.RowSpan="1"/>
                    <Grid Grid.Row="1" Margin="5,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TextBlockPack" Text="SUNHSkhBR0lJQklGSEVIQ0lDQkFISEFHSElER0ZHQkdC" FontFamily="{DynamicResource Vollda}" Foreground="#FF0D3254" MaxHeight="36" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Grid.Column="0" Margin="3,0,3,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="2">
                            <Line X1="0" Y1="50" Stroke="Black" StrokeThickness="2" VerticalAlignment="Center" Grid.ColumnSpan="1" Grid.Column="1" HorizontalAlignment="Center"/>
                            <IEL:IELButtonText x:Name="IELButtonCopyPack" Grid.Column="0" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Margin="3,3,3,3" Text="Скопировать" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" Padding="10,0,10,0" PaletteElement="{DynamicResource Tangerine}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <IEL:IELButtonText x:Name="IELButtonUpdatePack" Grid.Column="1" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Margin="3,3,3,3" Text="Обновить" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" Padding="10,0,10,0" PaletteElement="{DynamicResource Jade}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <IEL:IELTextBox x:Name="IELTextBoxKey" Grid.Row="2" BorderThickness="2,2,2,2" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Margin="5,5,5,5" PaletteElement="{DynamicResource PastelBlue}" CornerRadius="6,6,6,6" Padding="0,4,0,2"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="2" TextWrapping="Wrap" Text="При отсутствии ключа обратитесь к поставщику приложения" FontSize="17" TextAlignment="Center" FontStyle="Italic" FontFamily="{DynamicResource Bree CYR var}" Padding="5,5,5,5" Opacity="0.4"/>
        </Grid>

    </Grid>
</Base:OPLWindowBase>
