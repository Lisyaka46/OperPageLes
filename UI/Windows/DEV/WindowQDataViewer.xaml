<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Windows.DEV"
        xmlns:GUI="clr-namespace:IEL.UserElementsControl;assembly=IEL" x:Class="ApplicationOperPageLes.UI.Windows.DEV.WindowQDataViewer"
        mc:Ignorable="d"
        Title="WindowQDataViewer" MinHeight="400" MaxHeight="600" MinWidth="400" MaxWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.Resources>
                <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GUI:IELButtonText x:Name="IELSourceButton" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" FontFamily="{DynamicResource Bree CYR var}" Padding="5,5,5,5" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Text="Example Text" VerticalAlignment="Center" Margin="0,5,0,5"/>
                <CheckBox x:Name="CheckBoxIsEnabledController" Content="IsEnabled" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Top" Margin="0,5,0,5" BorderBrush="Black" Background="#FFFFB9B9" FontSize="16" Padding="4,-4,0,0" Grid.RowSpan="1"/>
                <ComboBox x:Name="ComboBoxSelectQData" Grid.Row="2" FontSize="14" FontFamily="{DynamicResource RussianRail G Pro}">
                    <ComboBoxItem Content="Background"/>
                    <ComboBoxItem Content="BorderBrush"/>
                    <ComboBoxItem Content="Foreground"/>
                </ComboBox>
            </Grid>
            <Border Grid.Row="1" BorderThickness="0,2,0,0" BorderBrush="Black">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="BorderDefaultSpectrum" Background="White" BorderBrush="Black" CornerRadius="5,5,5,5" BorderThickness="2,2,2,2" VerticalAlignment="Center" Grid.Row="0" Margin="30,5,30,5">
                        <TextBlock x:Name="TextBlockDefault" Text="Default" FontSize="16" Padding="20,5,20,5" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="BorderSelectSpectrum" Background="White" BorderBrush="Black" CornerRadius="5,5,5,5" BorderThickness="2,2,2,2" VerticalAlignment="Center" Grid.Row="1" Margin="30,5,30,5">
                        <TextBlock x:Name="TextBlockSelect" Text="Select" FontSize="16" Padding="20,5,20,5" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="BorderUsedSpectrum" Background="White" BorderBrush="Black" CornerRadius="5,5,5,5" BorderThickness="2,2,2,2" VerticalAlignment="Center" Grid.Row="2" Margin="30,5,30,5">
                        <TextBlock x:Name="TextBlockUsed" Text="Used" FontSize="16" Padding="20,5,20,5" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="BorderNotEnabledSpectrum" Background="White" BorderBrush="Black" CornerRadius="5,5,5,5" BorderThickness="2,2,2,2" VerticalAlignment="Center" Grid.Row="3" Margin="30,5,30,5">
                        <TextBlock x:Name="TextBlockNotEnabled" Text="NotEnabled" FontSize="16" Padding="20,5,20,5" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Column="1" BorderThickness="2,0,0,0" BorderBrush="Black">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.RowSpan="1">
                    <TextBlock x:Name="TextBlockCodeView" TextTrimming="WordEllipsis" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,0,5,0"/>
                </ScrollViewer>
                <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,2,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="ComboBoxSelectInitQData" Grid.Row="0"/>
                        <Button x:Name="InicializeQData" Content="Уканать созданную QData" VerticalAlignment="Top" Margin="5,5,5,5" FontSize="14" Padding="1,3,1,3" Grid.Row="1"/>
                        <Button x:Name="ReadFileQData" Content="Прочитать QData" VerticalAlignment="Top" Margin="5,5,5,5" FontSize="14" Padding="1,3,1,3" Grid.Row="2"/>
                        <Button x:Name="WriteFileQData" Content="Записать QData" VerticalAlignment="Top" Margin="5,5,5,5" FontSize="14" Padding="1,3,1,3" Grid.Row="3"/>
                        <TextBox x:Name="TextGeneratePalette" VerticalAlignment="Top" Margin="5,5,5,5" FontSize="14" Padding="1,3,1,3" Grid.Row="4"/>
                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ButtonBack" HorizontalAlignment="Center" VerticalAlignment="Center" Content="&lt;" Padding="5,5,5,5" Margin="5,5,5,5" Grid.Column="0"/>
                            <Button x:Name="ButtonCopyCode" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Копировать код" Padding="5,5,5,5" Margin="5,5,5,5" Grid.Column="1"/>
                            <Button x:Name="ButtonCreateCode" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Расчитать код" Padding="5,5,5,5" Margin="5,5,5,5" Grid.Column="2"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
