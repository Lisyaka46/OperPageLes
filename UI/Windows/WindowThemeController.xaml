<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Windows"
        xmlns:OPL="clr-namespace:OIEL.UserElementsControl;assembly=OIEL"
        xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=IEL"
        xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
        xmlns:Theme="clr-namespace:ApplicationOperPageLes.UI.UserElementsControl.Theme"
    x:Class="ApplicationOperPageLes.UI.Windows.WindowThemeController"
        mc:Ignorable="d"
        Title="Управление персонализацией" Height="450" Width="800" MinWidth="670" MinHeight="410">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0,0">
            <GradientStop Color="#FF6CD1E4"/>
            <GradientStop Color="#FF85C6D2" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid x:Name="MainGrid">
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="101*"/>
        </Grid.ColumnDefinitions>
        <Border BorderThickness="0,0,2,0" BorderBrush="Black" Width="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Theme:OPLThemeFile x:Name="DefaultPaletteElement" Grid.Row="0" PaletteElement="{DynamicResource Chocolate}" Margin="2,2,2,2" CornerRadius="12,12,12,12" TextNameFile="Default" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" SourceElement="/UI/Images/Palette.png" FontFamily="{DynamicResource Alphasano}" FontSize="18" IsActivate="True" Padding="0,2,0,2" Cursor="Hand"/>
                <Border x:Name="BorderCollectPalettes" Grid.Row="1" BorderThickness="0,2,0,2" BorderBrush="Black">
                    <IEL:IELScrollViewer x:Name="ScrollViewerTheme">
                        
                    </IEL:IELScrollViewer>
                </Border>
                <IEL:IELButtonText x:Name="IELCreateNewTheme" Grid.Row="2" Margin="5,5,5,5" PaletteElement="{DynamicResource SpruceColor}" FontFamily="{DynamicResource Bree CYR var}" Text="Создать тему" Padding="0,2,0,2" CornerRadius="5,5,5,5" Height="45" MarginViewBox="5,7,5,7"/>
            </Grid>
        </Border>
        <Grid x:Name="GridPaletteSpectrumViewer" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="1">
                <Grid.Resources>
                    <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextBlockNameSelectTheme" Text="Name Palette" VerticalAlignment="Center" Padding="5,10,5,0" FontSize="20" Grid.ColumnSpan="1" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource Deledda Open Regular}"/>
                    <IEL:IELButtonText x:Name="IELButtonBackViewTheme" Grid.Column="1" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Jade}" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" Text="Назад" Padding="0,2,0,2" Height="40" Margin="5,5,5,5"/>
                </Grid>
                <Border Grid.Row="1" BorderThickness="0,2,0,0" BorderBrush="#FF1D92D0">
                    <ScrollViewer>
                        <Grid x:Name="GridMainPaletteButtons">
                            <IEL:IELButtonText VerticalAlignment="Top" Margin="10,5,10,5" PaletteElement="{DynamicResource Red}" CornerRadius="8,8,8,8" CornerRadiusGuides="7.6,7.6,7.6,7.6" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16" Padding="0,2,0,2" Text="Red" Height="50" MarginViewBox="5,8,5,5"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border x:Name="BorderViewerQData" Grid.Column="2" Background="#FFD4D7FF" BorderThickness="2,0,0,0" BorderBrush="Black" Opacity="0.9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="GridWiewButtonQData" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <IEL:IELButtonText x:Name="IELExampleButtonPalette" FontSize="20" FontWeight="Bold" FontFamily="{DynamicResource Bree CYR var}" Padding="0,2,0,2" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Text="Пример" VerticalAlignment="Center" Margin="20,5,20,5" Grid.Row="0" PaletteElement="{DynamicResource Chocolate}" Height="45"/>
                        <CheckBox x:Name="CheckBoxEnabledExampleButtonPalette" Content="Включить кнопку" Grid.Row="1" VerticalAlignment="Top" Margin="0,5,0,5" BorderBrush="Black" Background="#FFFFB9B9" FontSize="16" Padding="4,-4,0,0" Grid.RowSpan="1" FontFamily="{DynamicResource Bree CYR var}" HorizontalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,2,0,0" BorderBrush="Black">
                        <Border.Background>
                            <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0">
                                <GradientStop Color="#FF84F7EA" Offset="1"/>
                                <GradientStop Color="#FFD4D7FF" Offset="0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="GridQdataStatesColor" HorizontalAlignment="Center" Grid.RowSpan="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="BorderD" CornerRadius="5,5,5,5" Margin="5,5,5,5" Padding="10,5,10,5" BorderBrush="Black" BorderThickness="2,2,2,2" Background="White" Cursor="Hand">
                                    <TextBlock x:Name="TextBlockD" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Text="Default" TextAlignment="Center"/>
                                </Border>
                                <Border x:Name="BorderS" CornerRadius="5,5,5,5" Margin="5,5,5,5" Padding="10,5,10,5" BorderBrush="Black" BorderThickness="2,2,2,2" Background="White" Grid.Row="1" Cursor="Hand">
                                    <TextBlock x:Name="TextBlockS" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Text="Select" TextAlignment="Center"/>
                                </Border>
                                <Border x:Name="BorderU" CornerRadius="5,5,5,5" Margin="5,5,5,5" Padding="10,5,10,5" BorderBrush="Black" BorderThickness="2,2,2,2" Background="White" Grid.Row="2" Cursor="Hand">
                                    <TextBlock x:Name="TextBlockU" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Text="Used" TextAlignment="Center"/>
                                </Border>
                                <Border x:Name="BorderNE" CornerRadius="5,5,5,5" Margin="5,5,5,5" Padding="10,5,10,5" BorderBrush="Black" BorderThickness="2,2,2,2" Background="White" Grid.Row="3" Cursor="Hand">
                                    <TextBlock x:Name="TextBlockNE" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Text="NotEnabled" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Здесь отображаются 4 состояния выбранного спектра палитры" HorizontalAlignment="Center" TextTrimming="WordEllipsis" TextWrapping="Wrap" TextAlignment="Center" FontFamily="{DynamicResource Bree CYR var}" Margin="3,0,3,5" Opacity="0.5"/>
                            <TextBlock Grid.Row="2" Text="Каждый спектр имеет настройку цвета для фона, границы и текста объекта" HorizontalAlignment="Center" TextTrimming="WordEllipsis" TextWrapping="Wrap" TextAlignment="Center" FontFamily="{DynamicResource Bree CYR var}" FontStyle="Italic" Margin="3,0,3,5" Opacity="0.5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="TextBlockNamingNoSelectPalette" Grid.Column="1" VerticalAlignment="Center" FontSize="16" Text="Здесь будет отображаться палитра темы" TextAlignment="Center" Opacity="0.4" FontFamily="{DynamicResource Deledda Open Regular}" FontStyle="Italic" Panel.ZIndex="-1"/>
        <IEL:IELPanelAction x:Name="PanelActionMain" Width="120" Height="200" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource PastelBlue}" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="204,130,0,0"/>
    </Grid>
</Window>
