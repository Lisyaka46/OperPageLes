<Window x:Class="ApplicationOperPageLes.UI.Windows.WindowThemeController"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationOperPageLes.UI.Windows"
        xmlns:OPL="clr-namespace:ApplicationOperPageLes.UI.UserElementControl"
        xmlns:IEL="clr-namespace:IEL.GUI;assembly=IEL"
        xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL"
        mc:Ignorable="d"
        Title="Управление персонализацией" Height="450" Width="800">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0,0">
            <GradientStop Color="#FF6CD1E4"/>
            <GradientStop Color="#FF85C6D2" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="101*"/>
            <ColumnDefinition x:Name="ColumnDefinitionQDataViewer" Width="200" MaxWidth="200"/>
        </Grid.ColumnDefinitions>
        <Border BorderThickness="0,0,2,0" BorderBrush="Black" Width="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <OPL:OPLImageViewer x:Name="DefaultPaletteElement" HorizontalAlignment="Stretch" Margin="5,5,5,5" CornerRadius="12,12,12,12" PaletteElement="{DynamicResource Cocoa}" Source="/UI/Images/IconMainApplication.png" Text="DefaultPalette" FontSize="14"/>
                <Border x:Name="BorderCollectPalettes" Grid.Row="1" BorderThickness="0,2,0,0" BorderBrush="#FF1D92D0">
                    <ScrollViewer>
                        <Grid x:Name="GridThemes">
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
        <Grid x:Name="GridPaletteSpectrumViewer" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.Resources>
                <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="479*"/>
                    <ColumnDefinition Width="76*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextBlockNameSelectTheme" Text="Name Palette" VerticalAlignment="Center" Padding="5,10,5,10" FontSize="20" Grid.ColumnSpan="1"/>
                <IEL:IELButtonImage x:Name="IELButtonSaveTheme" Grid.Column="2" Width="35" PaletteElement="{DynamicResource Green}" CornerRadius="8,8,8,8" Source="/UI/Images/Save.png" Padding="2,0,2,0" Height="35" Margin="5,6,5,6"/>
                <IEL:IELButtonText x:Name="IELButtonBackViewTheme" Grid.Column="1" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource Jade}" FontSize="16" FontFamily="{DynamicResource Bree CYR var}" Text="Назад" VerticalAlignment="Center" Margin="5,0,5,0" Padding="0,5,0,5"/>
            </Grid>
            <Border Grid.Row="1" BorderThickness="0,2,0,0" BorderBrush="#FF1D92D0">
                <ScrollViewer>
                    <Grid x:Name="GridMainPaletteButtons">
                        <IEL:IELButtonText VerticalAlignment="Top" Margin="10,5,10,5" PaletteElement="{DynamicResource Red}" CornerRadius="8,8,8,8" CornerRadiusGuides="7.6,7.6,7.6,7.6" FontFamily="{DynamicResource Bree CYR var}" FontSize="18" Padding="0,5,0,5" Text="Red"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
        <IEL:IELPanelAction x:Name="PanelActionMain" Width="120" Height="200" Margin="134,130,251,104" CornerRadius="5,5,5,5" PaletteElement="{DynamicResource PastelBlue}" Grid.ColumnSpan="3"/>
        <Border x:Name="BorderViewerQData" Grid.Column="2" Background="#FFD4D7FF" BorderThickness="2,0,0,0" BorderBrush="Black">
            <Grid>
                <Grid.Resources>
                    <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="Black" BorderThickness="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <IEL:IELButtonText x:Name="IELButtonBackViewQData" Margin="5,5,5,5" CornerRadius="5,5,5,5" CornerRadiusGuides="7.6,7.6,7.6,7.6" PaletteElement="{DynamicResource Jade}" FontFamily="{DynamicResource Bree CYR var}" Text="Назад" VisualGuide="RightArrow" Padding="0,2,0,2" FontSize="14"/>
                        </Grid>
                    </Border>
                    <IEL:IELButtonText x:Name="IELExampleButtonPalette" FontSize="20" FontWeight="Bold" FontFamily="{DynamicResource Bree CYR var}" Padding="5,5,5,5" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Text="Пример" VerticalAlignment="Center" Margin="20,5,20,5" Grid.Row="1" PaletteElement="{DynamicResource Chocolate}" Height="45"/>
                    <CheckBox x:Name="CheckBoxEnabledExampleButtonPalette" Content="Вклюсить кнопку" Grid.Row="2" VerticalAlignment="Top" Margin="0,5,0,5" BorderBrush="Black" Background="#FFFFB9B9" FontSize="16" Padding="4,-4,0,0" Grid.RowSpan="1" FontFamily="{DynamicResource Bree CYR var}" HorizontalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="1" BorderThickness="0,2,0,0" BorderBrush="Black">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0">
                            <GradientStop Color="#FF84F7EA" Offset="1"/>
                            <GradientStop Color="#FFD4D7FF" Offset="0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="BorderD" CornerRadius="5,5,5,5" Margin="5,5,5,5" Padding="10,5,10,5" BorderBrush="Black" BorderThickness="2,2,2,2" Background="White">
                            <TextBlock x:Name="TextBlockD" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Text="Default" TextAlignment="Center"/>
                        </Border>
                        <Border x:Name="BorderS" CornerRadius="5,5,5,5" Margin="5,5,5,5" Padding="10,5,10,5" BorderBrush="Black" BorderThickness="2,2,2,2" Background="White" Grid.Row="1">
                            <TextBlock x:Name="TextBlockS" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Text="Select" TextAlignment="Center"/>
                        </Border>
                        <Border x:Name="BorderU" CornerRadius="5,5,5,5" Margin="5,5,5,5" Padding="10,5,10,5" BorderBrush="Black" BorderThickness="2,2,2,2" Background="White" Grid.Row="2">
                            <TextBlock x:Name="TextBlockU" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Text="Used" TextAlignment="Center"/>
                        </Border>
                        <Border x:Name="BorderNE" CornerRadius="5,5,5,5" Margin="5,5,5,5" Padding="10,5,10,5" BorderBrush="Black" BorderThickness="2,2,2,2" Background="White" Grid.Row="3">
                            <TextBlock x:Name="TextBlockNE" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}" Text="NotEnabled" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
