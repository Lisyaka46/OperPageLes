<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperPage_les.UI.Dialogs"
        xmlns:gif="http://wpfanimatedgif.codeplex.com" x:Class="OperPage_les.UI.Dialogs.LicenseWindow"
        mc:Ignorable="d" Background="{x:Null}" Height="450" Width="300" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" Foreground="{x:Null}">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Border CornerRadius="20,20,20,20" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#B21F846F" Offset="0.36"/>
                <GradientStop Color="#FF566A94" Offset="0.991"/>
                <GradientStop Color="#E5827C82" Offset="0.625"/>
                <GradientStop Color="#66758868" Offset="0.083"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid ClipToBounds="True">
            <Grid ClipToBounds="True">
                <Grid.Effect>
                    <BlurEffect x:Name="BlurEffectAllGrid" Radius="0" RenderingBias="Quality" KernelType="Gaussian"/>
                </Grid.Effect>
                <Grid.RowDefinitions>
                    <RowDefinition Height="19*"/>
                    <RowDefinition Height="31*"/>
                </Grid.RowDefinitions>
                <Grid Margin="7,0,7,0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="ImageLogo" Source="/UI/Images/IconMainApplication.png" RenderTransformOrigin="0.5,0.5" Grid.RowSpan="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,10,10">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform x:Name="RotateTransformImageIconApplication" Angle="0"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="Oper Page les" VerticalAlignment="Bottom" FontSize="20" FontFamily="{DynamicResource Plup}" Padding="5,0,0,0">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                            <GradientStop Color="#FFFB9FB1" Offset="0.202"/>
                                            <GradientStop Color="#FF50FEA5" Offset="0.907"/>
                                            <GradientStop Color="#FFCBAEFC" Offset="0.711"/>
                                            <GradientStop Color="#FFCBAEFC" Offset="0.431"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Text="19-04-22" VerticalAlignment="Bottom" FontFamily="{DynamicResource Plup}" Grid.ColumnSpan="1" Grid.Column="1" HorizontalAlignment="Right" FontSize="14">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush EndPoint="2,1" StartPoint="0,0">
                                            <GradientStop Color="#FF71CFFF"/>
                                            <GradientStop Color="#FF8C6CFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Grid>
                        </Grid>
                        <Border Grid.Row="1" BorderThickness="0,3,0,0" Margin="0,5,0,0">
                            <Border.BorderBrush>
                                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                    <GradientStop Color="#FFC88F9A" Offset="0.202"/>
                                    <GradientStop Color="#FF5BA27E" Offset="0.741"/>
                                    <GradientStop Color="#FFC2B5D8" Offset="0.431"/>
                                    <GradientStop Color="#00C88F9A" Offset="0.019"/>
                                    <GradientStop Color="#005BA27E" Offset="0.864"/>
                                    <GradientStop Color="#FFA896C7" Offset="0.614"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TextBlockVersion" TextWrapping="Wrap" Text="Версия: debug" VerticalAlignment="Center" FontFamily="{DynamicResource Plup}" Panel.ZIndex="1" Padding="5,2,0,2" HorizontalAlignment="Right" Grid.Row="0" FontSize="14">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush EndPoint="2,1" StartPoint="0,0">
                                            <GradientStop Color="#FF71CFFF"/>
                                            <GradientStop Color="#FF8C6CFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock x:Name="TextBlockLicenseAutor" TextWrapping="Wrap" Text="Автор: Даниил Лисов" FontSize="18"  Grid.Row="2" HorizontalAlignment="Center" Padding="2,2,2,2" VerticalAlignment="Center" FontFamily="{DynamicResource Monocraft}">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush EndPoint="0,1" StartPoint="1,0.3">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TransformGroup>
                                                    <RotateTransform x:Name="RotateTransformTextAutor" Angle="0" CenterX="0.5" CenterY="0.5"/>
                                                </TransformGroup>
                                            </LinearGradientBrush.RelativeTransform>
                                            <GradientStop Color="#FFFF8686" Offset="0.075"/>
                                            <GradientStop Color="#FFFF9CFB" Offset="0.89"/>
                                            <GradientStop Color="#FFD5FBDE" Offset="0.445"/>
                                            <GradientStop Color="#FFBCD847" Offset="0.647"/>
                                            <GradientStop Color="#FF5A9EEA" Offset="0.305"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <Grid x:Name="MainGrid" ClipToBounds="True" Grid.Row="2">
                    <Grid.OpacityMask>
                        <RadialGradientBrush MappingMode="RelativeToBoundingBox" GradientOrigin="0.5,0" Center="0.5,0.36" RadiusX="0.7" RadiusY="0.8">
                            <GradientStop Color="Black" Offset="0.012"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                            <GradientStop Color="Black" Offset="0.96"/>
                        </RadialGradientBrush>
                    </Grid.OpacityMask>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Image x:Name="ImageIconNickName" Grid.Row="0" Grid.RowSpan="2" Opacity="0.48" Panel.ZIndex="-1" Source="/UI/Images/Autor/VECTOR.jpg" Margin="-10,-10,-10,-10"/>
                    <Border x:Name="BorderNickName" BorderBrush="Black" BorderThickness="2,2,2,2">
                        <Grid Background="#99477563">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MaxWidth="90"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TextBlockNickName" Text="Мяу" FontSize="18"  FontWeight="Bold" Foreground="#FF56FF78" TextAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="1" Padding="5,0,5,0" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource Tablon}" TextWrapping="WrapWithOverflow"/>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TextBlockPhrase" Text="A" FontStyle="Italic" Foreground="#FFC3BDDE" Grid.RowSpan="1" TextDecorations="Underline" Grid.Row="1" Padding="2,7,2,2" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                <TextBlock Text="Фраза:" FontStyle="Italic" FontWeight="Bold" HorizontalAlignment="Left" FontSize="15" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" Padding="0,7,0,0" TextWrapping="WrapWithOverflow"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Background="#994C67A9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TextBlockMessage" Text="- за." FontStyle="Italic" Foreground="#FFC3BDDE" Grid.RowSpan="1" Panel.ZIndex="0" Grid.Row="1" FontSize="14"/>
                        <TextBlock Text="Благодарен за:" FontStyle="Italic" FontWeight="Bold" Foreground="#FF171717" FontSize="16" Padding="2,0,4,0" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>
            </Grid>
            <Grid x:Name="GridHappy" ClipToBounds="True" Margin="7,7,7,7" Visibility="Hidden">
                <Border x:Name="BorderHappy" Panel.ZIndex="0" Background="#B2446363" BorderBrush="Black" BorderThickness="3,3,3,3" Margin="5,5,5,5" CornerRadius="10,10,10,10">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ScaleEffectElement" ScaleX="1" ScaleY="1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <TextBlock x:Name="TextBlockHappyYear" FontSize="18" Text="Системе исполнитось Х годиков" Padding="10,5,10,5" FontFamily="{DynamicResource RussianRail G Pro}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Top" Margin="8,40,8,0" MaxWidth="260" MinWidth="260" Panel.ZIndex="1">
                            <TextBlock.Foreground>
                                <LinearGradientBrush EndPoint="0.7,1" StartPoint="0.3,0">
                                    <GradientStop Color="#FF11FAFF"/>
                                    <GradientStop Color="#FFBFC6F9" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <MediaElement x:Name="MediaHappy" UnloadedBehavior="Manual" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <MediaElement.OpacityMask>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#00000000"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                    <GradientStop Color="#99000000" Offset="0.08"/>
                                    <GradientStop Color="#99000000" Offset="0.92"/>
                                    <GradientStop Color="#E5000000" Offset="0.7"/>
                                    <GradientStop Color="#E5000000" Offset="0.3"/>
                                </LinearGradientBrush>
                            </MediaElement.OpacityMask>
                        </MediaElement>
                        <TextBlock x:Name="TextBlockNextInfo" Text="Нажмите чтобы продолжить" Padding="10,5,10,5" FontFamily="{DynamicResource RussianRail G Pro}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" MaxWidth="260" MinWidth="260" Panel.ZIndex="1" Margin="5,0,5,5" FontStyle="Italic">
                            <TextBlock.Foreground>
                                <LinearGradientBrush EndPoint="0.7,1" StartPoint="0.3,0">
                                    <GradientStop Color="#FF75827E" Offset="0.015"/>
                                    <GradientStop Color="#FF34827D" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
