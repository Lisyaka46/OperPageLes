<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperPage_les.UI.Dialogs"
        xmlns:gif="http://wpfanimatedgif.codeplex.com" x:Class="OperPage_les.UI.Dialogs.LicenseWindow"
        mc:Ignorable="d" Background="#FF4D735E" Height="450" Width="300" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Topmost="True" Icon="{Binding Mode=OneWay, Source={StaticResource EmptyImage}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="152*"/>
            <RowDefinition Height="153*"/>
            <RowDefinition Height="129*"/>
        </Grid.RowDefinitions>
        <Image x:Name="ImageLogo" HorizontalAlignment="Center" Source="/UI/Images/LogoProgram.png" Margin="0,20,0,20"/>
        <Frame x:Name="FrameLicense" Content="" NavigationUIVisibility="Hidden" Grid.RowSpan="2" Margin="0,147,0,0"/>
        <Frame x:Name="FrameThanks" Content="" Grid.Row="2" NavigationUIVisibility="Hidden" Padding="3,0,3,0" Margin="-4,1,-4,0"/>

    </Grid>
</Window>
