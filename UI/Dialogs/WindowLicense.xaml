<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperPage_les.UI.Dialogs"
        xmlns:gif="http://wpfanimatedgif.codeplex.com" x:Class="OperPage_les.UI.Dialogs.LicenseWindow"
        mc:Ignorable="d" Background="{x:Null}" Height="450" Width="300" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" Foreground="{x:Null}">
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/VisualDictionary.xaml"/>
    </Window.Resources>
    <Border CornerRadius="20,20,20,20" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#A51F846F" Offset="0.36"/>
                <GradientStop Color="#FF566A94" Offset="0.991"/>
                <GradientStop Color="#E5827C82" Offset="0.625"/>
                <GradientStop Color="#19758868" Offset="0.083"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid ClipToBounds="True">
            <Grid ClipToBounds="True">
                <Grid.Effect>
                    <BlurEffect x:Name="BlurEffectAllGrid" Radius="10" RenderingBias="Quality" KernelType="Gaussian"/>
                </Grid.Effect>
                <Grid.RowDefinitions>
                    <RowDefinition Height="19*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="31*"/>
                </Grid.RowDefinitions>

                <Grid Margin="7,0,7,0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Image x:Name="ImageLogo" HorizontalAlignment="Center" Source="/UI/Images/IconMainApplication.png" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Grid.RowSpan="1">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform x:Name="RotateTransformImageIconApplication" Angle="0"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Grid x:Name="GridNamingProgramm" Grid.Row="1">
                        <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Oper Page les" VerticalAlignment="Center" FontSize="25" Padding="10,3,10,3"  HorizontalAlignment="Center" FontFamily="{DynamicResource Plup}">
                            <TextBlock.Foreground>
                                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                    <GradientStop Color="#FFFB9FB1" Offset="0.202"/>
                                    <GradientStop Color="#FF50FEA5" Offset="0.907"/>
                                    <GradientStop Color="#FFCBAEFC" Offset="0.711"/>
                                    <GradientStop Color="#FFCBAEFC" Offset="0.431"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="TextBlockVersion" HorizontalAlignment="Left" TextWrapping="Wrap" Text="debug" VerticalAlignment="Top" Padding="2,2,2,2" FontFamily="{DynamicResource Plup}">
                        <TextBlock.Foreground>
                            <LinearGradientBrush EndPoint="2,1" StartPoint="0,0">
                                <GradientStop Color="#FF71CFFF"/>
                                <GradientStop Color="#FF8C6CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap" Text="19-04-22" VerticalAlignment="Top" Padding="2,2,2,2" FontFamily="{DynamicResource Plup}">
                        <TextBlock.Foreground>
                            <LinearGradientBrush EndPoint="2,1" StartPoint="0,0">
                                <GradientStop Color="#FF71CFFF"/>
                                <GradientStop Color="#FF8C6CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>
                <Grid Grid.RowSpan="1" Grid.Row="1">
                    <TextBlock x:Name="TextBlockLicenseAutor" TextWrapping="Wrap" Text="Автор: Даниил Лисов" FontSize="16"  Grid.Row="0" HorizontalAlignment="Center" Padding="2,2,2,2" VerticalAlignment="Center" FontFamily="{DynamicResource Monocraft}">
                        <TextBlock.Foreground>
                            <LinearGradientBrush EndPoint="0,1" StartPoint="1,0.3">
                                <LinearGradientBrush.RelativeTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="RotateTransformTextAutor" Angle="0" CenterX="0.5" CenterY="0.5"/>
                                    </TransformGroup>
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#FFFF8686" Offset="0.075"/>
                                <GradientStop Color="#FFFF9CFB" Offset="0.89"/>
                                <GradientStop Color="#FFD5FBDE" Offset="0.445"/>
                                <GradientStop Color="#FFBCD847" Offset="0.647"/>
                                <GradientStop Color="#FF5A9EEA" Offset="0.305"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>
                <Frame x:Name="FrameThanks" Grid.Row="2" NavigationUIVisibility="Hidden" Focusable="False">
                    <Frame.OpacityMask>
                        <RadialGradientBrush RadiusX="1.1" RadiusY="1.1" Center="0.5,0" GradientOrigin="0.5,0">
                            <GradientStop Color="Black" Offset="0.879"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Frame.OpacityMask>
                </Frame>
            </Grid>
            <Grid ClipToBounds="True" Margin="7,7,7,7">
                <Border x:Name="BorderHappy" Panel.ZIndex="0" Background="#B2446363" BorderBrush="Black" BorderThickness="3,3,3,3" Margin="5,5,5,5" CornerRadius="10,10,10,10">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ScaleEffectElement" ScaleX="1" ScaleY="1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <TextBlock x:Name="TextBlockHappyYear" FontSize="18" Text="Системе исполнитось Х годиков" Padding="10,5,10,5" FontFamily="{DynamicResource RussianRail G Pro}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Top" Margin="8,40,8,0" MaxWidth="260" MinWidth="260" Panel.ZIndex="1">
                            <TextBlock.Foreground>
                                <LinearGradientBrush EndPoint="0.7,1" StartPoint="0.3,0">
                                    <GradientStop Color="#FF11FAFF"/>
                                    <GradientStop Color="#FFBFC6F9" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <MediaElement x:Name="MediaHappy" UnloadedBehavior="Manual" Stretch="UniformToFill" Source="/UI/Images/Media/Happy.mp4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <MediaElement.OpacityMask>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#00000000"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                    <GradientStop Color="#99000000" Offset="0.08"/>
                                    <GradientStop Color="#99000000" Offset="0.92"/>
                                    <GradientStop Color="#E5000000" Offset="0.7"/>
                                    <GradientStop Color="#E5000000" Offset="0.3"/>
                                </LinearGradientBrush>
                            </MediaElement.OpacityMask>
                        </MediaElement>
                        <TextBlock x:Name="TextBlockNextInfo" Text="Нажмите чтобы продолжить" Padding="10,5,10,5" FontFamily="{DynamicResource RussianRail G Pro}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" MaxWidth="260" MinWidth="260" Panel.ZIndex="1" Margin="5,0,5,5" FontStyle="Italic">
                            <TextBlock.Foreground>
                                <LinearGradientBrush EndPoint="0.7,1" StartPoint="0.3,0">
                                    <GradientStop Color="#FF75827E" Offset="0.015"/>
                                    <GradientStop Color="#FF34827D" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
