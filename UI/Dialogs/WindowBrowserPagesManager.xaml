<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperPage_les.UI.Dialogs"
        xmlns:IEL="clr-namespace:IEL;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" xmlns:ObjectSettings="clr-namespace:IEL.CORE.Classes.ObjectSettings;assembly=IEL" x:Class="OperPage_les.UI.Dialogs.WindowBrowserPagesManager"
        mc:Ignorable="d"
        Title="Выбор открывающей страницы" Height="500" Width="300" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"  ShowInTaskbar="False" Topmost="True" SnapsToDevicePixels="True" Padding="4,4,4,4" UseLayoutRounding="True" WindowStyle="None" AllowsTransparency="True">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF5F9064" Offset="1"/>
            <GradientStop Color="#FF60B6C7" Offset="0"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <ResourceDictionary Source="/CORE/Resources/FontsDictionary.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.3">
                <LinearGradientBrush.RelativeTransform>
                    <TransformGroup>
                        <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                        <SkewTransform CenterX="0.5" CenterY="0.5"/>
                        <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FFC5C5C5" Offset="0.014"/>
                <GradientStop Color="#FFE660AF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid x:Name="GridMainPages" Grid.RowSpan="1">
            <Border BorderThickness="2,2,2,2" BorderBrush="#4CC74379" CornerRadius="0,0,5,5">
                <Grid x:Name="GridScrollPages">
                    <IEL:IELButtonText x:Name="IELButtonAddPageLabel" VerticalAlignment="Top" Height="50" BorderThicknessBlock="3,3,3,3" Text="Страница ярлыков" CornerRadius="6,6,6,6" Margin="5,5,5,0" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16">
                        <IEL:IELButtonText.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                    <Classes:BrushSettingQ/>
                                </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                                </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#FF69819C" Select="#FF86AEDA" Used="#FF0CCCB6" NotEnabled="#FFAD354B"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </IEL:IELButtonText.IELSettingObject>
                    </IEL:IELButtonText>
                    <IEL:IELButtonText x:Name="IELButtonPageDeveloper" VerticalAlignment="Top" Height="50" BorderThicknessBlock="3,3,3,3" Text="Страница разработчика" CornerRadius="6,6,6,6" Margin="5,60,5,0" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16">
                        <IEL:IELButtonText.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                    <Classes:BrushSettingQ/>
                                </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                                </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#FFCE6BBD" Select="#FFD592E0" Used="#FFFBE5FF" NotEnabled="#FFAD354B"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </IEL:IELButtonText.IELSettingObject>
                    </IEL:IELButtonText>
                    <IEL:IELButtonText x:Name="IELButtonPageConsole" VerticalAlignment="Top" Height="50" BorderThicknessBlock="3,3,3,3" Text="Страница консоли" CornerRadius="6,6,6,6" Margin="5,115,5,0" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16">
                        <IEL:IELButtonText.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#FF969671" NotEnabled="#FFAD354B" Select="#FFC3C37F" Used="#FFE0E0BD"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                    <Classes:BrushSettingQ/>
                                </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                                </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </IEL:IELButtonText.IELSettingObject>
                    </IEL:IELButtonText>
                    <IEL:IELButtonText x:Name="IELButtonPageBrowser" VerticalAlignment="Top" Height="50" BorderThicknessBlock="3,3,3,3" Text="Страница веб-браузера" CornerRadius="6,6,6,6" Margin="5,173,5,0" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16">
                        <IEL:IELButtonText.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#FF5EACC7" NotEnabled="#FFAD354B" Select="#FF59D4FF" Used="#FFD6E2E6"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                    <Classes:BrushSettingQ/>
                                </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                                </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </IEL:IELButtonText.IELSettingObject>
                    </IEL:IELButtonText>
                    <IEL:IELButtonText x:Name="IELButtonGenerate" VerticalAlignment="Top" Height="50" BorderThicknessBlock="3,3,3,3" Text="NEW" CornerRadius="6,6,6,6" Margin="5,236,5,0" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16">
                        <IEL:IELButtonText.IELSettingObject>
                            <ObjectSettings:IELButtonObjectSetting>
                                <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                    <Classes:BrushSettingQ Default="#FF5EACC7" NotEnabled="#FFAD354B" Select="#FF59D4FF" Used="#FFD6E2E6"/>
                                </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                    <Classes:BrushSettingQ/>
                                </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                                <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                                    <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                                </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                            </ObjectSettings:IELButtonObjectSetting>
                        </IEL:IELButtonText.IELSettingObject>
                    </IEL:IELButtonText>
                </Grid>
            </Border>
        </Grid>
        <IEL:IELButtonText x:Name="IELButtonCancel" BorderThicknessBlock="3,3,3,3" Text="Отмена добавления" CornerRadius="6,6,6,6"  Grid.Row="1" Margin="5,5,5,5" FontFamily="{DynamicResource Deledda Open Regular}" FontSize="16">
            <IEL:IELButtonText.IELSettingObject>
                <ObjectSettings:IELButtonObjectSetting>
                    <ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                        <Classes:BrushSettingQ Default="#FFC86C40" NotEnabled="#FFAD354B" Select="#FFF19569" Used="#FFECDDAB"/>
                    </ObjectSettings:IELButtonObjectSetting.BackgroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                        <Classes:BrushSettingQ/>
                    </ObjectSettings:IELButtonObjectSetting.ForegroundSetting>
                    <ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                        <Classes:BrushSettingQ NotEnabled="#FF480000" Used="#FF3E3E3E" Select="#FF1F1F1F"/>
                    </ObjectSettings:IELButtonObjectSetting.BorderBrushSetting>
                </ObjectSettings:IELButtonObjectSetting>
            </IEL:IELButtonText.IELSettingObject>
        </IEL:IELButtonText>
    </Grid>
</Window>
