<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperPage_les.UI.Dialogs"
        xmlns:IEL="clr-namespace:IEL;assembly=IEL" x:Class="OperPage_les.UI.Dialogs.WindowSetting"
        mc:Ignorable="d"
        Title="WindowSetting" Height="450" Width="800" MinWidth="650" MinHeight="400" Background="{x:Null}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF6C7565" Offset="0"/>
                <GradientStop Color="#FF3D4437" Offset="1"/>
                <GradientStop Color="#FF6D845D" Offset="0.317"/>
                <GradientStop Color="#FF657B56" Offset="0.694"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="121*"/>
                <ColumnDefinition Width="679*"/>
            </Grid.ColumnDefinitions>
            <IEL:IELButtonText x:Name="IELGeneralButton" Margin="6,0,6,6" CornerRadius="0,0,8,8" VisibleMouseImaging="False" Style="{Binding Mode=OneWay, Source={StaticResource Vollda}}" Text="Общие" AnimationMillisecond="160" BorderThicknessBlock="3,0,3,3"/>
        </Grid>
        <Grid Grid.Row="1">
            <IEL:IELPageController x:Name="MainPageController" RightAnimateSwitch="10,3,0,0" LeftAnimateSwitch="-10,3,0,0"/>
        </Grid>
    </Grid>
</Window>
