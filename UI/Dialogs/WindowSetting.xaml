<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OperPage_les.UI.Dialogs"
        xmlns:IEL="clr-namespace:IEL;assembly=IEL" xmlns:Classes="clr-namespace:IEL.CORE.Classes;assembly=IEL" x:Class="OperPage_les.UI.Dialogs.WindowSetting"
        mc:Ignorable="d"
        Title="Настройки программы" Height="450" Width="800" MinWidth="650" MinHeight="400" Background="{x:Null}" Icon="/UI/Images/IconMainSettings.png">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF657275" Offset="0"/>
                <GradientStop Color="#FF375A4F" Offset="1"/>
                <GradientStop Color="#FF687077" Offset="0.317"/>
                <GradientStop Color="#FF60695A" Offset="0.694"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.OpacityMask>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#00000000" Offset="0.01"/>
                    <GradientStop Color="Black" Offset="0.25"/>
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <IEL:IELButtonText x:Name="IELGeneralButton" Margin="5,0,5,10" CornerRadius="0,0,8,8" Text="Общие" BorderThicknessBlock="3,0,3,3" Style="{Binding Mode=OneWay, Source={StaticResource Vollda}}" FontSize="16" PaddingContent="5,0,5,0">
                <!--<IEL:IELButtonText.BackgroundSetting>
                    <Classes:BrushSettingQ Default="#FF3A906D" NotEnabled="#FFFFB08E" Select="#FF90B7DB" Used="#FFB3EB8B"/>
                </IEL:IELButtonText.BackgroundSetting>
                <IEL:IELButtonText.BorderBrushSetting>
                    <Classes:BrushSettingQ Default="#FF3D3D3D" NotEnabled="#FF26537C" Select="#FF529423" Used="#FFBF5D30"/>
                </IEL:IELButtonText.BorderBrushSetting>
                <IEL:IELButtonText.ForegroundSetting>
                    <Classes:BrushSettingQ Default="#FF1F1F1F" NotEnabled="#FF26537C" Select="#FF529423" Used="#FFBF5D30"/>
                </IEL:IELButtonText.ForegroundSetting>-->
            </IEL:IELButtonText>
        </Grid>
        <Grid Grid.Row="1">
            <Border x:Name="BorderElement" ScrollViewer.VerticalScrollBarVisibility="Disabled" BorderThickness="0,3,0,0" BorderBrush="Black">
                <ScrollViewer x:Name="ScrollViewerPageSettings" VerticalScrollBarVisibility="Auto" PanningRatio="0.3">
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#00000000" Offset="1"/>
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.94"/>
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <Grid ClipToBounds="True" Margin="0,-5,0,-5">
                        <IEL:IELPageController x:Name="MainPageController" RightAnimateSwitch="10,3,0,0" LeftAnimateSwitch="-10,3,0,0" Grid.ColumnSpan="1" Panel.ZIndex="-1" Padding="0,5,0,5"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
