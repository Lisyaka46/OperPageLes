<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AAC20.UI.Dialogs"
        xmlns:IEL="clr-namespace:IEL;assembly=IEL" x:Class="AAC20.UI.Dialogs.WindowSetting"
        mc:Ignorable="d"
        Title="WindowSetting" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <IEL:IELButtonText x:Name="IELGeneralButton" HorizontalAlignment="Left" Margin="19,0,0,0" VerticalAlignment="Top" Width="80" CornerRadius="0,0,8,8" Height="35" VisibleMouseImaging="False" Style="{Binding Mode=OneWay, Source={StaticResource Vollda}}" Text="Общие" AnimationMillisecond="160"/>
        </Grid>
        <Grid Grid.Row="1">
            <IEL:IELFrameDefault x:Name="IELFrameSetting"/>
        </Grid>

    </Grid>
</Window>
