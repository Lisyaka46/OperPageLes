<Base:IELContainerBase
    x:Class="ApplicationOperPageLes.UI.UserElementsControl.OPLCommandViewer"
    xmlns:Base="clr-namespace:IEL.UserElementsControl.Base;assembly=IEL"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ApplicationOperPageLes.UI.UserElementsControl"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=IEL">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/CORE/Resources/PaletteDictionary.xaml"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="GridContainer" Grid.RowSpan="1" Grid.Row="1">
            <TextBlock>
                <Underline>
                    <Run>>>> figh</Run>
                </Underline>
                <LineBreak/>
                <Underline>
                    <Run>>>> figh</Run>
                </Underline>
                <LineBreak/>
                <Span>
                    <Run>dkfgjh</Run>
                    <LineBreak/>
                    <Run>dkjfhg</Run>
                </Span>
            </TextBlock>
        </Grid>
        <Border x:Name="BorderInfo" Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="Black">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <IEL:IELButtonImage x:Name="IELButtonDeleteElement" Margin="4,4,4,4" PaletteElement="{DynamicResource Tangerine}" CornerRadius="5,5,5,5" Source="/UI/Images/Cross.png" MarginViewBox="1,1,1,1"/>
                <MediaElement x:Name="IndicatorLoading" Stretch="UniformToFill" IsHitTestVisible="False" Grid.ColumnSpan="1" Grid.Column="0" Width="14" Height="14" Source="/UI/Images/Media/Loading/LoadingDefault.mp4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-2,0" UnloadedBehavior="Manual">
                    <MediaElement.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="Black" Offset="0.709"/>
                            <GradientStop Color="#00000000" Offset="0.844"/>
                        </RadialGradientBrush>
                    </MediaElement.OpacityMask>
                </MediaElement>
                <Viewbox Grid.Column="1" Grid.ColumnSpan="1" Margin="0,8,0,4">
                    <TextBlock x:Name="TextBlockNameCommand" Text="Text2" FontFamily="{DynamicResource RussianRail G Pro}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</Base:IELContainerBase>
