<UserControl
    x:Class="OperPageLes.UI.UserElementsControl.Default.OPLCheckAudioDevice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:OperPageLes.UI.UserElementsControl.Default"
    xmlns:Base="clr-namespace:IEL.UserElementsControl.Base;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    FontSize="16">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border x:FieldModifier="private" x:Name="BorderActive" Width="20" Height="20" BorderThickness="2,2,2,2" CornerRadius="5,5,5,5" BorderBrush="Black" Grid.ColumnSpan="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Background>
                <ImageBrush x:FieldModifier="private" x:Name="ImageBrushIcon" Stretch="UniformToFill">
                    <ImageBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScaleTransformIcon" CenterY="0.5" CenterX="0.5" ScaleX="0.8" ScaleY="0.8"/>
                            <SkewTransform CenterX="0.5" CenterY="0.5"/>
                            <RotateTransform CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Border.Background>
        </Border>
        <IEL:IELButtonText x:FieldModifier="private" x:Name="DeviceButton" Grid.Column="1" CornerRadius="5,5,5,5" Margin="2,2,2,2" Text="Device" MarginViewBox="3,3,3,3" FontFamily="{DynamicResource Deledda Open Regular}" Height="25"/>
    </Grid>
</UserControl>
