<Base:IELContainerBase
    x:Class="OperPageLes.UI.UserElementsControl.Default.OPLLangParameter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Base="clr-namespace:IEL.UserElementsControl.Base;assembly=LibraryIEL"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock x:FieldModifier="private" x:Name="TextBlockNotTraslationInfo" TextAlignment="Right" Text="Не переведено" VerticalAlignment="Center" Padding="0,0,5,2" FontFamily="{DynamicResource RussianRail G Pro}"/>
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Viewbox StretchDirection="DownOnly">
                <StackPanel VerticalAlignment="Center" Margin="5,0,5,0">
                    <TextBlock x:FieldModifier="private" x:Name="TextBlockValueLangExample" HorizontalAlignment="Left" FontSize="14" FontFamily="{DynamicResource Alphasano}" MaxWidth="200">
                        <Run>"</Run><Run>Ключ</Run><Run>"</Run>
                    </TextBlock>
                    <TextBlock x:FieldModifier="private" x:Name="TextBlockLangKey" Text="Enum.Key" HorizontalAlignment="Left" FontSize="14" FontFamily="{DynamicResource Brenzo Slab Personal Use}" MaxWidth="200"/>
                </StackPanel>
            </Viewbox>
            <IEL:IELTextBox x:FieldModifier="private" x:Name="IELTextBoxLangValueTranslate" Grid.Column="1" FontSize="18" Padding="0,10,0,10" FontFamily="{DynamicResource Bree CYR var}" Margin="0,0,5,5" CornerRadius="10,10,10,10" IsEnabledSettingQ="False" IsAnimatedSettingQ="True"/>
        </Grid>
    </Grid>
</Base:IELContainerBase>
