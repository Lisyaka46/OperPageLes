<Base:IELContainerBase
    x:Class="OperPageLes.UI.UserElementsControl.Default.OPLLanguageButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Base="clr-namespace:IEL.UserElementsControl.Base;assembly=LibraryIEL"
    xmlns:IEL="clr-namespace:IEL.UserElementsControl;assembly=LibraryIEL"
    xmlns:OIEL="clr-namespace:OPLAPI.OIEL.UserElementsControl;assembly=OPLAPI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Margin="3,1,3,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Width="50" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Background>
                    <ImageBrush x:Name="ImageBrushImageLanguage" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <Grid Grid.Column="1" Margin="3,0,3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="14"/>
                </Grid.RowDefinitions>
                <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly">
                    <TextBlock x:FieldModifier="private" x:Name="TextBlockNameLanguage" Text="(Russian) Русский" FontSize="16" FontFamily="{DynamicResource RussianRail G Pro}"/>
                </Viewbox>
                <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" Grid.Row="1">
                    <StackPanel Orientation="Horizontal" Opacity="0.7">
                        <TextBlock x:FieldModifier="private" x:Name="TextBlockVersionLanguage" Text="0.0.1" FontFamily="{DynamicResource Plup}" Margin="2,0,2,-1" VerticalAlignment="Center"/>
                    </StackPanel>
                </Viewbox>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Margin="5,0,5,1">
            <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" Margin="0,0,4,0">
                <StackPanel>
                    <TextBlock x:FieldModifier="private" x:Name="TextBlockAutor" FontFamily="{DynamicResource Plup}" Padding="2,0,2,0" Margin="0,5,0,0">
                        <Run x:FieldModifier="private" x:Name="RunTextAutorTitle">Автор</Run><Run>:</Run>
                        <Run x:FieldModifier="private" x:Name="RunTextAutorName">123</Run>
                    </TextBlock>
                    <TextBlock x:FieldModifier="private" x:Name="TextBlockPercentTranslate" FontFamily="{DynamicResource Bree CYR var}" FontSize="11" VerticalAlignment="Center" Padding="2,0,2,0" Margin="0,-2,0,0">
                        <Run x:FieldModifier="private" x:Name="RunPercentTranslateName">Переведено</Run> <Run x:FieldModifier="private" x:Name="RunPercentTranslateValue">100%</Run>
                    </TextBlock>
                </StackPanel>
            </Viewbox>
        </Grid>
        <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,0,3">
            <IEL:IELButtonImage x:FieldModifier="private" x:Name="IELButtonContacts" CornerRadius="5,5,5,5" FontFamily="{DynamicResource RussianRail G Pro}" FontSize="10" MarginViewBox="1,2,2,2" VerticalAlignment="Center" Margin="0,0,3,0" Width="35" Height="35" HorizontalAlignment="Right" Panel.ZIndex="1"/>
            <Border x:FieldModifier="private" x:Name="BorderContacts" Margin="0,0,38,0" HorizontalAlignment="Right" Height="35" Width="50" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <OIEL:OPLVisualElementIM Margin="0,-5,0,-5" Height="40" Width="40" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Base:IELContainerBase>
