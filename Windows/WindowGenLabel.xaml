<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AAC20.Windows"
        xmlns:IEL="clr-namespace:IEL;assembly=IEL" x:Class="AAC20.Windows.WindowGenLabel"
        mc:Ignorable="d"
        Title="WindowGenLabel" d:DesignHeight="200" d:DesignWidth="200" Icon="{DynamicResource EmptyImage}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF69A6BB" Offset="0.738"/>
                <GradientStop Color="#FF2C5E6F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="129*"/>
            <RowDefinition Height="55*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                    <GradientStop Color="#FFA0C8D6"/>
                    <GradientStop Color="#FF69A6BB" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="6*"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="#FF254A67" BorderThickness="2,2,2,2" CornerRadius="6,6,6,6" Grid.RowSpan="1" Grid.ColumnSpan="1" Grid.Column="1" Grid.Row="1" Background="#4C42CC97">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36*"/>
                        <RowDefinition Height="36*"/>
                        <RowDefinition Height="36*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TextBlockName" HorizontalAlignment="Left" Margin="2,-9,0,0" TextWrapping="Wrap" Text="Имя" VerticalAlignment="Top" Padding="3,3,3,3" FontSize="10" FontFamily="Franklin Gothic Medium">
                        <TextBlock.Background>
                            <RadialGradientBrush RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#FF00FFF9" Offset="0.38"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </TextBlock.Background>
                    </TextBlock>
                    <TextBlock x:Name="TextBlockDescription" HorizontalAlignment="Left" Margin="2,-7,0,0" TextWrapping="Wrap" Text="Описание" VerticalAlignment="Top" Padding="3,3,3,3" FontSize="10" FontFamily="Franklin Gothic Medium" Grid.RowSpan="1" Grid.Row="1">
                        <TextBlock.Background>
                            <RadialGradientBrush RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#FF00FFF9" Offset="0.38"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </TextBlock.Background>
                    </TextBlock>
                    <TextBlock x:Name="TextBlockCommand" HorizontalAlignment="Left" Margin="2,-6,0,0" TextWrapping="Wrap" Text="Команда" VerticalAlignment="Top" Padding="3,3,3,3" FontSize="10" FontFamily="Franklin Gothic Medium" Grid.RowSpan="1" Grid.Row="2">
                        <TextBlock.Background>
                            <RadialGradientBrush RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#FF00FFF9" Offset="0.38"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </TextBlock.Background>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="26*"/>
                <RowDefinition Height="26*"/>
            </Grid.RowDefinitions>
            <IEL:IELButtonText x:Name="IELButtonCreateLabel" Margin="30,0,30,0" VerticalAlignment="Center" BorderThicknessBlock="2,2,2,2" Text="Создать ярлык" TextFontFamily="Bahnschrift" DefaultBackground="#FF77C1DA" SelectBackground="DeepSkyBlue" ClickedBackground="#FFB8EDFF" SelectBorderBrush="#FF13162F" ClickedBorderBrush="#FF212031" SelectForeground="#FF0D2523" ClickedForeground="#FF16242B"/>
            <IEL:IELButtonText x:Name="IELButtonCancel" Margin="30,0,30,0" VerticalAlignment="Center" BorderThicknessBlock="2,2,2,2" Text="Отмена" TextFontFamily="Bahnschrift" DefaultBackground="#FFDA9B77" SelectBackground="#FFE6A960" ClickedBackground="#FFFFD2B8" SelectBorderBrush="#FF2F2A13" ClickedBorderBrush="#FF303120" SelectForeground="#FF25210D" ClickedForeground="#FF2B2116" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
