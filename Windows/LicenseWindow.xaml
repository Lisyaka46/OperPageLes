<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AAC20.Windows"
        xmlns:GUI="clr-namespace:AAC20.GUI" x:Class="AAC20.Windows.LicenseWindow"
        mc:Ignorable="d" Background="#CC4D735E" Height="450" Width="300" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Topmost="True" Icon="{Binding Mode=OneWay, Source={StaticResource EmptyImage}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="146*"/>
            <RowDefinition Height="159*"/>
            <RowDefinition Height="129*"/>
        </Grid.RowDefinitions>
        <Image x:Name="ImageLogo" Height="100" Margin="0,30,0,0" VerticalAlignment="Top" Width="100" Source="/Windows/WindowsImages/Logo4.png" HorizontalAlignment="Center"/>
        <Image x:Name="Image20" Margin="0,84,0,0" VerticalAlignment="Top" Source="/Windows/WindowsImages/Logo20.png" Width="84" HorizontalAlignment="Center" Height="38"/>
        <Frame x:Name="FrameLicense" Content="" NavigationUIVisibility="Hidden" Grid.RowSpan="2" Margin="-10,146,0,0"/>
        <Image x:Name="ImageLicense" Source="/Windows/WindowsImages/LicenseIco.png" Margin="0,45,0,35"/>
        <Frame x:Name="FrameThanks" Content="" Grid.Row="2" NavigationUIVisibility="Hidden" Margin="0,9,0,0"/>

    </Grid>
</Window>
