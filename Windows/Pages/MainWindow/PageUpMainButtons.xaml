<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AAC20.Windows.Pages.MainWindow"
      xmlns:GUI="clr-namespace:IEL;assembly=IEL"
      xmlns:Classes="clr-namespace:IEL.Classes;assembly=IEL"
      x:Class="AAC20.Windows.Pages.MainWindow.PageUpMainButtons"
      mc:Ignorable="d" 
      d:DesignHeight="70.482" d:DesignWidth="547"
      Title="PageUpMainButtons">

    <Grid x:Name="GridMain">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="163*"/>
            <ColumnDefinition Width="329*"/>
            <ColumnDefinition Width="55"/>
        </Grid.ColumnDefinitions>

        <GUI:IELImageButtonKey x:Name="IELButtonSettings" Imaging="/Windows/WindowsImages/Settings.png" Grid.ColumnSpan="1" Grid.Column="2" CharKeyKeyboard="D2" ImageMargin="2,2,2,2" Margin="3,0,0,0" AnimationMillisecond="140" VisibleMouseImaging="False">
            <GUI:IELImageButtonKey.BackgroundSetting>
                <Classes:BrushSettingQ Default="#FF50A79D" Select="#FF46C5B6" NotEnabled="#FFC13750" Used="White"/>
            </GUI:IELImageButtonKey.BackgroundSetting>
        </GUI:IELImageButtonKey>
        <GUI:IELButtonTextKey x:Name="IELButtonLabel" RenderTransformOrigin="0,0" CharKeyKeyboard="D1" Text="Ярлыки" FontWeight="Bold" FontFamily="Calibri" Margin="0,0,3,0" AnimationMillisecond="140" VisibleMouseImaging="False">
            <GUI:IELButtonTextKey.BackgroundSetting>
                <Classes:BrushSettingQ Default="#FF50A79D" Select="#FF46C5B6" NotEnabled="#FFC13750" Used="White"/>
            </GUI:IELButtonTextKey.BackgroundSetting>
        </GUI:IELButtonTextKey>
    </Grid>
</Page>
