<Page x:Class="AAC20.Windows.Pages.License.PageUserThanks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AAC20.Windows.Pages.License"
      mc:Ignorable="d" 
      d:DesignHeight="124.667" d:DesignWidth="258.333"
      Title="PageUser">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="21*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="79*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="BorderNickName" BorderBrush="Black" BorderThickness="2,2,2,2" Grid.ColumnSpan="2" CornerRadius="5,5,5,5" Margin="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="79*"/>
                    <ColumnDefinition Width="175*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="19*"/>
                    <RowDefinition Height="23*"/>
                </Grid.RowDefinitions>
                <TextBlock TextWrapping="Wrap" Text="Фраза:" FontStyle="Italic" FontWeight="Bold" Margin="3,0,3,0" Grid.ColumnSpan="1" Grid.Column="1"/>
                <TextBlock x:Name="TextBlockPhrase" TextWrapping="Wrap" Text="&quot;Спасибо что живая&quot;" FontStyle="Italic" TextAlignment="Center" Foreground="#FFC3BDDE" Grid.ColumnSpan="1" Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" Margin="3,0,3,0" TextDecorations="Underline"/>
                <TextBlock x:Name="TextBlockNickName" TextWrapping="Wrap" Text="Minsi" FontSize="18" Style="{Binding Mode=OneWay, Source={StaticResource Tablon}}" FontWeight="Bold" Foreground="#FF56FF78" TextAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="2">
                    <TextBlock.Background>
                        <RadialGradientBrush RadiusX="0.4">
                            <GradientStop Color="#FF2D4A3A" Offset="0.356"/>
                            <GradientStop Color="#00476554" Offset="1"/>
                        </RadialGradientBrush>
                    </TextBlock.Background>
                </TextBlock>
            </Grid>
        </Border>
        <TextBlock TextWrapping="Wrap" Text="Благодарен за:" FontStyle="Italic" FontWeight="Bold" Grid.ColumnSpan="1" Grid.Row="1" TextAlignment="Center" Foreground="#FF171717"/>
        <TextBlock x:Name="TextBlockMessage" TextWrapping="Wrap" Text="- за." FontStyle="Italic" Foreground="#FFC3BDDE" Grid.RowSpan="2" Grid.Row="1" Grid.Column="1"/>
        <Image x:Name="ImageIconNickName" Grid.Row="2" Margin="25,5,25,5"/>
    </Grid>
</Page>
