<Page x:Class="AAC20.Windows.Pages.License.PageLicense"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AAC20.Windows.Pages.License"
      mc:Ignorable="d"
      Title="Page1" Width="300" Height="300">

    <Grid>
        <TextBlock x:Name="TextBlockAAC" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="AAC20" VerticalAlignment="Top" Style="{Binding Mode=OneWay, Source={StaticResource Tablon}}" FontSize="36" FontWeight="Bold"/>
        <TextBlock x:Name="TextBlockLicenseText" HorizontalAlignment="Center" Margin="0,57,0,0" TextWrapping="Wrap" Text="Данная программа лицензирована" VerticalAlignment="Top" FontSize="16"/>

    </Grid>
</Page>
