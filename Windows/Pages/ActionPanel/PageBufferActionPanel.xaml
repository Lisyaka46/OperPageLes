      xmlns:local="clr-namespace:AAC20.Windows.Pages.ActionPanel"
      xmlns:GUI="clr-namespace:AAC20.GUI" x:Class="AAC20.Windows.Pages.ActionPanel.PageBufferActionPanel"
      mc:Ignorable="d" 
      d:DesignHeight="128.908" d:DesignWidth="190.386"
      Title="PageBufferActionPanel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="13*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="3,3,3,3" Grid.Row="1" CornerRadius="3,3,3,3" Margin="4,4,4,4">
            <Grid x:Name="GridBuffer">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="159*"/>
                    <ColumnDefinition Width="17*"/>
                </Grid.ColumnDefinitions>
                <ScrollBar x:Name="ScrollBarBuffer" Grid.Column="1" HorizontalAlignment="Right" BorderThickness="3,0,3,0" Background="#FF1D3527" BorderBrush="Black" Foreground="Black"/>
                <!--<GUI:IELButtonCommand VerticalAlignment="Top" Margin="3,4,3,0" TextFontSize="14" Text="Command" CornerRadius="4,4,4,4" DefaultBackground="#FFACEEFF" DefaultBorderBrush="#FF694C65" ClickedBackground="White" ClickedBorderBrush="#FF885D82" ClickedForeground="#FF003122" SelectBackground="#FF65C1F1" SelectBorderBrush="#FF9E829B" SelectForeground="#FF1C2120" Height="23"/>-->
            </Grid>
        </Border>

        <GUI:IELButtonText x:Name="IELButtonBackMainMenu" Margin="4,5,66,5" StateVisualizationButton="LeftArrow" Text="Назад" DefaultBackground="#FFA1F9FF" SelectBackground="#FF57D5FF" SelectBorderBrush="#FF000A35" SelectForeground="#FF123238" ClickedBorderBrush="#FF000E4A" ClickedForeground="#FF0F2F44" TextFontFamily="Calibri" TextFontSize="14" FontWeight="Bold" CharKeyKeyboardActivate="True"/>

    </Grid>
</Page>
