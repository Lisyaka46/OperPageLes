            <GUI:IELButtonTextKey x:Name="IELButtonClearBuffer" Text="Очистить" DefaultBackground="#FFA1F9FF" SelectBackground="#FF57D5FF" SelectBorderBrush="#FF000A35" SelectForeground="#FF123238" ClickedBorderBrush="#FF000E4A" ClickedForeground="#FF0F2F44" TextFontFamily="Calibri" TextFontSize="12" FontWeight="Bold" CharKeyKeyboard="D1" IsEnabled="False" VisibleMouseImaging="False" Grid.Column="1" Margin="3,0,1,0"/>
        </Grid>



    </Grid>
</Page>
