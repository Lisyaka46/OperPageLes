      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AAC20.Windows.Pages.ActionPanel"
      x:Class="AAC20.Windows.Pages.ActionPanel.PageBufferActionPanel"
      xmlns:GUI="clr-namespace:IEL;assembly=IEL"
      mc:Ignorable="d" 
      Title="PageBufferActionPanel" d:DesignHeight="138.685" d:DesignWidth="251.791">

    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="94*"/>
        </Grid.RowDefinitions>
        <Border x:Name="BorderBuffer" BorderBrush="#FF163C26" BorderThickness="3,3,3,3" Grid.Row="1" CornerRadius="3,3,3,3" Margin="4,4,4,4" Panel.ZIndex="0" ClipToBounds="True" Background="#B21B2F24">
            <Grid>
                <Grid x:Name="GridBuffer"/>
            </Grid>
        </Border>
        <Grid Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="103*"/>
                <ColumnDefinition Width="103*"/>
                <ColumnDefinition Width="46*"/>
            </Grid.ColumnDefinitions>
            <GUI:IELButtonTextKey x:Name="IELButtonBackMainMenu" StateVisualizationButton="LeftArrow" Text="Назад" DefaultBackground="#FFA1F9FF" SelectBackground="#FF57D5FF" SelectBorderBrush="#FF000A35" SelectForeground="#FF123238" ClickedBorderBrush="#FF000E4A" ClickedForeground="#FF0F2F44" TextFontFamily="Calibri" TextFontSize="12" FontWeight="Bold" CharKeyKeyboard="Oem3" VisibleMouseImaging="False" Margin="0,0,3,0"/>
