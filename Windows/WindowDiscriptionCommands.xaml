<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AAC20.Windows"
        xmlns:GUI="clr-namespace:AAC20.GUI" x:Class="AAC20.Windows.WindowDiscriptionCommands"
        mc:Ignorable="d"
        Title="Описание всех команд" Height="450" Width="800" Icon="/Windows/WindowsImages/LogoDC.png" WindowStartupLocation="CenterOwner" Background="#FF527562">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MaxHeight="40" MinHeight="30" Height="20*"/>
            <RowDefinition Height="197*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="171*"/>
                <ColumnDefinition Width="143*"/>
                <ColumnDefinition Width="174*"/>
                <ColumnDefinition Width="253*"/>
                <ColumnDefinition Width="59*"/>
            </Grid.ColumnDefinitions>
            <GUI:IELButtonText x:Name="IELButtonConsole" DefaultBackground="#FFDECDDB" DefaultBorderBrush="Black" DefaultForeground="Black" TextFontSize="14" TextFontFamily="Calibri" Text="Консольные команды" CornerRadius="6,6,6,6" SelectBackground="#FF8DCBF3" SelectBorderBrush="#FF4A1138" SelectForeground="#FF1C2B37" ClickedBackground="#FFE1FFF7" ClickedBorderBrush="#FF134A28" ClickedForeground="#FF004027" FontWeight="Bold" CharKeyKeyboard="D1" Margin="3,0,3,0" Grid.RowSpan="1"/>
            <GUI:IELButtonText x:Name="IELButtonVoice" DefaultBackground="#FFDECDDB" DefaultBorderBrush="Black" DefaultForeground="Black" TextFontSize="14" TextFontFamily="Calibri" Text="Голос. команды" CornerRadius="6,6,6,6" SelectBackground="#FF8DCBF3" SelectBorderBrush="#FF4A1138" SelectForeground="#FF1C2B37" ClickedBackground="#FFE1FFF7" ClickedBorderBrush="#FF134A28" ClickedForeground="#FF004027" FontWeight="Bold" CharKeyKeyboard="D1" Grid.Column="1" Margin="3,0,3,0" Grid.RowSpan="1"/>
            <GUI:IELButtonText x:Name="IELButtonSoft" DefaultBackground="#FFDECDDB" DefaultBorderBrush="Black" DefaultForeground="Black" TextFontSize="14" TextFontFamily="Calibri" Text="Пользоват. команды" CornerRadius="6,6,6,6" SelectBackground="#FF8DCBF3" SelectBorderBrush="#FF4A1138" SelectForeground="#FF1C2B37" ClickedBackground="#FFE1FFF7" ClickedBorderBrush="#FF134A28" ClickedForeground="#FF004027" FontWeight="Bold" CharKeyKeyboard="D1" Grid.Column="2" FontFamily="Arial" Margin="3,0,3,0" Grid.RowSpan="1"/>
            <GUI:IELTextBoxCommand x:Name="IELInputSearchCommand" Grid.Column="3" BorderThicknessBlock="4,2,4,2" CornerRadius="6,6,6,6" Margin="3,0,0,0" Grid.RowSpan="1"/>
            <GUI:IELImageButton x:Name="IELButtonSearchCommand" Grid.Column="4" Imaging="/Windows/WindowsImages/Search.png" ImageMargin="1,1,1,1" BorderThicknessBlock="3,3,3,3" Margin="7,0,7,0" DefaultBackground="#FF8CDCDE" SelectBackground="#FF5ACEF5" SelectBorderBrush="#FF1A1335" ClickedBorderBrush="#FF46003A" Grid.RowSpan="1"/>
            <Rectangle Grid.Row="1" Margin="0,2,0,0" Grid.ColumnSpan="5">
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,-1" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#FF081D14" Offset="1"/>
                        <GradientStop Color="#FF279063"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Frame x:Name="FrameDiscriptionPages" Content=" " Grid.Row="1" NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
