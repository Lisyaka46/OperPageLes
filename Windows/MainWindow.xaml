<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Auxiliary_Access_Console_DL_20"
        xmlns:GUI="clr-namespace:Auxiliary_Access_Console_DL_20.GUI" x:Class="Auxiliary_Access_Console_DL_20.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000" WindowStartupLocation="CenterScreen" FontFamily="Arial" FontSize="14" FontWeight="Bold" Background="#FF0D1F15">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="173"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition Height="41"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="White" BorderThickness="1" CornerRadius="6,6,6,6" Margin="1,0,1,1">
            <Grid>
                <MediaElement x:Name="iou" Margin="4,4,4,4" UnloadedBehavior="Play"/>
            </Grid>
        </Border>
        <Border BorderBrush="White" BorderThickness="3,3,3,3" CornerRadius="10,10,10,10" Grid.Column="2" Margin="2,0,2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="30*"/>
                </Grid.ColumnDefinitions>
                <Button Content="..." HorizontalAlignment="Center" VerticalAlignment="Center" Height="25" Width="30" FontSize="14" FontFamily="Arial" FontWeight="Bold"/>
                <Button Content="_" HorizontalAlignment="Center" VerticalAlignment="Center" Height="25" Width="30" Grid.Column="1" FontSize="14" FontFamily="Arial" FontWeight="Bold"/>
                <Button Content="▢" HorizontalAlignment="Center" VerticalAlignment="Center" Height="25" Width="30" Grid.Column="2" FontSize="14" FontFamily="Arial" FontWeight="Bold"/>
                <Button Content="✕" VerticalAlignment="Center" Height="25" Grid.Column="3" HorizontalAlignment="Center" Width="30" FontSize="14" FontFamily="Arial" FontWeight="Bold"/>
            </Grid>
        </Border>
        <Border BorderBrush="White" BorderThickness="3,3,3,3" CornerRadius="10,10,10,10" Grid.Column="1" Margin="2,0,2,0">
            <Grid>
                <Button Content="Страница 1" HorizontalAlignment="Left" Margin="7,5,0,5"/>
                <Button Content="Страница 2" HorizontalAlignment="Left" Margin="97,5,0,5"/>
            </Grid>
        </Border>
        <Border BorderBrush="White" BorderThickness="3,3,3,3" Grid.Column="2" CornerRadius="10,10,10,10" Grid.Row="1" Margin="2,2,2,2"/>
        <Border BorderBrush="White" BorderThickness="3,3,3,3" Grid.Column="2" Grid.Row="2" CornerRadius="10,10,10,10" Margin="2,2,2,2">
            <Grid>
                <Button Content="_" Width="21" FontSize="14" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>
        <TextBox Grid.Column="1" Margin="2,2,2,2" Grid.Row="3" TextWrapping="Wrap" Text="TextBox" Cursor="Cross" MaxLines="1" UndoLimit="3" MaxLength="100" BorderThickness="0,0,0,0" BorderBrush="{x:Null}" Background="{x:Null}" Foreground="#FF245439" SelectionBrush="#FF266F46" SelectionTextBrush="#FF1B884B" CaretBrush="White"/>
        <Grid Grid.Column="2" Grid.Row="3" Margin="1,1,-1,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96*"/>
                <ColumnDefinition Width="32*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Выполнить" HorizontalAlignment="Center" VerticalAlignment="Center" Width="86" Height="22"/>
            <Button Content="RE" HorizontalAlignment="Center" VerticalAlignment="Center" Height="22" Width="24" Grid.Column="1"/>
            <Image Grid.Column="2" Margin="12,7,12,7"/>
        </Grid>
        <Border BorderBrush="White" BorderThickness="3,3,3,3" Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="10,10,10,10" Margin="2,2,2,2">
            <GUI:IELButtonText Margin="427,204,282,193"/>
        </Border>
        <Border BorderBrush="White" BorderThickness="3,3,3,3" Grid.Row="2" CornerRadius="10,10,10,10" Grid.Column="0" Height="34" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="2,0,2,0"/>
        <Grid Grid.Row="3">
            <TextBlock TextWrapping="Wrap" Text="max" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Width="20" TextAlignment="Center" FontStyle="Italic" Foreground="White" Margin="0,33,0,0"/>
            <TextBlock TextWrapping="Wrap" Text="80 / 80" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Width="37" FontStyle="Italic" Foreground="White" Margin="0,1,0,0" TextAlignment="Center"/>
            <Button Content="=&gt;" HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20"/>
        </Grid>

    </Grid>
</Window>
