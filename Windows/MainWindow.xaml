<Window
        xmlns:local="clr-namespace:AAC20"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:GUI="clr-namespace:AAC20.GUI"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        x:Name="window" x:Class="AAC20.MainWindow"
        mc:Ignorable="d"
        Title="Главное меню" WindowStartupLocation="CenterScreen" FontFamily="Arial" FontSize="14" FontWeight="Bold" Background="#FF3F5F4E" MinWidth="770" MinHeight="500" Icon="/Windows/WindowsImages/Logo02.png">
    <Grid x:Name="GridMain">
        <Image x:Name="ImageTest" HorizontalAlignment="Center" Height="200" VerticalAlignment="Center" Source="https://sun9-46.userapi.com/impg/euj8JteQPLq-XpWDbR03hU2Dlz3IhzwLs4W9DA/bYNM9VcaP-w.jpg?size=800x800&amp;quality=95&amp;sign=b761945cee478f88087602b209cff6f9&amp;type=album" Width="200"/>
        <Grid Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*" MinWidth="40"/>
                <ColumnDefinition Width="787*"/>
                <ColumnDefinition Width="173*" MaxWidth="230"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40*" MinHeight="40" MaxHeight="50"/>
                <RowDefinition Height="451*"/>
                <RowDefinition Height="53"/>
                <RowDefinition Height="40*" MaxHeight="52" MinHeight="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="#FF315842" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="2,2,2,3" Grid.ColumnSpan="2" Background="#CC4A7B60" Grid.RowSpan="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="37"/>
                        <ColumnDefinition Width="543*"/>
                        <ColumnDefinition Width="64*" MinWidth="60" MaxWidth="80"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="ImageLogoApplication" Source="/Windows/WindowsImages/Logo02.png" Margin="3,3,3,3"/>
                    <GUI:IELImageButton x:Name="IELButtonSettings" Grid.Column="2" Imaging="/Windows/WindowsImages/Settings.png" Height="33" ImageMargin="4,4,4,4" DefaultBorderBrush="#FFFD6C6C" Margin="0,2,0,2"/>
                </Grid>
            </Border>
            <Border BorderBrush="#FF315842" BorderThickness="2,2,2,2" Grid.Column="2" CornerRadius="10,10,10,10" Margin="3,2,2,2" Grid.Row="1" Background="#CC4A7B60">
                <Grid x:Name="GridPaging">
                    <TextBlock x:Name="TextBlockTest" HorizontalAlignment="Left" Margin="16,14,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top"/>
                </Grid>
            </Border>
            <Grid Grid.Column="2" Grid.Row="2" Margin="0,52,0,0" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="89*"/>
                    <ColumnDefinition Width="45*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ImageIndificator" gif:ImageBehavior.AnimatedSource="/Windows/WindowsImages/Loading.gif" Margin="9,7,9,7" Grid.Column="1"/>
                <GUI:IELButtonText x:Name="ButtonReturnCommand" DefaultBackground="#FFBADEC3" DefaultBorderBrush="Black" DefaultForeground="Black" TextFontSize="13" TextFontFamily="Calibri" Text="Выполнить" Margin="2,4,2,5" CornerRadius="6,6,6,6" SelectBackground="#FF5EE49D" SelectBorderBrush="#FF114A1A" SelectForeground="#FF065400" ClickedBackground="#FFE1FFF7" ClickedBorderBrush="#FF134A28" ClickedForeground="#FF004027" Grid.ColumnSpan="1" VisibleMouseImaging="False"/>
            </Grid>
            <Border x:Name="BorderConsole" BorderBrush="#FF315842" BorderThickness="3,3,3,3" Grid.Row="1" Grid.ColumnSpan="2" Margin="2,3,3,4" Panel.ZIndex="1">
                <Grid x:Name="GridConsole">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BorderActionPanel" Panel.ZIndex="2" BorderThickness="2,2,2,2" BorderBrush="#FF153523" CornerRadius="5,5,5,5" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#AF284234" Width="265" Height="220" Focusable="True" AllowDrop="True" >
                        <Grid x:Name="GridActionPanel" MinWidth="175" MinHeight="110" Focusable="True" Margin="5,5,5,5">
                            <Frame x:Name="FrameActionPanelLeft" Grid.ColumnSpan="1" Panel.ZIndex="1"/>
                            <Frame x:Name="FrameActionPanelRight" Grid.ColumnSpan="1"/>
                            <TextBlock x:Name="TextBlockRightButtonIndicatorKey" HorizontalAlignment="Right" TextWrapping="Wrap" Text="CTRL" VerticalAlignment="Bottom" Panel.ZIndex="2" Padding="10,3,10,3" Margin="0,0,-4,-4">
                                <TextBlock.Background>
                                    <RadialGradientBrush RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Color="#B255A6A7" Offset="0.575"/>
                                        <GradientStop Offset="1" Color="#00922525"/>
                                    </RadialGradientBrush>
                                </TextBlock.Background>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <RichTextBox x:Name="RichTextBoxMainMessage" Background="#CC4A7B60" SelectionBrush="#FF115236" BorderThickness="0,0,0,0" FontSize="14" MinWidth="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsReadOnly="True" FontWeight="Normal" Focusable="False" Cursor="Cross" VerticalScrollBarVisibility="Auto" Panel.ZIndex="1"/>
                </Grid>
            </Border>
            <Border BorderBrush="#FF315842" BorderThickness="2,2,2,2" Grid.Row="2" CornerRadius="10,10,10,10" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,4,3,1" Background="#CC4A7B60">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="242*"/>
                        <ColumnDefinition Width="27*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TextBlockTime" TextWrapping="Wrap" Text="00:00:00" FontSize="16" FontFamily="Arial Rounded MT Bold" VerticalAlignment="Bottom" Margin="5,0,0,23" Height="19"/>
                    <TextBlock x:Name="TextBlockData" TextWrapping="Wrap" Text="00.00.0000" FontFamily="Arial Rounded MT Bold" FontSize="16" Margin="5,0,0,3" VerticalAlignment="Bottom" Height="19"/>
                </Grid>
            </Border>
            <GUI:IELTextBoxCommand x:Name="TextBoxCommandInput" CornerRadius="4,4,4,4" Grid.Column="1" Grid.Row="3" Margin="3,5,3,5" MinWidth="100" Text="" DefaultBackground="#FF42B779" DefaultBorderBrush="Black" BorderThicknessBlock="3,3,3,3" SelectBackground="#FFCCC978" SelectBorderBrush="#FF1D2112" SelectForeground="#FF212B26" ClickedBorderBrush="#FF044465" ClickedBackground="#FF78CCA0" ClickedForeground="#FF012B1C"/>
            <GUI:IELButtonText x:Name="ButtonReboot" Text="Перезапустить" TextFontSize="14" CornerRadius="6,6,6,6" Margin="8,2,7,3" SelectForeground="#FF655802" SelectBorderBrush="#FF8A7A2E" SelectBackground="#FFC7C824" DefaultBackground="#FFDFE0C9" ClickedBorderBrush="#FF735F1A" ClickedForeground="#FF56530E" Grid.Column="2" FontWeight="Bold" TextFontFamily="Calibri" VisibleMouseImaging="False"/>

        </Grid>
    </Grid>
</Window>
