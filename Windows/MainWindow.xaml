<Window
        xmlns:local="clr-namespace:AAC20"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:GUI="clr-namespace:AAC20.GUI"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        x:Name="window" x:Class="AAC20.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="551" Width="857" WindowStartupLocation="CenterScreen" FontFamily="Arial" FontSize="14" FontWeight="Bold" Background="#FF4A7B60" MinWidth="770" MinHeight="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*" MinWidth="40"/>
            <ColumnDefinition Width="787*"/>
            <ColumnDefinition Width="173*" MaxWidth="230"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*" MinHeight="40" MaxHeight="50"/>
            <RowDefinition Height="451*"/>
            <RowDefinition Height="53"/>
            <RowDefinition Height="40*" MaxHeight="52" MinHeight="40"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="#FF315842" BorderThickness="2,2,2,2" CornerRadius="10,10,10,10" Margin="2,2,2,3" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="584*"/>
                    <ColumnDefinition Width="59*" MinWidth="56" MaxWidth="65"/>
                </Grid.ColumnDefinitions>
                <GUI:IELImageButton x:Name="ButtonSettings" DisabledBackground="#FFDE5E5E" ButtonBackground="White" CornerRadius="8,8,8,8" ImageMargin="2,2,2,2" Imaging="/Windows/WindowsImages/Settings.png" MillisecondsAnimation="90" MouseBackground="#FF28B4C7" ClickedBackground="#FF6A82CC" Grid.Column="1" Margin="2,1,2,1"/>
                <Image x:Name="ImageIndificator_Копировать" gif:ImageBehavior.AnimatedSource="/Windows/WindowsImages/Loading.gif" Margin="4,2,0,2" HorizontalAlignment="Left"/>
            </Grid>
        </Border>
        <Border BorderBrush="#FF315842" BorderThickness="2,2,2,2" Grid.Column="2" CornerRadius="10,10,10,10" Margin="3,2,2,2" Grid.Row="1">
            <Grid x:Name="Paging">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" MinHeight="35" MaxHeight="45"/>
                    <RowDefinition Height="57*"/>
                </Grid.RowDefinitions>
            </Grid>
        </Border>
        <Grid Grid.Column="2" Grid.Row="2" Margin="0,52,0,0" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="89*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="ImageIndificator" gif:ImageBehavior.AnimatedSource="/Windows/WindowsImages/Loading.gif" Margin="9,7,9,7" Grid.Column="1"/>
            <GUI:IELButtonText x:Name="ButtonReturnCommand" DefaultBackground="#FFBADEC3" DefaultBorderBrush="Black" DefaultForeground="Black" TextFontSize="13" TextFontFamily="Calibri" Text="Выполнить" Margin="2,4,2,5" CornerRadius="6,6,6,6" SelectBackground="#FF5EE49D" SelectBorderBrush="#FF114A1A" SelectForeground="#FF065400" ClickedBackground="#FFE1FFF7" ClickedBorderBrush="#FF134A28" ClickedForeground="#FF004027" Grid.ColumnSpan="1" CharKeyKeyboard="A"/>
        </Grid>
        <Border x:Name="BorderConsole" BorderBrush="#FF315842" BorderThickness="3,3,3,3" Grid.Row="1" Grid.ColumnSpan="2" Margin="2,3,3,4">
            <Grid x:Name="GridConsole">
                <Border x:Name="BorderActionPanel" Panel.ZIndex="1" BorderThickness="2,2,2,2" BorderBrush="#FF153523" CornerRadius="5,5,5,5" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#AF284234" Width="251" Height="200" Focusable="True" AllowDrop="True" >
                    <Grid x:Name="GridActionPanel" MinWidth="175" MinHeight="110" Focusable="True">
                        <Frame x:Name="FrameActionPanelLeft" Grid.ColumnSpan="1" Panel.ZIndex="1"/>
                        <Frame x:Name="FrameActionPanelRight" Grid.ColumnSpan="1"/>
                    </Grid>
                </Border>
                <RichTextBox x:Name="RichTextBoxMainMessage" Background="#FF4A7B60" SelectionBrush="#FF115236" BorderThickness="0,0,0,0" FontSize="14" MinWidth="10" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsReadOnly="True" FontWeight="Normal" Focusable="False" Cursor="Cross"/>
            </Grid>
        </Border>
        <Border BorderBrush="#FF315842" BorderThickness="2,2,2,2" Grid.Row="2" CornerRadius="10,10,10,10" Grid.Column="0" Grid.ColumnSpan="2" Margin="2,4,3,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="242*"/>
                    <ColumnDefinition Width="27*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextBlockTime" TextWrapping="Wrap" Text="00:00:00" FontSize="16" FontFamily="Arial Rounded MT Bold" VerticalAlignment="Bottom" Margin="5,0,0,23" Height="19"/>
                <TextBlock x:Name="TextBlockData" TextWrapping="Wrap" Text="00.00.0000" FontFamily="Arial Rounded MT Bold" FontSize="16" Margin="5,0,0,3" VerticalAlignment="Bottom" Height="19"/>
            </Grid>
        </Border>
        <GUI:IELTextBoxCommand x:Name="TextBoxCommandInput" CornerRadius="2,2,2,2" TextBackground="#FD78CCA0" TextBorderBrush="Black" TextBorderThickness="3,3,3,3" Grid.Column="1" Grid.Row="3" TextFontSize="17" SelectionBrush="#FF1E885A" Margin="3,5,3,5" MinWidth="100" Text=""/>
        <GUI:IELButtonText x:Name="ButtonReboot" Text="Перезапустить" TextFontSize="14" CornerRadius="6,6,6,6" Margin="8,2,7,3" SelectForeground="#FF655802" SelectBorderBrush="#FF8A7A2E" SelectBackground="#FFC7C824" DefaultBackground="#FFDFE0C9" ClickedBorderBrush="#FF735F1A" ClickedForeground="#FF56530E" Grid.Column="2" FontWeight="Bold" TextFontFamily="Calibri"/>

    </Grid>
</Window>
